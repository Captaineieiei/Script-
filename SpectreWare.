local _panicFired = false
local function panic(reason, silent)
    if _panicFired then return end
    _panicFired = true

    -- 1) ล้าง globals ทั้งหมด
    getgenv()._SpectreRunning = nil
    getgenv().KEY = nil

    -- 2) Destroy GUI ทุกอัน
    pcall(function()
        local pg = PL:FindFirstChildOfClass("PlayerGui")
        if pg then
            for _, v in ipairs(pg:GetChildren()) do
                if v:IsA("ScreenGui") and v.Name:find("Spectre") then
                    v:Destroy()
                end
            end
        end
    end)

    -- 3) ส่ง panic webhook
    if not silent then
        pcall(function()
            local body = HS:JSONEncode({
                event  = "panic",
                reason = tostring(reason or "unknown"),
                player = { name=PL.Name, userId=tostring(PL.UserId) },
                game   = { placeId=tostring(game.PlaceId), jobId=tostring(game.JobId) }
            })
            local fns = {
                function() return syn and syn.request and syn.request({ Url=API.."/api/event", Method="POST", Headers={["Content-Type"]="application/json"}, Body=body }) end,
                function() return request and request({ Url=API.."/api/event", Method="POST", Headers={["Content-Type"]="application/json"}, Body=body }) end,
            }
            for _, fn in ipairs(fns) do pcall(fn) end
        end)
    end

    -- 4) Kick
    task.wait(1.2)
    pcall(function()
        PL:Kick("[ SpectreWare ]  "..tostring(reason or "Session terminated."))
    end)
end

