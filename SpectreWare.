local function setBootStatus(msg, sub, progressPct)
    if not _statusLabel then return end
    _statusLabel.Text = "▸  " .. tostring(msg)
    if sub and _subLabel then _subLabel.Text = tostring(sub) end

    if progressPct and _progressFill and _progressBar then
        _currentProgress = progressPct
        TweenService:Create(_progressFill, TweenInfo.new(0.4, Enum.EasingStyle.Quad), {
            Size = UDim2.new(progressPct / 100, 0, 1, 0)
        }):Play()
        local pct = _progressBar.Parent:FindFirstChild("ProgressPct")
        if pct then pct.Text = math.floor(progressPct).."%" end
    end
end

local function destroyBootHUD(success)
    if not _bootGui or not _bootGui.Parent then return end
    local card = _bootGui:FindFirstChildWhichIsA("Frame")
    if not card then _bootGui:Destroy(); return end

    local color = success and Color3.fromRGB(0, 220, 80) or Color3.fromRGB(255, 80, 80)
    if _statusLabel then
        _statusLabel.TextColor3 = color
        _statusLabel.Text = success and "▸  Launching..." or "▸  Fatal Error"
    end
    local stroke = card:FindFirstChildWhichIsA("UIStroke")
    if stroke then stroke.Color = color end

    task.wait(0.8)
    TweenService:Create(card, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
        Position = UDim2.new(0.5, 0, success and -0.5 or 1.5, 0)
