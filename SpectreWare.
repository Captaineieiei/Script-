-- Retry with exponential backoff
local callOk, raw
local authQuery = buildQuery({ key=KEY, hwid=hwid })
for i = 1, API_RETRY_COUNT do
    log(("Connecting to API... (%d/%d)"):format(i, API_RETRY_COUNT),"loading")
    callOk, raw = safeGet(API.."/api/lookup?"..authQuery)
    if callOk and raw and raw ~= "" then break end
    if i < API_RETRY_COUNT then task.wait(API_BASE_DELAY * (2^(i-1))) end  -- 1.5s, 3s, 6s
end
if not callOk or not raw or raw == "" then
    log("Cannot reach API — enable HTTP Requests or server is down","error")
    getgenv()._SpectreRunning = nil
    return
end

log("API response received ✓","info") task.wait(0.6)
local ok2, result = pcall(HS.JSONDecode, HS, raw)
if not ok2 or type(result) ~= "table" then
    log("API returned invalid response","error")
    getgenv()._SpectreRunning = nil
    return
end

log("Verifying key...","loading") task.wait(1.2)
if result.success ~= true and result.success ~= "true" then
    log(parseApiError(result.message),"error")
    local msg = tostring(result.message or ""):lower()
    if msg:find("expired") then
        task.spawn(function() sendWebhook("expired",{key=KEY,hwid=hwid,timeLeft="EXPIRED"}) end)
        task.wait(2)
        pcall(function() PL:Kick("[ SpectreWare ]  Your key has expired.\nPlease redeem a new key in Discord.") end)
    end
    getgenv()._SpectreRunning = nil
    return
end
if type(result.data) ~= "table" then
    log("Incomplete data from API","error")
    getgenv()._SpectreRunning = nil
    return
end

local data = result.data
log("Verifying HWID...","loading") task.wait(1.0)
if type(data.hwid) == "string" and data.hwid ~= "" and data.hwid ~= hwid then
    log("HWID mismatch — key is bound to another device","error")
    task.spawn(function() sendWebhook("mismatch",{key=KEY,hwid=hwid,timeLeft="BLOCKED"}) end)
    getgenv()._SpectreRunning = nil
    task.wait(2)
    pcall(function() PL:Kick("[ SpectreWare ]  HWID Mismatch.\nKey นี้ผูกกับอุปกรณ์อื่น — ติดต่อ Discord.") end)
    return
end
log("HWID verified ✓","success") task.wait(0.8)

local timeLeft = "Permanent"
local expiresAt = data.expiresAt
if expiresAt ~= nil and expiresAt ~= -1 then
    local diff = math.floor((expiresAt - os.time()*1000) / 1000)
    if diff <= 0 then
        log("Key has already expired","error")
        getgenv()._SpectreRunning = nil
        return
    end
    timeLeft = math.floor(diff/86400).."d "..math.floor((diff%86400)/3600).."h "..math.floor((diff%3600)/60).."m"
end

