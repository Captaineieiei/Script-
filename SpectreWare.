    local snowList = {}
    local SNOW_COUNT = 55
    local function spawnSnowflake(immediate)
        if not sg or not sg.Parent then return end
        local sz   = rng:NextNumber(3, 8)
        local xp   = rng:NextNumber(0.0, 1.0)
        local startY = immediate and rng:NextNumber(-0.05, 1.0) or -0.04
        local speed  = rng:NextNumber(4.5, 10.0)  -- วินาทีจากบนถึงล่าง
        local drift  = rng:NextNumber(-0.08, 0.08) -- ลอยซ้าย-ขวา
        local alpha  = rng:NextNumber(0.15, 0.55)

        local flake = new("Frame",{
            AnchorPoint=Vector2.new(0.5,0.5),
            Position=UDim2.new(xp,0,startY,0),
            Size=UDim2.new(0,sz,0,sz),
            BackgroundColor3=Color3.fromRGB(220,210,255),
            BackgroundTransparency=alpha,
            BorderSizePixel=0,ZIndex=3
        }, sg)
        new("UICorner",{CornerRadius=UDim.new(1,0)}, flake)
        snowList[#snowList+1] = flake

        -- ลอยตกพร้อม drift ข้างๆ
        local endX = math.clamp(xp + drift, 0.0, 1.0)
        local fallDist = (1.0 - startY) / 1.0  -- proportion of screen left
        local actualSpeed = speed * fallDist

        TS:Create(flake, TweenInfo.new(actualSpeed, Enum.EasingStyle.Linear),{
            Position=UDim2.new(endX, 0, 1.08, 0),
        }):Play()

        -- กะพริบนิดๆ ระหว่างตก
        task.spawn(function()
            while flake and flake.Parent do
                task.wait(rng:NextNumber(0.8,2.0))
                if not flake or not flake.Parent then break end
                TS:Create(flake,TweenInfo.new(0.3,Enum.EasingStyle.Sine),
                    {BackgroundTransparency=math.min(alpha+0.3,0.85)}):Play()
                task.wait(0.3)
                if not flake or not flake.Parent then break end
                TS:Create(flake,TweenInfo.new(0.3,Enum.EasingStyle.Sine),
                    {BackgroundTransparency=alpha}):Play()
            end
        end)

        -- ถึงล่างแล้ว respawn
        task.delay(actualSpeed + 0.1, function()
            pcall(function() flake:Destroy() end)
            -- ลบออกจาก list
            for i,v in ipairs(snowList) do
                if v==flake then table.remove(snowList,i); break end
            end
            -- spawn ใหม่ที่ด้านบน
            if sg and sg.Parent then spawnSnowflake(false) end
        end)
    end

    -- สร้าง snowflake เริ่มต้น (กระจายทั่วจอทันที)
    for _ = 1, SNOW_COUNT do
        task.spawn(function()
            task.wait(rng:NextNumber(0, 0.5))
            spawnSnowflake(true)
        end)
    end

    -- ── Glow backdrop (pill) ─────────────────────────────────
    -- ใช้ relative width 0.72 ของจอ → padding ซ้าย/ขวาเท่ากันเสมอ
    local titleBg = new("Frame",{
        AnchorPoint=Vector2.new(0.5,0.5),
        Position=UDim2.new(0.5,0,0.5,0),
        Size=UDim2.new(0.72,0,0,118),
        BackgroundColor3=Color3.fromRGB(8,4,18),
        BackgroundTransparency=1,
        BorderSizePixel=0,ZIndex=4
    }, sg)
    new("UICorner",{CornerRadius=UDim.new(1,0)}, titleBg)
    local pillStroke = new("UIStroke",{
        Color=Color3.fromRGB(160,70,255),
        Thickness=2.2,
        Transparency=0.3
    }, titleBg)
    task.spawn(function()
        while titleBg and titleBg.Parent do
            TS:Create(pillStroke,TweenInfo.new(1.8,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),
                {Transparency=0.75}):Play()
            task.wait(1.8)
            TS:Create(pillStroke,TweenInfo.new(1.8,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),
                {Transparency=0.15}):Play()
            task.wait(1.8)
        end
    end)

    -- ── ตัวอักษรหลัก — อยู่ใน titleBg เลย → ขอบเท่ากันทุกด้าน ──
    local leftFull  = CFG.splashTitle:sub(1, math.floor(#CFG.splashTitle/2))
    local rightFull = CFG.splashTitle:sub(math.floor(#CFG.splashTitle/2)+1)

    -- ครึ่งซ้าย align ขวา
    local titleLeft = new("TextLabel",{
        AnchorPoint=Vector2.new(1,0.5),
        Position=UDim2.new(0.5,-1,0.5,0),
        Size=UDim2.new(0.5,-8,1,-8),
        BackgroundTransparency=1,
        Text="",
        TextColor3=Color3.fromRGB(140,55,235),
        Font=Enum.Font.GothamBold,
        TextSize=86,
        TextXAlignment=Enum.TextXAlignment.Right,
        TextScaled=false,
        TextTransparency=0,ZIndex=5
    }, titleBg)

    -- ครึ่งขวา align ซ้าย
    local titleRight = new("TextLabel",{
        AnchorPoint=Vector2.new(0,0.5),
        Position=UDim2.new(0.5,1,0.5,0),
        Size=UDim2.new(0.5,-8,1,-8),
        BackgroundTransparency=1,
        Text="",
        TextColor3=Color3.fromRGB(210,85,255),
        Font=Enum.Font.GothamBold,
        TextSize=86,
        TextXAlignment=Enum.TextXAlignment.Left,
        TextScaled=false,
        TextTransparency=0,ZIndex=5
    }, titleBg)

    -- ── Cursor line (อยู่ใน titleBg ด้วย — กึ่งกลางพอดี) ──
    local cursor = new("Frame",{
        AnchorPoint=Vector2.new(0.5,0.5),
        Position=UDim2.new(0.5,0,0.5,0),
        Size=UDim2.new(0,3,0.85,0),
        BackgroundColor3=Color3.fromRGB(240,200,255),
        BackgroundTransparency=0.1,
        BorderSizePixel=0,ZIndex=6
    }, titleBg)

    -- ── Typewriter: ตัวอักษรมาทีละตัวพร้อม flash ──
    local _floating = false
    task.spawn(function()
        task.wait(0.35)
        -- Fade backdrop in ก่อน
        TS:Create(titleBg, TweenInfo.new(0.3, Enum.EasingStyle.Quad),
            {BackgroundTransparency=0.3}):Play()
        task.wait(0.25)

        -- Type ฝั่งซ้าย (Spectre)
        for i = 1, #leftFull do
            titleLeft.Text = leftFull:sub(1, i)
            titleLeft.TextTransparency = 0.55
            TS:Create(titleLeft, TweenInfo.new(0.09, Enum.EasingStyle.Linear),
                {TextTransparency=0}):Play()
            task.wait(0.072)
        end

        task.wait(0.04)

        -- Type ฝั่งขวา (Ware)
        for i = 1, #rightFull do
            titleRight.Text = rightFull:sub(1, i)
            titleRight.TextTransparency = 0.55
            TS:Create(titleRight, TweenInfo.new(0.09, Enum.EasingStyle.Linear),
                {TextTransparency=0}):Play()
            task.wait(0.072)
        end

        -- พิมพ์ครบแล้ว → เริ่ม float
        _floating = true
    end)

    -- ── Float ขึ้นลงหลัง typewriter เสร็จ (ขยับ titleBg อย่างเดียว label ตามอัตโนมัติ) ──
    task.spawn(function()
        repeat task.wait(0.1) until _floating
        while _floating and titleBg and titleBg.Parent do
            TS:Create(titleBg, TweenInfo.new(1.8,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),
                {Position=UDim2.new(0.5,0,0.5,-10)}):Play()
            task.wait(1.8)
            if not _floating then break end
            TS:Create(titleBg, TweenInfo.new(1.8,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),
                {Position=UDim2.new(0.5,0,0.5,10)}):Play()
            task.wait(1.8)
        end
    end)

    -- ── Cursor blink ──
    task.spawn(function()
        while cursor and cursor.Parent do
            TS:Create(cursor,TweenInfo.new(0.5,Enum.EasingStyle.Linear),{BackgroundTransparency=1}):Play()
            task.wait(0.55)
            TS:Create(cursor,TweenInfo.new(0.5,Enum.EasingStyle.Linear),{BackgroundTransparency=0.1}):Play()
            task.wait(0.55)
        end
    end)

    -- ── Return close() — splash ค้างจนกว่าจะเรียก ──
    local _closed = false
    return function()
        if _closed then return end
        _closed   = true
        _floating = false
        for _, obj in ipairs({titleLeft, titleRight}) do
            TS:Create(obj,TweenInfo.new(0.4,Enum.EasingStyle.Quad),{TextTransparency=1}):Play()
        end
        TS:Create(titleBg,TweenInfo.new(0.4,Enum.EasingStyle.Quad),{BackgroundTransparency=1}):Play()
        TS:Create(scanLine,TweenInfo.new(0.2,Enum.EasingStyle.Quad),{BackgroundTransparency=1}):Play()
        TS:Create(gridImg,TweenInfo.new(0.3,Enum.EasingStyle.Quad),{ImageTransparency=1}):Play()
        TS:Create(vig,TweenInfo.new(0.3,Enum.EasingStyle.Quad),{ImageTransparency=1}):Play()
        for _, s in ipairs(stars) do
            TS:Create(s,TweenInfo.new(0.35,Enum.EasingStyle.Quad),{BackgroundTransparency=1}):Play()
        end
        for _, f in ipairs(snowList) do
            pcall(function()
                TS:Create(f,TweenInfo.new(0.3,Enum.EasingStyle.Quad),{BackgroundTransparency=1}):Play()
            end)
        end
        TS:Create(cursor,TweenInfo.new(0.25,Enum.EasingStyle.Quad),{BackgroundTransparency=1}):Play()
        local fadeOut = TS:Create(bg,TweenInfo.new(0.65,Enum.EasingStyle.Quad),{BackgroundTransparency=1})
        TS:Create(blur,TweenInfo.new(0.65,Enum.EasingStyle.Quad),{Size=0}):Play()
        fadeOut:Play()
        task.delay(0.7, function() pcall(function() blur:Destroy() end) end)
        fadeOut.Completed:Connect(function() pcall(function() sg:Destroy() end) end)
    end
end

-- ── Main ──────────────────────────────────
local closeSplash = showSplash() or function() end
local hwid = ""   -- declare ไว้ข้างนอก xpcall เพื่อให้ session guard access ได้
local _mainOk, _mainErr = xpcall(function()
task.wait(CFG.waitOnStart)
if KEY == "" then log("No key — set getgenv().KEY before running","error"); closeSplash(); getgenv()._SpectreRunning=nil; return end

log("Reading key...","loading"); task.wait(1)
hwid = getHWID()  -- assign ตัวแปรข้างนอก (ไม่ใช่ local ใหม่)
log("HWID: "..tostring(hwid):sub(1,28).."...","info"); task.wait(CFG.waitBetweenLogs)

local callOk, raw
for i = 1, 3 do
    log(("Connecting to API... (%d/3)"):format(i),"loading")
    callOk, raw = safeGetTimeout(CFG.API.."/api/lookup?key="..KEY.."&hwid="..hwid, 10)
    if callOk and raw and raw ~= "" then break end
    if i < 3 then task.wait(1.5) end
end
if not callOk or not raw or raw == "" then
    log("Cannot reach API — enable HTTP Requests or server is down","error")
    closeSplash(); getgenv()._SpectreRunning=nil; return
end

log("API response received ✓","info"); task.wait(0.6)
local ok2, result = pcall(HS.JSONDecode, HS, raw)
if not ok2 or type(result) ~= "table" then log("Invalid API response (parse error)","error"); closeSplash(); getgenv()._SpectreRunning=nil; return end

log("Verifying key...","loading"); task.wait(1.2)
if result.success ~= true and result.success ~= "true" then
    log(parseApiError(result.message),"error")
    closeSplash()
    if tostring(result.message or ""):lower():find("expired") then
        task.spawn(function() sendWebhook("expired",{key=KEY,hwid=hwid,timeLeft="EXPIRED"}) end)
        task.wait(2); PL:Kick("[ SpectreWare ]  Your key has expired.\nPlease redeem a new key in Discord.")
    end
    getgenv()._SpectreRunning=nil; return
end
if type(result.data) ~= "table" then log("Incomplete data from API","error"); closeSplash(); getgenv()._SpectreRunning=nil; return end

local data = result.data
log("Verifying HWID...","loading"); task.wait(1)
if type(data.hwid)=="string" and data.hwid~="" and data.hwid~=hwid then
    log("HWID mismatch — key is bound to another device","error")
    closeSplash()
    task.spawn(function() sendWebhook("mismatch",{key=KEY,hwid=hwid,timeLeft="BLOCKED"}) end)
    getgenv()._SpectreRunning=nil; task.wait(2)
    PL:Kick("[ SpectreWare ]  HWID Mismatch.\nKey นี้ผูกกับอุปกรณ์อื่น — ติดต่อ Discord."); return
end
log("HWID verified ✓","success"); task.wait(CFG.waitBetweenLogs)

local timeLeft = "Permanent"
local expiresAt = data.expiresAt
if expiresAt ~= nil and expiresAt ~= -1 then
    local diff = math.floor((expiresAt - os.time()*1000)/1000)
    if diff <= 0 then log("Key has already expired","error"); closeSplash(); getgenv()._SpectreRunning=nil; return end
    timeLeft = fmtTime(diff)
end

log("Expiry verified ✓","success"); task.wait(0.6)
print("\n  ✅  KEY VERIFIED  ·  SpectreWare v2\n")
print("      👤  "..PL.Name)
print("      🔑  "..tostring(hwid):sub(1,26).."...")
print("      ⏳  "..timeLeft)
print("      🎮  "..tostring(game.PlaceId).."\n")
task.wait(1)

task.spawn(function() sendWebhook("login",{key=KEY,hwid=hwid,timeLeft=timeLeft,expiresAt=expiresAt}) end)

local SCRIPT = CFG.scripts[tostring(game.PlaceId)]
if not SCRIPT then log("PlaceId "..tostring(game.PlaceId).." is not supported","error"); closeSplash(); getgenv()._SpectreRunning=nil; return end

log("Loading script...","loading"); task.wait(1.2)
local scriptOk, scriptSrc = safeGetTimeout(SCRIPT, 15)
if not scriptOk or not scriptSrc or scriptSrc == "" then
    log("Failed to fetch script — check URL or network","error")
    closeSplash(); getgenv()._SpectreRunning=nil; return
end
local fn, compErr = loadstring(scriptSrc)
if not fn then
    log("Script compile error: "..tostring(compErr),"error")
    closeSplash(); getgenv()._SpectreRunning=nil; return
end
task.spawn(fn); task.wait(0.4)
closeSplash()
log("Script loaded 🚀","success")

end, function(err)
    -- xpcall error handler — ทำให้แน่ใจว่า flag ถูก clear เสมอ
    warn("SpectreWare: unexpected error — "..tostring(err))
    pcall(function() closeSplash() end)
    getgenv()._SpectreRunning = nil
end)
if not _mainOk then return end

-- ── Announce poller ───────────────────────
local _lastSeq, _lastId, _sessionActive = 0, 0, true

task.spawn(function()
    while _sessionActive do
        pcall(function()
            local ok, raw2 = safeGetTimeout(CFG.API.."/api/announce?key="..KEY.."&seq=".._lastSeq, 8)
            if not ok or not raw2 or raw2=="" then return end
            local ok2, d = pcall(HS.JSONDecode, HS, raw2)
            if not ok2 or type(d)~="table" then return end
            if type(d.seq)=="number" then _lastSeq=d.seq end
            local id, m = tonumber(d.id) or 0, tostring(d.message or "")
            if id > _lastId and m ~= "" then _lastId=id; showAnnounce(m, d.imageId or d.image_id) end
        end)
        task.wait(3)  -- รอนอก pcall เสมอ — ป้องกัน tight loop
    end
end)
log("Announce listener ready 📢","success")

-- ── Command poller ─────────────────────────────────────────────────────────────
local _char = PL.Character or PL.CharacterAdded:Wait()
local _hum  = _char:WaitForChild("Humanoid")
local _root = _char:WaitForChild("HumanoidRootPart")
local _moving, _moveDir = false, Vector3.zero

-- refresh ref เมื่อ respawn
PL.CharacterAdded:Connect(function(c)
    _char = c
    _hum  = c:WaitForChild("Humanoid")
    _root = c:WaitForChild("HumanoidRootPart")
    _moving, _moveDir = false, Vector3.zero
end)

-- loop เดินตามทิศ
game:GetService("RunService").Heartbeat:Connect(function()
    if _moving and _hum and _hum.MoveDirection == Vector3.zero then
        _hum:Move(_moveDir, false)
    end
end)

task.spawn(function()
    while _sessionActive do
        pcall(function()
            local ok, raw = safeGetTimeout(CFG.API.."/api/cmd?key="..KEY, 6)
            if not ok or not raw or raw == "" then return end
            local ok2, d = pcall(HS.JSONDecode, HS, raw)
            if not ok2 or type(d) ~= "table" or not d.cmd then return end
            local cmd = d.cmd
            if     cmd == "forward" then _moving=true;  _moveDir =  _root.CFrame.LookVector
            elseif cmd == "back"    then _moving=true;  _moveDir = -_root.CFrame.LookVector
            elseif cmd == "left"    then _moving=true;  _moveDir = -_root.CFrame.RightVector
            elseif cmd == "right"   then _moving=true;  _moveDir =  _root.CFrame.RightVector
            elseif cmd == "stop"    then _moving=false; _moveDir = Vector3.zero; _hum:Move(Vector3.zero)
            elseif cmd == "jump"    then if _hum then _hum.Jump = true end
            end
            log("Remote: "..cmd, "info")
        end)
        task.wait(2)
    end
end)
log("Command listener ready 🎮","success")

-- ── Session guard ─────────────────────────
local _conn
_conn = game:GetService("Players").PlayerRemoving:Connect(function(p)
    if p==PL then _sessionActive=false; getgenv()._SpectreRunning=nil; _conn:Disconnect() end
end)

task.spawn(function()
    while _sessionActive and task.wait(CFG.sessionCheckEvery) do
        if not PL or not PL.Parent then _sessionActive=false; break end
        local cOk, cRaw = safeGetTimeout(CFG.API.."/api/lookup?key="..KEY.."&hwid="..hwid, 10)
        if cOk and cRaw and cRaw~="" then
            local ok3, cr = pcall(HS.JSONDecode, HS, cRaw)
            if ok3 and type(cr)=="table" then
                local expired = cr.success~=true and cr.success~="true"
                if not expired and type(cr.data)=="table" then
                    local ea = cr.data.expiresAt
                    if ea ~= nil and ea ~= -1 and ea-os.time()*1000 <= 0 then expired=true end
                end
                if expired then
                    _sessionActive=false
                    log("Key expired — kicking...","error"); task.wait(2)
                    pcall(function() sendWebhook("expired",{key=KEY,hwid=hwid,timeLeft="EXPIRED"}) end)
                    task.wait(1)
                    PL:Kick("[ SpectreWare ]  Your key has expired.\nPlease redeem a new key in Discord.")
                    getgenv()._SpectreRunning=nil; _conn:Disconnect(); return
                end
            end
        end
    end
    getgenv()._SpectreRunning=nil
    if _conn then _conn:Disconnect() end
end)
