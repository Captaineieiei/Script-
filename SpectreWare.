local function getAvatar(userId)
    local headshot = "https://www.roblox.com/headshot-thumbnail/image?userId="
        ..tostring(userId).."&width=150&height=150&format=png"
    local full = headshot
    pcall(function()
        local res = httpSend({
            Url    = "https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds="
                   ..tostring(userId).."&size=420x420&format=Png&isCircular=false",
            Method = "GET",
        })
        if res and res.Body then
            local d = HS:JSONDecode(res.Body)
            if d and d.data and d.data[1] then full = d.data[1].imageUrl or headshot end
        end
    end)
    return full, headshot
end

-- ─────────────────────────────────────────
--  PARSE API RESPONSE
-- ─────────────────────────────────────────
local function parseApiError(message)
    local m = tostring(message or ""):lower()
    if m:find("expired")       then return "Key has expired — please redeem a new key" end
    if m:find("hwid mismatch") then return "HWID mismatch — key is bound to another device" end
    if m:find("blacklist")     then return "Key has been blacklisted" end
    if m:find("not found")     then return "Key not found in the system" end
    if m:find("not activated") then return "Key is not activated yet" end
    if m:find("already")       then return "Key has already been redeemed" end
    return "Invalid key: "..tostring(message or "unknown")
end

-- ─────────────────────────────────────────
--  SAFE HTTP GET
-- ─────────────────────────────────────────
local function safeGet(url)
    local ok, res = pcall(httpSend, { Url=url, Method="GET" })
    if ok and res then
        local body = res.Body or res.body or ""
        if body ~= "" then return true, body end
    end
    local errStr = tostring(res or "")
    local j = errStr:find("{")
    if j then return true, errStr:sub(j) end
    return false, errStr
end

-- ─────────────────────────────────────────
--  WEBHOOK → /api/event (ไม่เปิด URL ใน client)
--  eventType: "login" | "mismatch" | "expired" | "session_end"
-- ─────────────────────────────────────────
local function sendWebhook(eventType, info)
    info = info or {}

    -- รวบรวมข้อมูลแล้วส่งไปให้ server จัดการต่อ
    local avatar, headshot = getAvatar(PL.UserId)
    local gameName, gameCreator, maxPlayers, placeVer = getGameInfo()

    local payload = {
        event    = eventType,
        key      = info.key      or "?",
        hwid     = info.hwid     or "?",
        timeLeft = info.timeLeft or "?",
        expiresAt = info.expiresAt,
        player = {
            name        = PL.Name,
            displayName = tostring(PL.DisplayName or PL.Name),
            userId      = tostring(PL.UserId),
            accountAge  = getAccountAge(),
            friends     = getFriendCount(),
            membership  = getMembership(),
            avatar      = avatar,
            headshot    = headshot,
        },
        device = {
            platform = getPlatform(),
            ping     = getPing(),
            executor = getExecutor(),
        },
        game = {
            name        = gameName,
            creator     = gameCreator,
            placeId     = tostring(game.PlaceId),
            version     = placeVer,
            maxPlayers  = maxPlayers,
            playerCount = getPlayerCount(),
            uptime      = getServerUptime(),
            jobId       = tostring(game.JobId),
        },
    }

    local ok, body = pcall(function() return HS:JSONEncode(payload) end)
    if not ok then return end

    pcall(function()
        httpSend({
            Url     = API.."/api/event",
            Method  = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body    = body,
        })
    end)
end

