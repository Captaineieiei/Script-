local function _isExpired(d)
    if type(d)~="table" then return true end
    local ea=d.expiresAt
    return ea~=nil and ea~=-1 and ea-os.time()*1000<=0
end

local function _parseResult(raw)
    local ok,r=pcall(HS.JSONDecode,HS,raw)
    if not ok or type(r)~="table" then return nil end
    if r.success==nil or r.data==nil or r.message==nil then return nil end
    return r
end

-- [HARDENED #4] script content checksum
local function _djb2(s)
    local h=5381
    for i=1,#s do h=((h*33)+s:byte(i))%0x100000000 end
    return string.format("%08X",h)
end

local _verified=false
local _expiresAt_cached=nil

local _mainOk=xpcall(function()
    task.wait(CFG.waitOnStart)

    if KEY=="" then log("No key — set getgenv().KEY before running","error"); getgenv()._SpectreRunning=nil; return end
    if getgenv()._SpectreToken~=_sessionToken then warn("SpectreWare: session token mismatch"); return end

    log("Initialising — Key: "..maskKey(KEY),"loading")
    hwid=getHWID()
    if hwid==""or hwid=="UNKNOWN" then log("Cannot determine HWID — anti-bypass triggered","error"); integrityFail("HWID unknown"); return end
    log("HWID: "..tostring(hwid):sub(1,28).."...","info")

    local callOk,raw
    for i=1,3 do
        log(("Connecting to API... (%d/3)"):format(i),"loading")
        callOk,raw=safeGetTimeout(CFG.API.."/api/lookup?key="..KEY.."&hwid="..HS:UrlEncode(hwid),10)
