local function getHWID()
    local id = "UNKNOWN"
    local checks = {
        function() if rawget(_G,"gethwid") then id = gethwid() end end,
        function()
            local v = game:GetService("RbxAnalyticsService"):GetClientId()
            if v and v ~= "" then id = v end
        end,
        function()
            if typeof(syn)=="table" and syn.get_fingerprint then id = syn.get_fingerprint() end
        end,
        function() id = tostring(PL.UserId).."_"..tostring(game.JobId):sub(1,8) end,
    }
    for _, fn in ipairs(checks) do
        pcall(fn)
        if id ~= "UNKNOWN" and id ~= "" then return id end
    end
    return id
end

