-- Step 4 — Verify key
setBootStatus("Verifying key...", "Checking key validity and binding", 58)
log("Verifying key...", "loading"); task.wait(1.0)

if result.success ~= true and result.success ~= "true" then
    local errMsg = parseApiError(result.message)
    setBootStatus(errMsg, "Authentication failed", 60)
    log(errMsg, "error")
    task.wait(1.5); destroyBootHUD(false)
    showAnnounce(errMsg, true)
    if tostring(result.message or ""):lower():find("expired") then
        task.spawn(function() sendWebhook("expired",{key=KEY,hwid=hwid,timeLeft="EXPIRED"}) end)
        task.wait(2); PL:Kick("[ SpectreWare ]  Your key has expired.\nPlease redeem a new key in Discord.")
    end
    getgenv()._SpectreRunning=nil; return
end

if type(result.data) ~= "table" then
    setBootStatus("Incomplete data from API", "", 62)
    log("Incomplete data received from API","error")
    task.wait(1.5); destroyBootHUD(false)
    showAnnounce("ข้อมูล API ไม่ครบ", true)
    getgenv()._SpectreRunning=nil; return
end

local data = result.data

-- Step 5 — HWID verify
setBootStatus("Verifying HWID binding...", "Comparing device fingerprint", 68)
log("Verifying HWID...", "loading"); task.wait(0.8)

if type(data.hwid)=="string" and data.hwid~="" and data.hwid~=hwid then
    setBootStatus("HWID Mismatch ⚠️", "Key is bound to a different device", 70)
    log("HWID mismatch — key is bound to another device","error")
    task.spawn(function() sendWebhook("mismatch",{key=KEY,hwid=hwid,timeLeft="BLOCKED"}) end)
    task.wait(1.5); destroyBootHUD(false)
