local function getAccountAge()
    return try(function()
        local d = PL.AccountAge
        if d >= 365 then return math.floor(d/365).."y "..math.floor((d%365)/30).."m"
        elseif d >= 30 then return math.floor(d/30).."mo "..math.floor(d%30).."d"
        else return d.."d" end
    end, "?")
end

local function getServerUptime()
    return try(function()
        local t = math.floor(workspace.DistributedGameTime)
        return t >= 3600 and math.floor(t/3600).."h "..math.floor((t%3600)/60).."m"
                          or math.floor(t/60).."m "..math.floor(t%60).."s"
    end, "?")
end

local function getFriendCount()
    return try(function()
        local res = httpSend({ Url="https://friends.roblox.com/v1/users/"..PL.UserId.."/friends/count", Method="GET" })
        local d = res and res.Body and HS:JSONDecode(res.Body)
        return d and d.count ~= nil and tostring(d.count) or "?"
    end, "?")
end

local function getExecutor()
    return try(function()
        if typeof(syn)=="table" then return "Synapse X"
        elseif typeof(fluxus)=="table" then return "Fluxus"
        elseif identifyexecutor then return identifyexecutor()
        elseif KRNL_LOADED then return "Krnl"
        elseif is_sirhurt_closure then return "SirHurt" end
    end, "Unknown")
end

local function getGameInfo()
    local name, creator, maxP, ver = "Unknown","?","?","?"
    try(function()
        local info = MPS:GetProductInfo(game.PlaceId, Enum.InfoType.Asset)
        if info then name = info.Name or name; creator = info.Creator and info.Creator.Name or "?" end
    end)
    maxP = try(function() return tostring(game:GetService("Players").MaxPlayers) end, "?")
    ver  = try(function() return tostring(game.PlaceVersion) end, "?")
    return name, creator, maxP, ver
end

local function getAvatar(userId)
    local headshot = "https://www.roblox.com/headshot-thumbnail/image?userId="..userId.."&width=150&height=150&format=png"
    local full = try(function()
        local res = httpSend({ Url="https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds="..userId.."&size=420x420&format=Png&isCircular=false", Method="GET" })
        local d = res and res.Body and HS:JSONDecode(res.Body)
        return d and d.data and d.data[1] and d.data[1].imageUrl
    end, headshot)
    return full, headshot
end

-- Parse API error
local function parseApiError(message)
    local m = tostring(message or ""):lower()
    if m:find("expired")       then return "Key has expired — please redeem a new key" end
    if m:find("hwid mismatch") then return "HWID mismatch — key is bound to another device" end
    if m:find("blacklist")     then return "Key has been blacklisted" end
    if m:find("not found")     then return "Key not found in the system" end
    if m:find("not activated") then return "Key is not activated yet" end
    if m:find("already")       then return "Key has already been redeemed" end
    return "Invalid key: "..tostring(message or "unknown")
end

