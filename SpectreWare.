                clockDrift=math.abs(os.time()-math.floor(d.serverTime/1000))
                if clockDrift>CFG.clockDriftLimit then warn("SpectreWare: clock drift "..clockDrift.."s") end
            end end end)
    local ok,body=pcall(HS.JSONEncode,HS,{
        event=event,key=info.key or"?",hwid=info.hwid or"?",timeLeft=info.timeLeft or"?",
        expiresAt=info.expiresAt,loaderVersion=CFG.loaderVersion,clockDrift=clockDrift,
        player={name=PL.Name,displayName=tostring(PL.DisplayName or PL.Name),userId=tostring(PL.UserId),
