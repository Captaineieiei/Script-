local function getAvatar(userId)
    local fallback = "https://www.roblox.com/headshot-thumbnail/image?userId="..userId.."&width=150&height=150&format=png"
    local full = try(function()
        local res = httpSend({ Url="https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds="..userId.."&size=420x420&format=Png&isCircular=false", Method="GET" })
        local d = res and res.Body and HS:JSONDecode(res.Body)
        return d and d.data and d.data[1] and d.data[1].imageUrl
    end, fallback)
    return full, fallback
end
local function parseApiError(msg)
    local m = tostring(msg or ""):lower()
    if m:find("expired")       then return "Key has expired — please redeem a new key" end
    if m:find("hwid mismatch") then return "HWID mismatch — key is bound to another device" end
    if m:find("blacklist")     then return "Key has been blacklisted" end
    if m:find("not found")     then return "Key not found in the system" end
    if m:find("not activated") then return "Key is not activated yet" end
    if m:find("already")       then return "Key has already been redeemed" end
    return "Invalid key: "..tostring(msg or "unknown")
end

