-- ── Helpers ──────────────────────────────────────────────────────────────────
local function safe(fn, def) local ok,v=pcall(fn) return (ok and v~=nil and v) or def end

-- URL-encode a string for safe use in query parameters
local function urlEncode(s)
    s = tostring(s or "")
    -- Use HttpService's built-in encoder if available (most reliable)
    local ok, enc = pcall(function() return HS:UrlEncode(s) end)
    if ok and enc then return enc end
    -- Fallback: encode common problematic characters manually
    return s:gsub("[^%w%-_%.~]", function(c)
        return ("%%%02X"):format(c:byte())
    end)
end

local function buildQuery(params)
    local parts = {}
    for k, v in pairs(params) do
        parts[#parts+1] = urlEncode(k).."="..urlEncode(v)
    end
    return table.concat(parts, "&")
end

-- ── HTTP wrapper ─────────────────────────────────────────────────────────────
local function httpSend(opts)
    local lo = {
        url     = opts.Url or opts.url,
        method  = (opts.Method or opts.method or "GET"):lower(),
        headers = opts.Headers or opts.headers or {},
        body    = opts.Body or opts.body,
    }
    local function norm(r)
        if r and r.body and not r.Body then r.Body = r.body end
        return r
    end
    local function try(fn)
        local ok, r = pcall(fn)
        if ok and r and (r.Body or r.body) then return norm(r) end
    end
    return try(function() if typeof(syn)=="table"    and syn.request    then return syn.request(opts)     end end)
        or try(function() if typeof(http)=="table"   and http.request   then return http.request(opts)    end end)
        or try(function() if request                                     then return request(opts)         end end)
        or try(function() if request                                     then return request(lo)           end end)
        or try(function() if http_request                                then return http_request(opts)    end end)
        or try(function() if HttpRequest                                  then return HttpRequest(opts)     end end)
        or try(function() if httpRequest                                  then return httpRequest(opts)     end end)
        or try(function() if typeof(fluxus)=="table" and fluxus.request  then return fluxus.request(opts)  end end)
        or (fetchget and { Body=fetchget(lo.url), StatusCode=200 })
        or (lo.method=="get" and (function()
                local ok2, r = pcall(function() return { Body=game:HttpGet(lo.url,true), StatusCode=200 } end)
                return ok2 and r
           end)())
        or warn("SpectreWare: no HTTP function found")
end

local function safeGet(url)
    local ok, res = pcall(httpSend, { Url=url, Method="GET" })
    if ok and res then
        local b = res.Body or res.body or ""
        if b ~= "" then return true, b end
    end
    -- Last-ditch: if pcall bubbled the raw response string, try to salvage JSON from it
    local s = tostring(res or "")
    local j = s:find("{")
    return j and true or false, j and s:sub(j) or s
end

