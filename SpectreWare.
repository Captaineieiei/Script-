-- [HARDENED #3] Multi-source HWID fingerprint
local function getHWID()
    local parts={}
    local s1=try(function() return game:GetService("RbxAnalyticsService"):GetClientId() end,"")
    if s1~="" then parts[#parts+1]="A:"..s1 end
    local s2=try(function() return "U:"..tostring(PL.UserId) end,"")
    if s2~="" then parts[#parts+1]=s2 end
    local s3=try(function()
        local inset=game:GetService("GuiService"):GetGuiInset()
        return "G:"..tostring(math.floor(inset.X+0.5)).."x"..tostring(math.floor(inset.Y+0.5))
    end,"")
    if s3~="" then parts[#parts+1]=s3 end
    local s4=try(function()
        local id=""
        if identifyexecutor then id=tostring(identifyexecutor()) end
        if id=="" and typeof(syn)=="table" then id="synapse" end
        if id=="" and typeof(fluxus)=="table" then id="fluxus" end
        return id~="" and "E:"..id or nil
    end,nil)
    if s4 then parts[#parts+1]=s4 end
    if #parts==0 then return "UNKNOWN" end
    local combined=table.concat(parts,"|")
    local h=5381
    for i=1,#combined do h=((h*33)+combined:byte(i))%0x100000000 end
    return combined.."#"..string.format("%08X",h)
end

local function fmtTime(s)
    if s>=86400 then return math.floor(s/86400).."d "..math.floor((s%86400)/3600).."h "..math.floor((s%3600)/60).."m"
    elseif s>=3600 then return math.floor(s/3600).."h "..math.floor((s%3600)/60).."m"
    else return math.floor(s/60).."m "..math.floor(s%60).."s" end
end

local function maskKey(k) local s=tostring(k or""); if #s<=8 then return string.rep("*",#s) end; return s:sub(1,4)..string.rep("*",#s-8)..s:sub(-4) end

