-- ─────────────────────────────────────────
--  HTTP WRAPPER
--  [FIX] ใช้ optsLower อย่างสม่ำเสมอในทุก fallback
-- ─────────────────────────────────────────
local function httpSend(opts)
    local ok, res
    local optsLower = {
        url     = opts.Url    or opts.url,
        method  = opts.Method or opts.method or "GET",
        headers = opts.Headers or opts.headers or {},
        body    = opts.Body   or opts.body,
    }

    local function norm(r)
        if not r then return nil end
        if r.body and not r.Body then r.Body = r.body end
        if r.Body and not r.body then r.body = r.Body end
        return r
    end

    -- [FIX v4 - Delta] ถ้า fn รันโดยไม่ error = function นั้นมีอยู่จริง
    -- ให้ return ผลทันที ไม่ต้องเช็ค Body — ให้ caller จัดการ empty body เอง
    local genv = (getgenv and getgenv()) or {}

    local tryFns = {
        function() return request(optsLower) end,                                              -- Delta / Celery / Hydrogen
        function() return http_request(optsLower) end,                                         -- Arceus X
        function() return genv.request and genv.request(optsLower) end,                        -- Delta (inject via genv)
        function() return genv.http_request and genv.http_request(optsLower) end,
        function() return syn and syn.request and syn.request(optsLower) end,                  -- Synapse X
        function() return http and http.request and http.request(optsLower) end,
        function() return fluxus and fluxus.request and fluxus.request(optsLower) end,         -- Fluxus
        function() return HttpRequest(optsLower) end,
        function() return httpRequest(optsLower) end,
        function() return genv.HttpRequest and genv.HttpRequest(optsLower) end,
        function() return KRNL_LOADED and krnl and krnl.request and krnl.request(optsLower) end,
    }

    for _, fn in ipairs(tryFns) do
        ok, res = pcall(fn)
        -- ถ้า fn สำเร็จและ return table = เจอ HTTP function แล้ว
        if ok and type(res) == "table" then
            return norm(res)
        end
    end

    -- Fallback: game:HttpGet / HttpGetAsync
    if (optsLower.method or "GET"):upper() == "GET" then
        ok, res = pcall(function()
            local b = game:HttpGet(optsLower.url, true)
            return { Body = b, body = b, StatusCode = 200 }
        end)
        if ok and res then return res end

        ok, res = pcall(function()
            local b = game:HttpGetAsync(optsLower.url)
            return { Body = b, body = b, StatusCode = 200 }
        end)
        if ok and res then return res end
    end

    warn("SpectreWare: no supported http function found")
end

