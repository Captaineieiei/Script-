-- ── Universal HTTP helper ──────────────────────────────────────────────────────
-- รองรับทุก executor: Delta, Synapse X, KRNL, Fluxus, Electron,
-- Celery, Hydrogen, Codex, Arceus X, Wave, Script-Ware, RC7 ฯลฯ
-- server ใช้ HTTP เปล่า (ไม่มี SSL) → executor request เท่านั้นที่ข้าม Roblox filter ได้
local function httpGet(url)
    -- normalize response format ของแต่ละ executor
    local function parseRes(ok, res)
        if not ok then return false, tostring(res) end
        if type(res) == "string" then return true, res end      -- body ตรง (executor เก่าบางตัว)
        if type(res) ~= "table"  then return false, "bad response type: " .. type(res) end

        -- รองรับทั้ง camelCase (StatusCode/Body) และ snake_case (status_code/body)
        local code = res.StatusCode  or res.status_code  or res.statusCode  or res.status or 200
        local body = res.Body        or res.body         or res.content      or ""

        if type(code) == "number" and code >= 400 then
            return false, "HTTP " .. tostring(code)
        end
        return true, tostring(body)
    end

    -- รายการ request functions ของ executor ต่างๆ (ลองตามลำดับ)
    local candidates = {
        syn         and syn.request,        -- Synapse X, Delta, Wave, Arceus X
        request,                            -- KRNL, Fluxus, Electron, Celery, Hydrogen, Codex, Script-Ware
        http_request,                       -- KRNL เก่า, RC7
        http        and http.request,       -- executor ที่ expose ใน table http
        fluxus      and fluxus.request,     -- Fluxus บาง version
    }

    for _, fn in ipairs(candidates) do
        if type(fn) == "function" then
            local ok, res = pcall(fn, { Url = url, Method = "GET", Headers = {} })
            local s, b = parseRes(ok, res)
            if s then return true, b end
            -- pcall สำเร็จแต่ status error = server ตอบแล้ว → ไม่ต้องลอง fn อื่น
            if ok then return false, b end
            -- pcall fail = fn นี้ไม่รองรับ → ลอง fn ถัดไป
        end
    end

    -- Last resort: game:HttpGetAsync
    -- executor บางตัว (Hydrogen, Script-Ware) patch ตัวนี้ให้รับ HTTP ได้
    local ok, res = pcall(game.HttpGetAsync, game, url)
    if ok and res then return true, res end
    return false, res and tostring(res) or "ไม่มี HTTP function ที่ใช้งานได้บน executor นี้"
end

-- ── HWID detection (Universal) ────────────────────────────────────────────────
local KEY  = getgenv().KEY or error("[SpectreWare] ใส่ key ก่อน: getgenv().KEY = 'YOUR-KEY'")
local HWID = getgenv().SW_HWID

if not HWID then
    -- ลอง fetch IP จาก ipify ผ่าน executor request
    local ok, body = httpGet("https://api64.ipify.org")
    if ok and body and #body > 3 then
        HWID = body:match("^%s*(.-)%s*$")  -- trim whitespace/newline
    end
end
if not HWID or HWID == "" then
    -- fallback: RbxAnalyticsService ClientId (ไม่ต้องใช้ network)
    local ok, id = pcall(function()
        return game:GetService("RbxAnalyticsService"):GetClientId()
    end)
    if ok and id and id ~= "" then HWID = id end
end
if not HWID or HWID == "" then
    -- last resort: ใช้ UserId (unique ต่อ Roblox account)
    HWID = tostring(Players.LocalPlayer.UserId)
end

-- ── Verify with retry ─────────────────────────────────────────────────────────
local verified   = false
local apiOffline = false
local lastError  = ""

for attempt = 1, MAX_RETRIES do
    local ok, res = httpGet(API_BASE .. "/check?key=" .. KEY .. "&hwid=" .. HWID)

    if ok and res then
        local data
        local parsed = pcall(function() data = HS:JSONDecode(res) end)
        if not parsed then
            lastError = "JSON parse error: " .. tostring(res):sub(1, 80)
            break
        end
        if data and data.success then
            verified = true
            break
        else
            getgenv().SW_LOADED = nil
            error("[SpectreWare] " .. (data and data.message or "Unauthorized"))
        end
    else
        lastError = tostring(res)
        warn(string.format("[SpectreWare] API ไม่ตอบสนอง (attempt %d/%d) — %s", attempt, MAX_RETRIES, lastError))
        if attempt < MAX_RETRIES then task.wait(RETRY_DELAY) else apiOffline = true end
    end
end

-- ── Offline = Kick ────────────────────────────────────────────────────────────
if not verified then
    if apiOffline then
        local detail = lastError ~= "" and ("\n(" .. lastError:sub(1, 80) .. ")") or ""
        warn("[SpectreWare] ⚠️ API offline — กำลัง kick... error: " .. lastError)
        task.wait(1)
        Players.LocalPlayer:Kick("\n[SpectreWare]\nระบบ API ขัดข้อง กรุณาลองใหม่ภายหลัง" .. detail)
    else
        getgenv().SW_LOADED = nil
        error("[SpectreWare] ยืนยัน key ไม่ผ่าน")
    end
    return
end

-- ── Announce UI ───────────────────────────────────────────────────────────────
local function showAnnounce(title, message)
    local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
    local old = playerGui:FindFirstChild("SW_Announce")
    if old then old:Destroy() end

    local sg = Instance.new("ScreenGui")
    sg.Name           = "SW_Announce"
    sg.ResetOnSpawn   = false
    sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    sg.Parent         = playerGui

    local backdrop = Instance.new("Frame")
    backdrop.Size                    = UDim2.new(1, 0, 1, 0)
    backdrop.BackgroundColor3        = Color3.fromRGB(0, 0, 0)
    backdrop.BackgroundTransparency  = 0.5
    backdrop.BorderSizePixel         = 0
    backdrop.Parent                  = sg

    local card = Instance.new("Frame")
    card.Size             = UDim2.new(0, 480, 0, 160)
    card.Position         = UDim2.new(0.5, -240, 0.5, -80)
    card.BackgroundColor3 = Color3.fromRGB(10, 10, 20)
    card.BorderSizePixel  = 0
    card.Parent           = sg
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 12)

    local stroke = Instance.new("UIStroke")
    stroke.Color     = Color3.fromRGB(0, 210, 255)
    stroke.Thickness = 1.5
    stroke.Parent    = card

    local lbTitle = Instance.new("TextLabel")
    lbTitle.Size                   = UDim2.new(1, -24, 0, 36)
    lbTitle.Position               = UDim2.new(0, 12, 0, 10)
    lbTitle.BackgroundTransparency = 1
    lbTitle.Text                   = "📢  " .. (title ~= "" and title or "SpectreWare")
    lbTitle.TextColor3             = Color3.fromRGB(0, 210, 255)
    lbTitle.Font                   = Enum.Font.GothamBold
    lbTitle.TextSize               = 16
    lbTitle.TextXAlignment         = Enum.TextXAlignment.Left
    lbTitle.Parent                 = card

    local div = Instance.new("Frame")
    div.Size                    = UDim2.new(1, -24, 0, 1)
    div.Position                = UDim2.new(0, 12, 0, 50)
    div.BackgroundColor3        = Color3.fromRGB(0, 210, 255)
    div.BackgroundTransparency  = 0.7
    div.BorderSizePixel         = 0
    div.Parent                  = card

    local lbMsg = Instance.new("TextLabel")
    lbMsg.Size                   = UDim2.new(1, -24, 0, 80)
    lbMsg.Position               = UDim2.new(0, 12, 0, 60)
    lbMsg.BackgroundTransparency = 1
    lbMsg.Text                   = message or ""
    lbMsg.TextColor3             = Color3.fromRGB(220, 220, 220)
    lbMsg.Font                   = Enum.Font.Gotham
    lbMsg.TextSize               = 14
    lbMsg.TextXAlignment         = Enum.TextXAlignment.Left
    lbMsg.TextYAlignment         = Enum.TextYAlignment.Top
    lbMsg.TextWrapped            = true
    lbMsg.Parent                 = card

    for i = 1, 10 do card.BackgroundTransparency = 1 - (i / 10) * 0.05; task.wait(0.02) end
    task.delay(8, function()
        for i = 1, 20 do card.BackgroundTransparency = i / 20; task.wait(0.03) end
        sg:Destroy()
    end)
end

-- ── Long-poll announce loop ───────────────────────────────────────────────────
local announceSeq = 0
task.spawn(function()
    while task.wait(30) do
        local ok, res = httpGet(API_BASE .. "/announce?key=" .. KEY .. "&seq=" .. announceSeq)
        if ok and res then
            local data
            pcall(function() data = HS:JSONDecode(res) end)
            if data and data.id and data.id ~= "" and data.seq ~= announceSeq then
                announceSeq = data.seq
                showAnnounce(data.title or "", data.message or "")
            elseif data and data.seq then
                announceSeq = data.seq
            end
        end
    end
end)

