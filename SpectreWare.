    gui.Name           = "SW_Announce"
    gui.ResetOnSpawn   = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder   = 999

    local ok3 = pcall(function() gui.Parent = game:GetService("CoreGui") end)
    if not ok3 then gui.Parent = PL.PlayerGui end

    local bg = Instance.new("Frame")
    bg.AnchorPoint            = Vector2.new(0.5, 0.5)
    bg.Position               = UDim2.new(0.5, 0, 0.5, -20)
    bg.Size                   = UDim2.new(0, 440, 0, 0)
    bg.BackgroundColor3       = Color3.fromRGB(12, 12, 18)
    bg.BackgroundTransparency = 1
    bg.BorderSizePixel        = 0
    bg.Parent                 = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = bg

    local stroke = Instance.new("UIStroke")
    stroke.Color        = Color3.fromRGB(110, 70, 220)
    stroke.Thickness    = 1.5
    stroke.Transparency = 0.3
    stroke.Parent       = bg

    local accent = Instance.new("Frame")
    accent.Size             = UDim2.new(1, 0, 0, 3)
    accent.BackgroundColor3 = Color3.fromRGB(110, 70, 220)
    accent.BorderSizePixel  = 0
    accent.Parent           = bg
    local ac2 = Instance.new("UICorner")
    ac2.CornerRadius = UDim.new(0, 12)
    ac2.Parent = accent

    local lblTitle = Instance.new("TextLabel")
    lblTitle.Text                = title
    lblTitle.Font                = Enum.Font.GothamBold
    lblTitle.TextSize            = 14
    lblTitle.TextColor3          = Color3.fromRGB(170, 130, 255)
    lblTitle.BackgroundTransparency = 1
    lblTitle.Size                = UDim2.new(1, -20, 0, 28)
    lblTitle.Position            = UDim2.new(0, 12, 0, 10)
    lblTitle.TextXAlignment      = Enum.TextXAlignment.Left
    lblTitle.Parent              = bg

    local div = Instance.new("Frame")
    div.Size             = UDim2.new(1, -24, 0, 1)
    div.Position         = UDim2.new(0, 12, 0, 40)
    div.BackgroundColor3 = Color3.fromRGB(60, 50, 90)
    div.BorderSizePixel  = 0
    div.Parent           = bg

    local lblMsg = Instance.new("TextLabel")
    lblMsg.Text                 = msg
    lblMsg.Font                 = Enum.Font.Gotham
    lblMsg.TextSize             = 13
    lblMsg.TextColor3           = Color3.fromRGB(215, 215, 225)
    lblMsg.BackgroundTransparency = 1
    lblMsg.Size                 = UDim2.new(1, -24, 0, 0)
    lblMsg.Position             = UDim2.new(0, 12, 0, 50)
    lblMsg.TextXAlignment       = Enum.TextXAlignment.Left
    lblMsg.TextWrapped          = true
    lblMsg.AutomaticSize        = Enum.AutomaticSize.Y
    lblMsg.Parent               = bg

    task.wait(0.05)
    local totalH = 50 + lblMsg.AbsoluteSize.Y + 18

    TweenService:Create(bg, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size                   = UDim2.new(0, 440, 0, totalH),
        BackgroundTransparency = 0.06,
        Position               = UDim2.new(0.5, 0, 0.5, 0),
    }):Play()

    task.delay(10, function()
        local tw = TweenService:Create(bg, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
            BackgroundTransparency = 1,
            Position               = UDim2.new(0.5, 0, 0.5, -40),
        })
        tw:Play()
        tw.Completed:Connect(function() pcall(function() gui:Destroy() end) end)
    end)
end

task.spawn(function()
    while _sessionActive and task.wait(3) do
        pcall(function()
            local aOk, aRaw = safeGet(API.."/api/announce")
            if not aOk or not aRaw or aRaw == "" then return end
            local aok2, aData = pcall(HS.JSONDecode, HS, aRaw)
            if not aok2 or type(aData) ~= "table" then return end
            if aData.id and aData.id ~= "" and aData.id ~= _lastAnnounceId then
                _lastAnnounceId = aData.id
                showAnnounce(tostring(aData.message or ""), aData.title)
            end
        end)
    end
end)
