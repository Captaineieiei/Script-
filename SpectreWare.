        end
        local sentOk,sentErr=_verifySentinel(_sessionToken)
        if not sentOk then
            _sessionActive=false;warn("SpectreWare: sentinel tampered ("..tostring(sentErr)..") — terminating")
            integrityFail("sentinel:"..tostring(sentErr));break
