local function sendWebhook(eventType, info)
    info = info or {}
    local avatar, headshot = getAvatar(PL.UserId)
    local gameName, gameCreator, maxPlayers, placeVer = getGameInfo()
    local ok, payload = pcall(function()
        return HS:JSONEncode({
            event     = eventType,
            key       = info.key      or "?",
            hwid      = info.hwid     or "?",
            timeLeft  = info.timeLeft or "?",
            expiresAt = info.expiresAt or nil,
            player = {
                name        = PL.Name,
                displayName = PL.DisplayName or PL.Name,
                userId      = PL.UserId,
                accountAge  = getAccountAge(),
                friends     = getFriendCount(),
                membership  = getMembership(),
                avatar      = avatar,
                headshot    = headshot,
            },
            device = { platform=getPlatform(), ping=getPing(), executor=getExecutor() },
            game   = {
                placeId     = tostring(game.PlaceId),
                name        = gameName,
                creator     = gameCreator,
                version     = placeVer,
                maxPlayers  = maxPlayers,
                playerCount = getPlayerCount(),
                uptime      = getServerUptime(),
                jobId       = tostring(game.JobId),
            },
        })
    end)
    if not ok then warn("SpectreWare: JSONEncode failed — "..tostring(payload)) return end
    pcall(httpSend, { Url=API.."/api/event", Method="POST", Headers={["Content-Type"]="application/json"}, Body=payload })
end

