local function cleanupSession()
    _active = false
    getgenv()._SpectreRunning = nil
    if _conn then _conn:Disconnect() end
end

task.spawn(function()
    while _active and task.wait(SESSION_CHECK_INTERVAL) do
        if not PL or not PL.Parent then cleanupSession() break end
        local cOk, cRaw = safeGet(API.."/api/lookup?"..authQuery)
        if cOk and cRaw and cRaw ~= "" then
            local ok3, cr = pcall(HS.JSONDecode, HS, cRaw)
            if ok3 and type(cr) == "table" then
                local expired = (cr.success ~= true and cr.success ~= "true")
                if not expired and type(cr.data) == "table" then
                    local ea = cr.data.expiresAt
                    if ea and ea ~= -1 and (ea - os.time()*1000) <= 0 then expired = true end
                end
                if expired then
                    cleanupSession()
                    log("Key expired — kicking from session...","error")
                    task.wait(2)
                    pcall(function() sendWebhook("expired",{key=KEY,hwid=hwid,timeLeft="EXPIRED — SESSION ENDED"}) end)
                    task.wait(1)
                    pcall(function() PL:Kick("[ SpectreWare ]  Your key has expired.\nPlease redeem a new key in Discord.") end)
                    return
                end
            end
        end
    end
    cleanupSession()
end)

