        local cOk, cRaw = safeGet(CFG.API.."/api/lookup?key="..KEY.."&hwid="..hwid)
        if cOk and cRaw and cRaw~="" then
            local ok3, cr = pcall(HS.JSONDecode, HS, cRaw)
            if ok3 and type(cr)=="table" then
                local expired = cr.success~=true and cr.success~="true"
                if not expired and type(cr.data)=="table" then
                    local ea = cr.data.expiresAt
                    if ea ~= nil and ea ~= -1 and ea-os.time()*1000 <= 0 then expired=true end
                end
                if expired then
                    _sessionActive=false
                    log("Key expired — kicking...","error"); task.wait(2)
                    pcall(function() sendWebhook("expired",{key=KEY,hwid=hwid,timeLeft="EXPIRED"}) end)
                    task.wait(1)
                    PL:Kick("[ SpectreWare ]  Your key has expired.\nPlease redeem a new key in Discord.")
                    getgenv()._SpectreRunning=nil; _conn:Disconnect(); return
                end
            end
        end
    end
    getgenv()._SpectreRunning=nil
    if _conn then _conn:Disconnect() end
end)
