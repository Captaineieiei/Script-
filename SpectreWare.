    local jobId       = tostring(game.JobId)
    local fullKey     = tostring(info.key)
    local keyDisplay  = fullKey:sub(1,8).."———"..fullKey:sub(-4)
    local hwidFull    = tostring(info.hwid)

    -- expiry date string
