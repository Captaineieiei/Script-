-- ══════════════════════════════════════════════════════
-- SESSION MANAGEMENT
-- ══════════════════════════════════════════════════════
local _sessionActive = true
local _lastSeq, _lastAnnounceId = 0, 0

-- Announce long-poll
task.spawn(function()
    while _sessionActive do
        pcall(function()
            local ok, raw2 = safeGet(API.."/api/announce?seq=".._lastSeq.."&key="..KEY)
            if not ok or not raw2 or raw2=="" then return end
            local ok2, d = pcall(HS.JSONDecode, HS, raw2)
            if not ok2 or type(d)~="table" then return end
            if type(d.seq)=="number" then
                if d.seq < _lastSeq then _lastSeq = 0 end
                _lastSeq = d.seq
            end
            local id, m = tonumber(d.id) or 0, tostring(d.message or "")
            if id > _lastAnnounceId and m ~= "" then _lastAnnounceId=id; showAnnounce(m) end
        end)
        task.wait(8)
    end
end)
log("Announce listener ready 📢","success")

-- Player disconnect guard
local _conn
_conn = game:GetService("Players").PlayerRemoving:Connect(function(p)
    if p==PL then _sessionActive=false; getgenv()._SpectreRunning=nil; _conn:Disconnect() end
end)

-- ────────────────────────────────────────────────────────
-- [SESSION LOCK] — Session ping + concurrent session detection
-- ────────────────────────────────────────────────────────
task.spawn(function()
    while _sessionActive and task.wait(10) do
        if not PL or not PL.Parent then _sessionActive=false; break end

        -- ส่ง sessionToken ไปด้วยทุกครั้ง
        local pingPayload = { key=KEY, hwid=hwid }
        if _sessionToken ~= "" then pingPayload.sessionToken = _sessionToken end

        local cOk, cRaw = safePost(API.."/api/ping", pingPayload)
        if not (cOk and cRaw and cRaw~="") then
            cOk, cRaw = safePost(API.."/api/lookup", { key=KEY, hwid=hwid })
        end

        if cOk and cRaw and cRaw~="" then
            local ok3, cr = pcall(HS.JSONDecode,HS,cRaw)
            if ok3 and type(cr)=="table" then

                -- ── [SESSION LOCK] ตรวจ session revoke ──
                local msg = tostring(cr.message or ""):lower()
                if cr.success == false and msg:find("session_revoked") then
                    _sessionActive = false
                    log("⚠️ SESSION REVOKED — key used on another device!", "error")
                    showAnnounce("🚫 Session Revoked — Key ถูกใช้บนอุปกรณ์อื่น!", true)
                    task.spawn(function()
                        sendWebhook("session_revoked", {
                            key=KEY, hwid=hwid, sessionToken=_sessionToken,
                            timeLeft="REVOKED"
                        })
                    end)
                    task.wait(3)
                    panic("Session revoked — key is being used on another device.")
                    return
                end

                -- ── ตรวจ expired ──
                local expired = (cr.success~=true and cr.success~="true")
                if not expired and type(cr.data)=="table" then
                    local ea = cr.data.expiresAt
                    if ea~=nil and ea~=-1 and ea-os.time()*1000<=0 then expired=true end
                    -- อัพเดต sessionToken ถ้า server rotate
                    if type(cr.data.sessionToken)=="string" and cr.data.sessionToken~="" then
                        _sessionToken = cr.data.sessionToken
                    end
                end

                if expired then
                    _sessionActive=false
                    log("Key expired — kicking from session...","error")
                    showAnnounce("Key หมดอายุ — กำลัง kick...", true)
                    task.wait(2)
                    pcall(function() sendWebhook("expired",{key=KEY,hwid=hwid,sessionToken=_sessionToken,timeLeft="EXPIRED — SESSION ENDED"}) end)
                    task.wait(1)
                    PL:Kick("[ SpectreWare ]  Your key has expired.\nPlease redeem a new key in Discord.")
                    getgenv()._SpectreRunning=nil; _conn:Disconnect(); return
                end
            end
        end
    end
    _sessionActive=false
    getgenv()._SpectreRunning=nil
    if _conn then _conn:Disconnect() end
end)
