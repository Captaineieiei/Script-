            _sessionActive=false;warn("SpectreWare: integrityFail hook detected — terminating")
            _clearSentinel();getgenv()[_GK.running]=nil
            _r_pcall(function() PL:Kick("[ SpectreWare ]  Anti-Bypass triggered.\nReason: fn_hook") end);break
        end
        if not _checkCanary() then
