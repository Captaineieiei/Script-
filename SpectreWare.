-- ─────────────────────────────────────────
--  HTTP WRAPPER
-- ─────────────────────────────────────────
local function httpSend(opts)
    local ok, res
    local optsLower = {
        url     = opts.Url    or opts.url,
        method  = opts.Method or opts.method or "GET",
        headers = opts.Headers or opts.headers or {},
        body    = opts.Body   or opts.body,
    }

    ok, res = pcall(function() if typeof(syn)=="table" and syn.request then return syn.request(opts) end end)
    if ok and res and res.Body then return res end

    ok, res = pcall(function() if typeof(http)=="table" and http.request then return http.request(opts) end end)
    if ok and res and res.Body then return res end

    ok, res = pcall(function() if request then return request(opts) end end)
    if ok and res and res.Body then return res end

    ok, res = pcall(function() if request then return request(optsLower) end end)
    if ok and res and (res.Body or res.body) then
        if res.body and not res.Body then res.Body = res.body end
        return res
    end

    ok, res = pcall(function() if http_request then return http_request(opts) end end)
    if ok and res and res.Body then return res end

    ok, res = pcall(function() if HttpRequest then return HttpRequest(opts) end end)
    if ok and res and res.Body then return res end

    ok, res = pcall(function() if httpRequest then return httpRequest(opts) end end)
    if ok and res and res.Body then return res end

    ok, res = pcall(function() if typeof(fluxus)=="table" and fluxus.request then return fluxus.request(opts) end end)
    if ok and res and res.Body then return res end

    if (opts.Method or opts.method or "GET"):upper() == "GET" then
        ok, res = pcall(function()
            return { Body = game:HttpGet(opts.Url or opts.url), StatusCode = 200 }
        end)
        if ok and res and res.Body then return res end
    end

    warn("SpectreWare: no supported http function found")
end

