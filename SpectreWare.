-- ────────────────────────────────────────────────────────
-- Webhook
-- ────────────────────────────────────────────────────────
local function sendWebhook(eventType, info)
    info = info or {}
    local avatar, headshot = getAvatar(PL.UserId)
    local gameName, gameCreator, maxPlayers, placeVer = getGameInfo()
    local ok, body = pcall(HS.JSONEncode, HS, {
        event    = eventType,
        key      = info.key or "?", hwid = info.hwid or "?",
        sessionToken = info.sessionToken or "?",
        timeLeft = info.timeLeft or "?", expiresAt = info.expiresAt,
        loaderVersion = LOADER_VERSION,
        player   = { name=PL.Name, displayName=tostring(PL.DisplayName or PL.Name),
                     userId=tostring(PL.UserId), accountAge=getAccountAge(),
                     friends=getFriendCount(), membership=getMembership(),
                     avatar=avatar, headshot=headshot },
        device   = { platform=getPlatform(), ping=getPing(), executor=getExecutor() },
        game     = { name=gameName, creator=gameCreator, placeId=tostring(game.PlaceId),
                     version=placeVer, maxPlayers=maxPlayers, playerCount=getPlayerCount(),
                     uptime=getServerUptime(), jobId=tostring(game.JobId) },
    })
    if ok then pcall(httpSend, { Url=API.."/api/event", Method="POST",
        Headers={ ["Content-Type"]="application/json" }, Body=body }) end
end

-- ────────────────────────────────────────────────────────
-- [SIGNED SCRIPT DELIVERY] — ขอ script จาก API โดยตรง
-- ────────────────────────────────────────────────────────
local function loadSignedScript(key, hwid, placeId)
    -- ขอ script content จาก /api/getscript (server ส่ง Lua code กลับมา)
    local ok, raw = safePost(API.."/api/getscript", {
        key     = key,
        hwid    = hwid,
        placeId = tostring(placeId)
    })

    if ok and raw and raw ~= "" then
        local ok2, result = pcall(HS.JSONDecode, HS, raw)
        if ok2 and type(result) == "table" and result.success then
            local scriptContent = result.data and result.data.content
            if scriptContent and scriptContent ~= "" then
                log("Signed script received from API ✓", "success")
                local fn, err = loadstring(scriptContent)
                if fn then
                    fn()
                    return true
                else
                    log("Script compile error: "..tostring(err), "error")
                end
            end
            -- ถ้า server ส่ง URL มาแทน content
            local signedUrl = result.data and result.data.url
            if signedUrl and signedUrl ~= "" then
                log("Signed URL received — fetching...", "loading")
                local scriptBody = try(function()
                    return game:HttpGet(signedUrl, true)
                end, nil)
                if scriptBody then
                    local fn2, err2 = loadstring(scriptBody)
                    if fn2 then fn2(); return true
                    else log("Script error: "..tostring(err2), "error") end
                end
            end
        end
    end

    -- Fallback: GitHub raw URL (เหมือน v2.1)
    if SCRIPT_FALLBACK then
        log("Falling back to direct URL...", "warn")
        local fn3, err3 = loadstring(game:HttpGet(SCRIPT_FALLBACK, true))
        if fn3 then fn3(); return true
        else log("Fallback error: "..tostring(err3), "error") end
    end

    return false
end

