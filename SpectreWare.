local function try(fn,def) local ok,v=pcall(fn); return ok and v or def end
local function new(cls,props,parent)
    local i=Instance.new(cls); for k,v in pairs(props) do i[k]=v end; i.Parent=parent; return i
end
local function clone(t,ext)
    local c={}; for k,v in pairs(t) do c[k]=v end; for k,v in pairs(ext or{}) do c[k]=v end; return c
end

local function httpSend(opts)
    local lo={url=opts.Url or opts.url,method=opts.Method or"GET",headers=opts.Headers or{},body=opts.Body or opts.body}
    for _,fn in ipairs({
        function() return syn and syn.request and syn.request(opts) end,
        function() return http and http.request and http.request(opts) end,
        function() return request and request(opts) end,
        function() return request and request(lo) end,
        function() return http_request and http_request(opts) end,
        function() return HttpRequest and HttpRequest(opts) end,
        function() return httpRequest and httpRequest(opts) end,
        function() return fluxus and fluxus.request and fluxus.request(opts) end,
    }) do
        local ok,res=pcall(fn)
        if ok and res then
            if res.body and not res.Body then res.Body=res.body end
            if res.Body then return res end
        end
    end
    if (opts.Method or"GET"):upper()=="GET" then
        local ok,res=pcall(function() return{Body=game:HttpGet(opts.Url or opts.url),StatusCode=200} end)
        if ok and res and res.Body then return res end
    end
    warn("SpectreWare: no http function found")
end

local function safeGet(url)
    local ok,res=pcall(httpSend,{Url=url,Method="GET"})
    if ok and res and (res.Body or"")~="" then return true,res.Body end
    return false,""
end

local function safeGetTimeout(url,timeout)
    local done,result,body=false,false,""
    task.spawn(function()
        local ok,b=safeGet(url); if not done then result,body=ok,b end; done=true
    end)
    local e=0; while not done and e<timeout do task.wait(0.1); e=e+0.1 end
    if not done then return false,"timeout" end
    return result,body
end

local function getHWID()
    local id=try(function() return game:GetService("RbxAnalyticsService"):GetClientId() end,"UNKNOWN")
    if id=="UNKNOWN" then id=try(function() return tostring(PL.UserId).."_"..tostring(game.JobId):sub(1,8) end,"UNKNOWN") end
    return id
end

local function fmtTime(s)
    if s>=86400 then return math.floor(s/86400).."d "..math.floor((s%86400)/3600).."h "..math.floor((s%3600)/60).."m"
    elseif s>=3600 then return math.floor(s/3600).."h "..math.floor((s%3600)/60).."m"
    else return math.floor(s/60).."m "..math.floor(s%60).."s" end
end

