    if hwid==""or hwid=="UNKNOWN" then log("Cannot determine HWID","error");integrityFail("HWID unknown");return end
    log("HWID: "..tostring(hwid):sub(1,28).."...","info")

    local callOk,raw
    for i=1,3 do
        log(("Connecting to API... (%d/3)"):format(i),"loading")
        local ok2,raw2
        task.spawn(function() ok2,raw2=apiLookup(KEY,hwid) end)
        local e=0;while ok2==nil and e<10 do task.wait(0.1);e=e+0.1 end
        callOk,raw=ok2 or false,raw2 or""
        if callOk and raw and raw~="" then break end
        if i<3 then task.wait(1.5*i) end
    end
    if not callOk or not raw or raw=="" then
        log("Cannot reach API — enable HTTP Requests or server is down","error");getgenv()[_GK.running]=nil;return
    end

    local result=_parseResult(raw)
    if not result then log("Invalid or incomplete API response","error");integrityFail("bad response");return end
    log("API response received ✓","info")

    if result.success~=true and result.success~="true" then
        log(parseApiError(result.message),"error")
        if tostring(result.message or""):lower():find("expired") then
            task.spawn(function() sendWebhook("expired",{key=KEY,hwid=hwid,timeLeft="EXPIRED"}) end)
            task.wait(2);PL:Kick("[ SpectreWare ]  Your key has expired.\nPlease redeem a new key in Discord.")
        end
        getgenv()[_GK.running]=nil;return
    end
    if type(result.data)~="table" then log("Incomplete data from API","error");getgenv()[_GK.running]=nil;return end

    local data=result.data
    if type(data.hwid)=="string" and data.hwid~="" and data.hwid~=hwid then
        log("HWID mismatch — key is bound to another device","error")
        task.spawn(function() sendWebhook("mismatch",{key=KEY,hwid=hwid,timeLeft="BLOCKED"}) end)
        getgenv()[_GK.running]=nil;task.wait(2)
        PL:Kick("[ SpectreWare ]  HWID Mismatch.\nKey นี้ผูกกับอุปกรณ์อื่น — ติดต่อ Discord.");return
    end
    log("HWID verified ✓","success")

    local timeLeft,expiresAt="Permanent",data.expiresAt
    if expiresAt~=nil and expiresAt~=-1 then
        local diff=_r_floor((expiresAt-os.time()*1000)/1000)
        if diff<=0 then log("Key has already expired","error");getgenv()[_GK.running]=nil;return end
        timeLeft=fmtTime(diff)
    end
    _expiresAt_cached=expiresAt
    log("Key verified ✓  —  Expires: "..timeLeft,"success")

    print("\n    ✅  KEY VERIFIED  —  SpectreWare v2\n   --------------------------------")
    print("    👤  "..PL.Name.."\n    🔑  "..tostring(hwid):sub(1,24).."...")
    print("    ⏳  "..timeLeft.."\n    🎮  "..tostring(game.PlaceId).."\n   --------------------------------\n")
    task.spawn(function() sendWebhook("login",{key=KEY,hwid=hwid,timeLeft=timeLeft,expiresAt=expiresAt}) end)

    local KEY_POLL=KEY;KEY=nil
    local SCRIPT=data.scriptUrl
    if not SCRIPT or SCRIPT=="" then
        log("API did not return scriptUrl for PlaceId "..tostring(game.PlaceId),"error");getgenv()[_GK.running]=nil;return
    end

    log("Loading script...","loading")
    local scriptOk,scriptSrc
    for i=1,3 do
        log(("Fetching script... (%d/3)"):format(i),"loading")
        scriptOk,scriptSrc=safeGetTimeout(SCRIPT,15)
        if scriptOk and scriptSrc and scriptSrc~="" then break end
        if i<3 then task.wait(2*i) end
    end
    if not scriptOk or not scriptSrc or scriptSrc=="" then
        log("Failed to fetch script after 3 attempts","error");getgenv()[_GK.running]=nil;return
    end
    if #scriptSrc<32 then log("Script source suspiciously short — aborting","error");integrityFail("script too short");return end

    if type(data.scriptHash)=="string" and data.scriptHash~="" then
        if _djb2(scriptSrc)~=data.scriptHash:upper() then
            log("Script integrity check failed (DJB2)","error");integrityFail("script hash mismatch DJB2");return
        end
        log("Script integrity verified ✓  (DJB2)","success")
    end
    if type(data.scriptHashFnv)=="string" and data.scriptHashFnv~="" then
        if _fnv1a(scriptSrc)~=data.scriptHashFnv:upper() then
            log("Script integrity check failed (FNV1a)","error");integrityFail("script hash mismatch FNV1a");return
        end
        log("Script integrity verified ✓  (FNV1a)","success")
    end

    local fn,compErr=_native_loadstring(scriptSrc)
    if not fn then log("Script compile error: "..tostring(compErr),"error");getgenv()[_GK.running]=nil;return end
    _verified=true;task.spawn(fn);log("Script loaded 🚀","success")

end,function(err) warn("SpectreWare: unexpected error — "..tostring(err));_clearSentinel();getgenv()[_GK.running]=nil;getgenv()[_GK.canary]=nil end)
if not _mainOk or not _verified then return end

