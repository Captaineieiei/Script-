--  HTTP WRAPPER  (รองรับทุก executor)
-- ─────────────────────────────────────────
local function httpSend(opts)
    local ok, res

    -- normalised lowercase opts (รองรับ executor ที่ต้องการ lowercase)
    local optsLower = {
        url     = opts.Url    or opts.url,
        method  = (opts.Method or opts.method or "GET"):lower(),
        headers = opts.Headers or opts.headers or {},
        body    = opts.Body   or opts.body,
    }

    -- helper: normalise response body key
    local function norm(r)
        if r and r.body and not r.Body then r.Body = r.body end
        return r
    end

    -- 1. syn.request  (Synapse X v2/v3)
    ok, res = pcall(function()
        if typeof(syn) == "table" and syn.request then return syn.request(opts) end
    end)
    if ok and res and (res.Body or res.body) then return norm(res) end

    -- 2. http.request  (บาง executor expose แบบนี้)
    ok, res = pcall(function()
        if typeof(http) == "table" and http.request then return http.request(opts) end
    end)
    if ok and res and (res.Body or res.body) then return norm(res) end

    -- 3. request (uppercase opts)
    ok, res = pcall(function()
        if request then return request(opts) end
    end)
    if ok and res and (res.Body or res.body) then return norm(res) end

    -- 4. request (lowercase opts)
    ok, res = pcall(function()
        if request then return request(optsLower) end
    end)
    if ok and res and (res.Body or res.body) then return norm(res) end

    -- 5. http_request
    ok, res = pcall(function()
        if http_request then return http_request(opts) end
    end)
    if ok and res and (res.Body or res.body) then return norm(res) end

    -- 6. HttpRequest
    ok, res = pcall(function()
        if HttpRequest then return HttpRequest(opts) end
    end)
    if ok and res and (res.Body or res.body) then return norm(res) end

    -- 7. httpRequest
    ok, res = pcall(function()
        if httpRequest then return httpRequest(opts) end
    end)
    if ok and res and (res.Body or res.body) then return norm(res) end

    -- 8. fluxus.request
    ok, res = pcall(function()
        if typeof(fluxus) == "table" and fluxus.request then return fluxus.request(opts) end
    end)
    if ok and res and (res.Body or res.body) then return norm(res) end

    -- 9. fetchget / fetchGet  (Delta, Wave, บาง executor)
    ok, res = pcall(function()
        if fetchget then
            return { Body = fetchget(optsLower.url), StatusCode = 200 }
        end
    end)
    if ok and res and res.Body then return res end

    -- 10. game:HttpGet fallback (GET only)
    if (opts.Method or opts.method or "GET"):upper() == "GET" then
        ok, res = pcall(function()
            return { Body = game:HttpGet(opts.Url or opts.url, true), StatusCode = 200 }
        end)
        if ok and res and res.Body then return res end
    end

    warn("SpectreWare: no supported http function found")
end

