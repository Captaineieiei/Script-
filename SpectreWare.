-- HTTP wrapper (tries all known executor functions)
local function httpSend(opts)
    local lo = { url=opts.Url or opts.url, method=opts.Method or opts.method or "GET",
                 headers=opts.Headers or opts.headers or {}, body=opts.Body or opts.body }
    local fns = {
        function() return syn and syn.request and syn.request(opts) end,
        function() return http and http.request and http.request(opts) end,
        function() return request and request(opts) end,
        function() return request and request(lo) end,
        function() return http_request and http_request(opts) end,
        function() return HttpRequest and HttpRequest(opts) end,
        function() return httpRequest and httpRequest(opts) end,
        function() return fluxus and fluxus.request and fluxus.request(opts) end,
    }
    for _, fn in ipairs(fns) do
        local ok, res = pcall(fn)
        if ok and res then
            if res.body and not res.Body then res.Body = res.body end
            if res.Body then return res end
        end
    end
    if (opts.Method or opts.method or "GET"):upper() == "GET" then
        local ok, res = pcall(function()
            return { Body = game:HttpGet(opts.Url or opts.url), StatusCode = 200 }
        end)
        if ok and res and res.Body then return res end
    end
    warn("SpectreWare: no supported http function found")
end

-- Safe GET
local function safeGet(url)
    local ok, res = pcall(httpSend, { Url=url, Method="GET" })
    if ok and res then
        local body = res.Body or res.body or ""
        if body ~= "" then return true, body end
    end
    local s = tostring(res or "")
    local j = s:find("{")
    return j and true or false, j and s:sub(j) or s
end

-- [FIX #1] Safe POST — ส่ง key/hwid ผ่าน body แทน URL query string
local function safePost(url, payload)
    local ok, body = pcall(HS.JSONEncode, HS, payload)
    if not ok then return false, nil end
    local ok2, res = pcall(httpSend, {
        Url = url, Method = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body = body
    })
    if ok2 and res then
        local rb = res.Body or res.body or ""
        if rb ~= "" then return true, rb end
    end
    return false, nil
end

-- pcall helper
local function try(fn, def) local ok, v = pcall(fn); return ok and v or def end

