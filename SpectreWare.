-- HTTP
local function _normalizeRes(res)
    if not res then return nil end
    -- normalize body field
    if res.body and not res.Body then res.Body=res.body end
    if res.Body and not res.body then res.body=res.Body end
    -- normalize status
    if res.StatusCode and not res.statusCode then res.statusCode=res.StatusCode end
    if res.statusCode and not res.StatusCode then res.StatusCode=res.statusCode end
    -- unwrap nested body (some executors wrap in .body.body)
    if type(res.Body)=="table" then res.Body=tostring(res.Body) end
    return (res.Body and res.Body~="") and res or nil
end

local function httpSend(opts)
    local url=opts.Url or opts.url or""
    local method=(opts.Method or"GET"):upper()
    local fns={
        function() return syn and syn.request and syn.request(opts) end,
        function() return http and rawget(http,"request") and http.request(opts) end,
        function() return _r_rawget(_G,"request") and _r_rawget(_G,"request")(opts) end,
        function() return request and request(opts) end,
        function() return http_request and http_request(opts) end,
        function() return HttpRequest and HttpRequest(opts) end,
        function() return httpRequest and httpRequest(opts) end,
        function() return fluxus and fluxus.request and fluxus.request(opts) end,
        -- Delta-specific
        function() return Delta and Delta.request and Delta.request(opts) end,
        function() return delta and delta.request and delta.request(opts) end,
        function() return _r_rawget(_G,"Delta") and _r_rawget(_G,"Delta").request and _r_rawget(_G,"Delta").request(opts) end,
        -- Arceus X / mobile alts
        function() return ARCEUS_X and ARCEUS_X.http_request and ARCEUS_X.http_request(opts) end,
        function() return getgenv().request and getgenv().request(opts) end,
        function() return _G.request and _G.request(opts) end,
    }
    for _,fn in ipairs(fns) do
        local ok,res=pcall(fn)
        local nr=ok and _normalizeRes(res)
        if nr then return nr end
    end
    -- GET fallback: game:HttpGet
    if method=="GET" then
        local ok,body=pcall(function() return game:HttpGet(url,true) end)
        if ok and body and body~="" then return{Body=body,body=body,StatusCode=200} end
    end
    warn("SpectreWare: no http function found")
end

local function safeGet(url)
    local ok,res=pcall(httpSend,{Url=url,Method="GET"})
    if ok and res and (res.Body or"")~="" then return true,res.Body end
    return false,""
end
local function safeGetTimeout(url,timeout)
    local done,result,body=false,false,""
    task.spawn(function() local ok,b=safeGet(url);if not done then result,body=ok,b end;done=true end)
    local e=0;while not done and e<timeout do task.wait(0.1);e=e+0.1 end
    return done and result or false,done and body or"timeout"
end

-- HWID
local function getHWID()
    local parts={}
    local function push(tag,fn) local v=try(fn,"");if v~="" then parts[#parts+1]=tag..v end end
    push("A:",function() return game:GetService("RbxAnalyticsService"):GetClientId() end)
    push("U:",function() return tostring(PL.UserId) end)
    push("G:",function()
        local i=game:GetService("GuiService"):GetGuiInset()
        return tostring(_r_floor(i.X+0.5)).."x"..tostring(_r_floor(i.Y+0.5))
    end)
    local s4=try(function()
        local id=""
        if identifyexecutor then id=tostring(identifyexecutor()) end
        if id==""and typeof(syn)=="table" then id="synapse" end
        if id==""and typeof(fluxus)=="table" then id="fluxus" end
        return id~=""and "E:"..id or nil
    end,nil)
    if s4 then parts[#parts+1]=s4 end
    push("AG:",function() return tostring(PL.AccountAge) end)
    local s6=try(function()
        local ms=game:GetService("MemStorageService")
        local stored=ms:GetItem("_sw_seed")
        if not stored or stored==""then stored=tostring(math.random(0x10000,0xFFFFFF));ms:SetItem("_sw_seed",stored) end
        return "M:"..stored
    end,"")
    if s6~=""then parts[#parts+1]=s6 end
    if #parts==0 then return"UNKNOWN" end
    local combined=table.concat(parts,"|")
    local h=5381
    for i=1,#combined do h=((h*33)+combined:byte(i))%0x100000000 end
    return combined.."#"..string.format("%08X",h)
end

local function fmtTime(s)
    if s>=86400 then return _r_floor(s/86400).."d ".._r_floor((s%86400)/3600).."h ".._r_floor((s%3600)/60).."m"
    elseif s>=3600 then return _r_floor(s/3600).."h ".._r_floor((s%3600)/60).."m"
    else return _r_floor(s/60).."m ".._r_floor(s%60).."s" end
end
local function maskKey(k) local s=tostring(k or"");if #s<=8 then return string.rep("*",#s) end;return s:sub(1,4)..string.rep("*",#s-8)..s:sub(-4) end

