-- SpectreWare Loader
local API_BASE = "http://fi10.bot-hosting.net:20745"
local SCRIPTS  = {
    [17766863403]     = "https://raw.githubusercontent.com/Captaineieiei/Script-/refs/heads/main/Beady",
    [139434492338574] = "https://raw.githubusercontent.com/Captaineieiei/Script-/refs/heads/main/Never",
}

-- ── Key / HWID ────────────────────────────────────────────────────────────────
local KEY  = getgenv().SW_KEY or error("[SpectreWare] ใส่ key ก่อน: getgenv().SW_KEY = 'YOUR-KEY'")
local HWID = getgenv().SW_HWID
    or (syn and syn.request and tostring(syn.request({Url="https://api64.ipify.org",Method="GET"}).Body))
    or game:GetService("RbxAnalyticsService"):GetClientId()

local MAX_RETRIES = 3
local RETRY_DELAY = 2
local HS          = game:GetService("HttpService")
local Players     = game:GetService("Players")

-- ── Verify with retry ─────────────────────────────────────────────────────────
local verified   = false
local apiOffline = false

for attempt = 1, MAX_RETRIES do
    local ok, res = pcall(game.HttpGetAsync, game, API_BASE .. "/check?key=" .. KEY .. "&hwid=" .. HWID)

    if ok and res then
        local data
        local parsed = pcall(function() data = HS:JSONDecode(res) end)
        if not parsed then break end
        if data and data.success then
            verified = true
            break
        else
            error("[SpectreWare] " .. (data and data.message or "Unauthorized"))
        end
    else
        warn(string.format("[SpectreWare] API ไม่ตอบสนอง (attempt %d/%d)", attempt, MAX_RETRIES))
        if attempt < MAX_RETRIES then task.wait(RETRY_DELAY) else apiOffline = true end
    end
end

-- ── Offline = Kick ────────────────────────────────────────────────────────────
if not verified then
    if apiOffline then
        warn("[SpectreWare] ⚠️ API offline — กำลัง kick...")
        task.wait(1)
        Players.LocalPlayer:Kick("\n[SpectreWare]\nระบบ API ขัดข้อง กรุณาลองใหม่ภายหลัง")
    else
        error("[SpectreWare] ยืนยัน key ไม่ผ่าน")
    end
    return
end

-- ── Announce UI ───────────────────────────────────────────────────────────────
local function showAnnounce(title, message)
    local player    = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")

    -- ลบอันเก่าทิ้งก่อน
    local old = playerGui:FindFirstChild("SW_Announce")
    if old then old:Destroy() end

    local sg = Instance.new("ScreenGui")
    sg.Name            = "SW_Announce"
    sg.ResetOnSpawn    = false
    sg.ZIndexBehavior  = Enum.ZIndexBehavior.Sibling
    sg.Parent          = playerGui

    -- backdrop
    local backdrop = Instance.new("Frame")
    backdrop.Size            = UDim2.new(1, 0, 1, 0)
    backdrop.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    backdrop.BackgroundTransparency = 0.5
    backdrop.BorderSizePixel = 0
    backdrop.Parent          = sg

    -- card
    local card = Instance.new("Frame")
    card.Size              = UDim2.new(0, 480, 0, 160)
    card.Position          = UDim2.new(0.5, -240, 0.5, -80)
    card.BackgroundColor3  = Color3.fromRGB(10, 10, 20)
    card.BorderSizePixel   = 0
    card.Parent            = sg

    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 12)

    -- เส้นขอบ cyan
    local stroke = Instance.new("UIStroke")
    stroke.Color     = Color3.fromRGB(0, 210, 255)
    stroke.Thickness = 1.5
    stroke.Parent    = card

    -- หัวข้อ
    local lbTitle = Instance.new("TextLabel")
    lbTitle.Size                  = UDim2.new(1, -24, 0, 36)
    lbTitle.Position              = UDim2.new(0, 12, 0, 10)
    lbTitle.BackgroundTransparency = 1
    lbTitle.Text                  = "📢  " .. (title ~= "" and title or "SpectreWare")
    lbTitle.TextColor3            = Color3.fromRGB(0, 210, 255)
    lbTitle.Font                  = Enum.Font.GothamBold
    lbTitle.TextSize              = 16
    lbTitle.TextXAlignment        = Enum.TextXAlignment.Left
    lbTitle.Parent                = card

    -- เส้นคั่น
    local div = Instance.new("Frame")
    div.Size                 = UDim2.new(1, -24, 0, 1)
    div.Position             = UDim2.new(0, 12, 0, 50)
    div.BackgroundColor3     = Color3.fromRGB(0, 210, 255)
    div.BackgroundTransparency = 0.7
    div.BorderSizePixel      = 0
    div.Parent               = card

    -- ข้อความ
    local lbMsg = Instance.new("TextLabel")
    lbMsg.Size                  = UDim2.new(1, -24, 0, 80)
    lbMsg.Position              = UDim2.new(0, 12, 0, 60)
    lbMsg.BackgroundTransparency = 1
    lbMsg.Text                  = message or ""
    lbMsg.TextColor3            = Color3.fromRGB(220, 220, 220)
    lbMsg.Font                  = Enum.Font.Gotham
    lbMsg.TextSize              = 14
    lbMsg.TextXAlignment        = Enum.TextXAlignment.Left
    lbMsg.TextYAlignment        = Enum.TextYAlignment.Top
    lbMsg.TextWrapped           = true
    lbMsg.Parent                = card

    -- fade in
    card.BackgroundTransparency = 1
    for i = 1, 10 do
        card.BackgroundTransparency = 1 - (i / 10) * 0.05
        task.wait(0.02)
    end

    -- ปิดเองใน 8 วินาที
    task.delay(8, function()
        for i = 1, 20 do
            card.BackgroundTransparency = i / 20
            task.wait(0.03)
        end
        sg:Destroy()
    end)
end

-- ── Long-poll announce loop ───────────────────────────────────────────────────
local announceSeq = 0

task.spawn(function()
    while task.wait(1) do
        local ok, res = pcall(
            game.HttpGetAsync, game,
            API_BASE .. "/announce?key=" .. KEY .. "&seq=" .. announceSeq
        )
        if ok and res then
            local data
            pcall(function() data = HS:JSONDecode(res) end)
            if data and data.id and data.id ~= "" and data.seq and data.seq ~= announceSeq then
                announceSeq = data.seq
                showAnnounce(data.title or "", data.message or "")
            elseif data and data.seq then
                announceSeq = data.seq
            end
        end
    end
end)

-- ── โหลดสคริปตามแมพ ──────────────────────────────────────────────────────────
local url = SCRIPTS[game.PlaceId]

if url then
    print("[SpectreWare] ✓ Key OK | โหลด: " .. url)
    loadstring(game:HttpGet(url, true))()
else
    warn("[SpectreWare] ไม่มีสคริปสำหรับแมพนี้ | PlaceId: " .. tostring(game.PlaceId))
end
