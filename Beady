function updateSelection()
    for i, r in pairs(cardRefs) do
        if i == selectedIndex then
            Tween(r.Card,    {BackgroundColor3=Color3.fromRGB(58, 28, 35)},      0.2)   -- Selected Choc-Pink
            Tween(r.Stroke,  {Color=r.Color, Thickness=2},                        0.2)
            Tween(r.GlowBar, {BackgroundColor3=r.Color},                          0.2)
            Tween(r.Dot,     {BackgroundTransparency=0},                          0.2)
            Tween(r.IconBg,  {BackgroundColor3=Color3.fromRGB(35,18,18)},         0.2)
            Tween(r.IStroke, {Color=r.Color},                                     0.2)
        else
            Tween(r.Card,    {BackgroundColor3=Color3.fromRGB(42, 22, 26)},       0.2)
            Tween(r.Stroke,  {Color=Color3.fromRGB(90, 50, 55), Thickness=1.5},   0.2)
            Tween(r.GlowBar, {BackgroundColor3=Color3.fromRGB(110, 60, 55)},      0.2)
            Tween(r.Dot,     {BackgroundTransparency=1},                           0.2)
            Tween(r.IconBg,  {BackgroundColor3=Color3.fromRGB(35,18,18)},          0.2)
            Tween(r.IStroke, {Color=Color3.fromRGB(90, 50, 55)},                   0.2)
        end
    end
    StatusDot.BackgroundColor3 = Scripts[selectedIndex].Color
    StatusTxt.Text = "เลือก:  " .. Scripts[selectedIndex].Name
end

