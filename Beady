    { x=0.80, y=0.70, size=120, color=Color3.fromRGB(200, 100, 150),  speed=0.9, amp=0.06 },  -- Rose Pink
}

for _, bd in ipairs(blobData) do
    local blob = Instance.new("Frame")
    blob.Size = UDim2.new(0, bd.size, 0, bd.size)
    blob.Position = UDim2.new(bd.x, -bd.size/2, bd.y, -bd.size/2)
    blob.BackgroundColor3 = bd.color
    blob.BackgroundTransparency = 0.72
    blob.BorderSizePixel = 0
    blob.ZIndex = 1
    blob.Parent = Main
    Corner(blob, bd.size)

    local blur = Instance.new("Frame")
    blur.Size = UDim2.new(0, bd.size+40, 0, bd.size+40)
    blur.Position = UDim2.new(0, -20, 0, -20)
    blur.BackgroundColor3 = bd.color
    blur.BackgroundTransparency = 0.88
    blur.BorderSizePixel = 0
    blur.ZIndex = 1
    blur.Parent = blob
    Corner(blur, bd.size+40)

    local baseX = bd.x
    local baseY = bd.y
    local offset = math.random() * math.pi * 2
    task.spawn(function()
        while blob.Parent do
            local t = tick() * bd.speed + offset
            local nx = baseX + math.sin(t) * bd.amp
            local ny = baseY + math.cos(t * 0.7) * bd.amp
            blob.Position = UDim2.new(nx, -bd.size/2, ny, -bd.size/2)
            task.wait(0.1)
        end
    end)
end

