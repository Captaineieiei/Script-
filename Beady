-- ══════════════════════════════
--  🚀 MASTER HEARTBEAT LOOP
--  [FIX] รวม blob + particle อนิเมชัน ไว้ใน 1 connection แทน 12 loops
-- ══════════════════════════════
local masterConn
masterConn = RunService.Heartbeat:Connect(function()
    if not Main.Parent then
        masterConn:Disconnect()
        return
    end
    local t = tick()

    -- Blob animation
    for _, bd in ipairs(blobObjects) do
        if bd.frame.Parent then
            local tS = t * bd.speed + bd.offset
            local nx  = bd.baseX + math.sin(tS) * bd.amp
            local ny  = bd.baseY + math.cos(tS * 0.7) * bd.amp
            bd.frame.Position = UDim2.new(nx, -bd.size/2, ny, -bd.size/2)
        end
    end

    -- Particle animation
    for _, p in ipairs(Particles) do
        if p.label.Parent then
            local tS = t * 0.7 + p.offset
            p.label.Position         = UDim2.new(p.xScale, 0, p.yScale + math.sin(tS)*0.015, math.sin(tS)*5)
            p.label.TextTransparency = 0.25 + math.abs(math.sin(tS*0.5)) * 0.45
        end
    end
end)

