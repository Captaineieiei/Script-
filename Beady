-- Helpers
local function Tween(obj,props,t,style,dir) TweenService:Create(obj,TweenInfo.new(t or .25,style or Enum.EasingStyle.Quad,dir or Enum.EasingDirection.Out),props):Play() end
local function Corner(p,r) local c=Instance.new("UICorner") c.CornerRadius=UDim.new(0,r or 8) c.Parent=p return c end
local function Stroke(p,col,th) local s=Instance.new("UIStroke") s.Color=col or Color3.fromRGB(80,50,45) s.Thickness=th or 1.5 s.Parent=p return s end
local function Grad(p,c0,c1,rot) local g=Instance.new("UIGradient") g.Color=ColorSequence.new(c0,c1) g.Rotation=rot or 90 g.Parent=p return g end
local function Label(p,txt,sz,font,col,ax,z)
    local l=Instance.new("TextLabel") l.BackgroundTransparency=1 l.Text=txt l.TextSize=sz or 13
    l.Font=font or Enum.Font.Gotham l.TextColor3=col or Color3.fromRGB(255,255,255)
    l.TextXAlignment=ax or Enum.TextXAlignment.Left l.ZIndex=z or 2 l.Parent=p return l
end
local function MkFrame(p,sz,pos,bg,bgt,z,clip)
    local f=Instance.new("Frame") f.Size=sz f.Position=pos f.BackgroundColor3=bg or Color3.fromRGB(28,14,18)
    f.BackgroundTransparency=bgt or 0 f.BorderSizePixel=0 f.ZIndex=z or 1
    if clip then f.ClipsDescendants=true end f.Parent=p return f
end
local function MkImage(p,img,sz,pos,z)
    local i=Instance.new("ImageLabel") i.BackgroundTransparency=1 i.Image=img
    i.Size=sz or UDim2.new(1,0,1,0) i.Position=pos or UDim2.new(0,0,0,0)
    i.ScaleType=Enum.ScaleType.Fit i.ZIndex=z or 2 i.Parent=p return i
end

