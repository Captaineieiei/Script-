UserInputService.InputChanged:Connect(function(i)
    if i.UserInputType~=Enum.UserInputType.MouseMovement and i.UserInputType~=Enum.UserInputType.Touch then return end
    if dragging then
        local d=i.Position-dragStart
        Main.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+d.X,startPos.Y.Scale,startPos.Y.Offset+d.Y)
    end
    if fDragging then
        local d=Vector2.new(i.Position.X,i.Position.Y)-fDragStart fLastPos=Vector2.new(i.Position.X,i.Position.Y)
        if math.abs(d.X)>DRAG_THRESHOLD or math.abs(d.Y)>DRAG_THRESHOLD then fDidDrag=true end
        if fDidDrag then applyFloatPos(fStartAbsPos.X+d.X,fStartAbsPos.Y+d.Y) end
    end
end)

UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType~=Enum.UserInputType.MouseButton1 and i.UserInputType~=Enum.UserInputType.Touch then return end
    if dragging then dragging=false savedMainPos=Main.Position ContextActionService:UnbindAction("_SinkMainDrag") end
    if fDragging then
        Tween(FloatIcon,{Size=UDim2.new(0,64,0,64)},.15,Enum.EasingStyle.Back) Tween(FloatBase,{BackgroundTransparency=0},.12)
        if fDragStart and fLastPos then
            local d=fLastPos-fDragStart
            if math.abs(d.X)>DRAG_THRESHOLD or math.abs(d.Y)>DRAG_THRESHOLD then fDidDrag=true end
        end
        if not fDidDrag then minimized=false showMain() else savedMainPos=FloatIcon.Position end
        fDragging=false fDidDrag=false fLastPos=nil ContextActionService:UnbindAction("_SinkFloatDrag")
    end
end)

MinBtn.Activated:Connect(function() minimized=not minimized if minimized then showMinimized() else showMain() end end)
CloseBtn.Activated:Connect(function() masterConn:Disconnect() Tween(Main,{BackgroundTransparency=1},.25) task.wait(.3) SG:Destroy() end)

RunBtn.MouseButton1Click:Connect(function()
    Tween(RunBtn,{BackgroundColor3=Color3.fromRGB(170,60,105)},.08) task.wait(.08)
    Tween(RunBtn,{BackgroundColor3=Color3.fromRGB(220,90,140)},.2)
    RunTxtL.Text="RUNNING..." RunIconL.Text="⟳"
    StatusTxt.Text="กำลังรัน:  "..Scripts[selectedIndex].Name
    StatusDot.BackgroundColor3=Color3.fromRGB(120,255,170)
    task.spawn(function()
        local ok,err=pcall(Scripts[selectedIndex].Code) task.wait(.5)
        if ok then
            RunTxtL.Text="✓  สำเร็จ!" RunIconL.Text="" StatusTxt.Text="สำเร็จ:  "..Scripts[selectedIndex].Name
            StatusDot.BackgroundColor3=Color3.fromRGB(120,255,170)
        else
            RunTxtL.Text="✕  ERROR" RunIconL.Text="" StatusDot.BackgroundColor3=Color3.fromRGB(255,80,100)
            StatusTxt.Text="Error: "..tostring(err):sub(1,40)
        end
        task.wait(1.8) RunTxtL.Text="EXECUTE SCRIPT" RunIconL.Text="▶"
        StatusDot.BackgroundColor3=Scripts[selectedIndex].Color
        StatusTxt.Text="เลือก:  "..Scripts[selectedIndex].Name
    end)
end)
RunBtn.MouseEnter:Connect(function() Tween(RunBtn,{BackgroundColor3=Color3.fromRGB(245,120,165)},.15) end)
RunBtn.MouseLeave:Connect(function() Tween(RunBtn,{BackgroundColor3=Color3.fromRGB(220,90,140)},.2) end)
