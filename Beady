        if i == selectedIndex then
            Tween(r.Card,    {BackgroundColor3=Color3.fromRGB(40,22,58)},      0.2)
            Tween(r.Stroke,  {Color=r.Color, Thickness=2},                     0.2)
            Tween(r.GlowBar, {BackgroundColor3=r.Color},                       0.2)
            Tween(r.Dot,     {BackgroundTransparency=0},                       0.2)
            Tween(r.IconBg,  {BackgroundColor3=Color3.fromRGB(14,10,22)},      0.2)
            Tween(r.IStroke, {Color=r.Color},                                  0.2)
        else
            Tween(r.Card,    {BackgroundColor3=Color3.fromRGB(28,18,42)},      0.2)
            Tween(r.Stroke,  {Color=Color3.fromRGB(70,45,90), Thickness=1.5},  0.2)
            Tween(r.GlowBar, {BackgroundColor3=Color3.fromRGB(80,55,100)},     0.2)
