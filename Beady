local minimized = false
local savedMainPos = UDim2.new(0.5, -155, 0.5, -190)  -- เก็บตำแหน่งล่าสุดของ Main

local function showMinimized()
    savedMainPos = Main.Position

    local abs      = Main.AbsolutePosition
    local floatPos = UDim2.new(0, abs.X, 0, abs.Y)

    -- เตรียม FloatIcon ให้พร้อม (ซ่อนอยู่ ณ ตำแหน่งเดียวกับ Main)
    FloatIcon.Size     = UDim2.new(0, 64, 0, 64)
    FloatIcon.Position = floatPos
    FloatIcon.Visible  = true
    FloatBase.BackgroundTransparency  = 1
    FloatRing.BackgroundTransparency  = 1
    FloatRing.Size     = UDim2.new(1, 16, 1, 16)
    FloatRing.Position = UDim2.new(0, -8, 0, -8)
    FloatRing2.BackgroundTransparency = 1
    FloatLogo.ImageTransparency       = 1

    -- ย่อ Main ให้เหลือ 64x64 โดยยัง opaque → ดูเหมือน pill หดตัว ไม่มี flash
    Main.BackgroundTransparency = 0
    Tween(Main, {
        Size     = UDim2.new(0, 64, 0, 64),
        Position = floatPos,
    }, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In)

    -- พอ Main หดเสร็จ → ซ่อน Main แล้ว fade in FloatIcon
    task.delay(0.28, function()
        Main.Visible = false
        Main.BackgroundTransparency = 0
        Tween(FloatBase,  {BackgroundTransparency = 0},   0.25, Enum.EasingStyle.Quad)
        Tween(FloatRing,  {BackgroundTransparency = 0.5}, 0.25, Enum.EasingStyle.Quad)
        Tween(FloatRing2, {BackgroundTransparency = 0.6}, 0.25, Enum.EasingStyle.Quad)
        Tween(FloatLogo,  {ImageTransparency = 0},        0.2,  Enum.EasingStyle.Quad)
    end)
end

local function showMain()
    -- fade out FloatIcon ก่อน
    Tween(FloatBase,  {BackgroundTransparency = 1}, 0.15, Enum.EasingStyle.Quad)
    Tween(FloatRing,  {BackgroundTransparency = 1}, 0.15)
    Tween(FloatRing2, {BackgroundTransparency = 1}, 0.15)
    Tween(FloatLogo,  {ImageTransparency = 1},      0.15)

    task.delay(0.15, function()
        FloatIcon.Visible = false

        -- snap Main ให้อยู่ที่ตำแหน่ง FloatIcon, ขนาด 64x64, opaque
        Main.Size                   = UDim2.new(0, 64, 0, 64)
        Main.Position               = FloatIcon.Position
        Main.BackgroundTransparency = 0
        Main.Visible                = true

        -- ขยาย Main กลับตำแหน่งเดิม
        Tween(Main, {
            Size     = UDim2.new(0, 310, 0, 360),
            Position = savedMainPos,
        }, 0.35, Enum.EasingStyle.Back)
    end)
end

-- ══════════════════════════════
--  FLOAT ICON: drag + tap (PC & Mobile)
-- ══════════════════════════════
local fDragging = false
local fDidDrag  = false
local fDragStart, fStartPos
local DRAG_THRESHOLD = 10

FloatBtn.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
    or i.UserInputType == Enum.UserInputType.Touch then
        fDragging  = true
        fDidDrag   = false
        fDragStart = i.Position
        fStartPos  = FloatIcon.Position
        Tween(FloatIcon, {Size=UDim2.new(0,56,0,56)}, 0.08)
        Tween(FloatBase, {BackgroundTransparency=0.25}, 0.08)
    end
end)

-- ใช้ UserInputService แทน FloatBtn.InputChanged → รองรับ mobile ทุก device
UserInputService.InputChanged:Connect(function(i)
    if not fDragging then return end
    if i.UserInputType == Enum.UserInputType.MouseMovement
    or i.UserInputType == Enum.UserInputType.Touch then
        local delta = i.Position - fDragStart
        if math.abs(delta.X) > DRAG_THRESHOLD or math.abs(delta.Y) > DRAG_THRESHOLD then
            fDidDrag = true
        end
        if fDidDrag then
            FloatIcon.Position = UDim2.new(
                fStartPos.X.Scale, fStartPos.X.Offset + delta.X,
                fStartPos.Y.Scale, fStartPos.Y.Offset + delta.Y
            )
        end
    end
end)

UserInputService.InputEnded:Connect(function(i)
    if not fDragging then return end
    if i.UserInputType == Enum.UserInputType.MouseButton1
    or i.UserInputType == Enum.UserInputType.Touch then
        Tween(FloatIcon, {Size=UDim2.new(0,64,0,64)}, 0.15, Enum.EasingStyle.Back)
        Tween(FloatBase, {BackgroundTransparency=0},   0.12)
        if not fDidDrag then
            -- TAP → เปิด UI
            minimized = false
            showMain()
        else
            -- ลากแล้ว → บันทึกตำแหน่งใหม่ให้ showMain() restore ถูกที่
            savedMainPos = FloatIcon.Position
        end
        fDragging = false
        fDidDrag  = false
    end
end)

