local TeleportSection = Tabs.Teleport:Section({ Title = "Teleport", Opened = true })

local teleportLocations = {
    ["🍇 Grape Farm"]  = CFrame.new(5342, 477, 2770),
    ["🥕 Carrot Farm"] = CFrame.new(6547, 452, 2780),
    ["🌾 Wheat Farm"]  = CFrame.new(7964, 312, 2380),
}

local selectedTeleportLocation = nil

TeleportSection:Dropdown({
    Flag   = "SelectTeleport",
    Title  = "Select Location",
    Desc   = "เลือก Location ที่จะ Teleport ไป",
    Values = {
        "🍇 Grape Farm",
        "🥕 Carrot Farm",
        "🌾 Wheat Farm",
    },
    Callback = function(v)
        selectedTeleportLocation = v
    end,
})

TeleportSection:Button({
    Title    = "⚡ Teleport Now",
    Desc     = "Teleport ไปยัง Location ที่เลือก (พร้อมรถ)",
    Icon     = "zap",
    Callback = function()
        if not selectedTeleportLocation then
            WindUI:Notify({ Title = "SpectreWare", Content = "❌ กรุณาเลือก Location ก่อน!", Duration = 3 })
            return
        end

        local char = Players.LocalPlayer.Character
        if not char or not char:FindFirstChild("Humanoid") then
            WindUI:Notify({ Title = "SpectreWare", Content = "❌ Character ไม่พร้อม", Duration = 3 })
            return
        end

        local targetCF = teleportLocations[selectedTeleportLocation]
        if not targetCF then return end

        local humanoid = char.Humanoid
        local seat = humanoid.SeatPart

        -- วาปพร้อมรถถ้านั่งอยู่
        if seat and seat:IsA("VehicleSeat") then
            local vehicle = seat:FindFirstAncestorOfClass("Model")
            if vehicle then
                vehicle:PivotTo(targetCF)
                WindUI:Notify({ Title = "SpectreWare", Content = "✅ Teleported (พร้อมรถ) → " .. selectedTeleportLocation, Duration = 2.5 })
                return
            end
        end

        -- ไม่มีรถ วาปแค่ตัวละคร
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = targetCF
            WindUI:Notify({ Title = "SpectreWare", Content = "✅ Teleported → " .. selectedTeleportLocation, Duration = 2.5 })
        end
    end,
})



