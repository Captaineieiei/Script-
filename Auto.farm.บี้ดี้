-- ดึงจำนวน item จาก Inventory1.5 GUI (ใช้ Attribute "value")
local function getItemCount(itemName)
    local ok, result = pcall(function()
        local scrolling = Players.LocalPlayer
            .PlayerGui["Inventory1.5"]
            .Frame.Main.ScrollingFrame.Scrolling

        local slot = scrolling:FindFirstChild(itemName)
        if slot then
            return slot:GetAttribute("value") or 0
        end
        return 0
    end)
    return (ok and type(result) == "number" and result) or 0
end

local function getTruck()
    local plr  = Players.LocalPlayer
    local char = plr.Character
    return workspace:FindFirstChild(selectedTruck)
        or (plr.Backpack and plr.Backpack:FindFirstChild(selectedTruck))
        or (char and char:FindFirstChild(selectedTruck))
        or plr:FindFirstChild(selectedTruck)
end

