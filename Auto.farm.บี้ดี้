-- 3. Auto Farm Toggle
local AutoFarmToggle
AutoFarmToggle = FarmSection:Toggle({
    Flag     = "AutoFarm",
    Title    = "Auto Farm (Start / Stop)",
    Desc     = "Beady City Safe Mode",
    Icon     = "wrench",
    Default  = false,
    Callback = function(Value)
        _G.LoopActive = Value

        if Value then
            if not selectedFarmItem or not selectedTruck then
                WindUI:Notify({
                    Title    = "SpectreWare",
                    Content  = "❌ Please select an item and truck before starting farm!",
                    Duration = 3.3,
                })
                _G.LoopActive = false
                AutoFarmToggle:Set(false)
                return
            end

            task.spawn(function()
                local remote = ReplicatedStorage:FindFirstChild("Remote", true)
                if remote then remote = remote:FindFirstChild("data") end

                if not remote then
                    WindUI:Notify({ Title = "ERROR", Content = "Remote not found!", Duration = 10 })
                    _G.LoopActive = false
                    AutoFarmToggle:Set(false)
                    return
                end

                WindUI:Notify({ Title = "SpectreWare", Content = "👀 กำลังรอของครบ 30...", Duration = 3.3 })

                local isFiring = false -- กัน fire ซ้ำ

                local function tryDeliver()
                    if isFiring or not _G.LoopActive then return end

                    local char = Players.LocalPlayer.Character
                    if not char or not char:FindFirstChild("Humanoid") then return end

                    local itemCount = getItemCount(selectedFarmItem)
                    if itemCount < 30 then return end

                    isFiring = true
                    local truck = getTruck()
                    if truck then
                        pcall(function()
                            remote:FireServer("post", selectedFarmItem, itemCount, truck)
                        end)
                        WindUI:Notify({ Title = "SpectreWare", Content = "✅ ของครบ " .. itemCount .. " → ส่งแล้ว!", Duration = 2 })
                    else
                        WindUI:Notify({ Title = "SpectreWare", Content = "❌ ไม่พบรถ: " .. selectedTruck, Duration = 3.3 })
                    end
                    task.wait(1.5)
                    isFiring = false
                end

                -- ฟังก์ชัน hook event ที่ slot
                local eventConn = nil
                local function hookSlot()
                    if eventConn then eventConn:Disconnect() end
                    local ok, slot = pcall(function()
                        return Players.LocalPlayer
                            .PlayerGui["Inventory1.5"]
                            .Frame.Main.ScrollingFrame.Scrolling
                            :FindFirstChild(selectedFarmItem)
                    end)
                    if ok and slot then
                        -- เช็คทันทีก่อนเลย (กรณีของครบก่อน toggle)
                        tryDeliver()
                        -- แล้ว listen เมื่อ value เปลี่ยน
                        eventConn = slot:GetAttributeChangedSignal("value"):Connect(tryDeliver)
                    end
                end

                hookSlot()

                -- fallback: ถ้า slot ยังไม่มีตอน hook → คอย ChildAdded แล้ว hook ใหม่
                local scrolling
                pcall(function()
                    scrolling = Players.LocalPlayer
                        .PlayerGui["Inventory1.5"]
                        .Frame.Main.ScrollingFrame.Scrolling
                end)
                local addedConn = scrolling and scrolling.ChildAdded:Connect(function(child)
                    if child.Name == selectedFarmItem then
                        hookSlot()
                    end
                end)

                -- รอจนกว่าจะ toggle ปิด
                while _G.LoopActive do
                    task.wait(0.5)
                end

                -- cleanup
                if eventConn then eventConn:Disconnect() end
                if addedConn  then addedConn:Disconnect()  end

                WindUI:Notify({ Title = "SpectreWare", Content = "🛑 System stopped", Duration = 3.3 })
            end)
        end
    end,
})

