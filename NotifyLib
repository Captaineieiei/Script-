-- NotifyLib v2 _by SpectreWare (compact)
local TS, Players = game:GetService("TweenService"), game:GetService("Players")
local PGui = Players.LocalPlayer:WaitForChild("PlayerGui")

local SGui = Instance.new("ScreenGui")
SGui.Name, SGui.ResetOnSpawn, SGui.ZIndexBehavior = "NotifyLib_v2", false, Enum.ZIndexBehavior.Sibling
SGui.DisplayOrder, SGui.IgnoreGuiInset = 9999, true
if not pcall(function() SGui.Parent = game:GetService("CoreGui") end) then SGui.Parent = PGui end

local Container = Instance.new("Frame")
Container.Name, Container.BackgroundTransparency = "NotifyContainer", 1
Container.Size, Container.Position = UDim2.new(0, 292, 1, -20), UDim2.new(1, -304, 0, 10)
Container.Parent = SGui

local Layout = Instance.new("UIListLayout")
Layout.SortOrder, Layout.Padding = Enum.SortOrder.LayoutOrder, UDim.new(0, 7)
Layout.VerticalAlignment, Layout.HorizontalAlignment = Enum.VerticalAlignment.Top, Enum.HorizontalAlignment.Center
Layout.Parent = Container

local CARD_H, MAX = 74, 5
local ACCENT = { success=Color3.fromRGB(46,213,115), error=Color3.fromRGB(255,71,87), warning=Color3.fromRGB(255,171,0), info=Color3.fromRGB(85,150,255) }
local ICON   = { success="✓", error="✕", warning="!", info="i" }

local function mkCorner(r, p) local c = Instance.new("UICorner") c.CornerRadius = UDim.new(0,r) c.Parent = p end
local function mkFrame(props, parent)
	local f = Instance.new("Frame")
	for k,v in pairs(props) do f[k] = v end
	f.Parent = parent return f
end
local function mkLabel(props, parent)
	local l = Instance.new("TextLabel")
	for k,v in pairs(props) do l[k] = v end
	l.Parent = parent return l
end

local NotifyLib, active, order = {}, {}, 0

function NotifyLib:Send(title, message, nType, duration)
	nType    = (nType or "info"):lower()
	duration = math.clamp(tonumber(duration) or 5, 1, 30)
	local col, ico = ACCENT[nType] or ACCENT.info, ICON[nType] or "i"

	if #active >= MAX then
		local old = table.remove(active, 1)
		if old and old.wrapper and old.wrapper.Parent then old.wrapper:Destroy() end
	end

	order += 1
	local Wrapper = mkFrame({ Name="NW_"..order, Size=UDim2.new(1,0,0,CARD_H), BackgroundTransparency=1, BorderSizePixel=0, ClipsDescendants=true, LayoutOrder=order }, Container)
	local Card    = mkFrame({ Size=UDim2.new(1,0,1,0), Position=UDim2.new(1,10,0,0), BackgroundColor3=Color3.fromRGB(16,16,24), BorderSizePixel=0 }, Wrapper)
	mkCorner(10, Card)

	local s = Instance.new("UIStroke") s.Color, s.Thickness, s.Transparency, s.Parent = Color3.fromRGB(55,55,80), 1, 0.4, Card

	mkCorner(4, mkFrame({ Size=UDim2.new(0,3,0.6,0), Position=UDim2.new(0,0,0.2,0), BackgroundColor3=col, BorderSizePixel=0, ZIndex=3 }, Card))

	local IconBg = mkFrame({ Size=UDim2.new(0,36,0,36), Position=UDim2.new(0,14,0.5,-18), BackgroundColor3=col, BackgroundTransparency=0.78, BorderSizePixel=0, ZIndex=3 }, Card)
	mkCorner(18, IconBg)
	local is = Instance.new("UIStroke") is.Color, is.Thickness, is.Transparency, is.Parent = col, 1.2, 0.5, IconBg
	mkLabel({ Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, Text=ico, TextColor3=col, TextSize=16, Font=Enum.Font.GothamBold, TextXAlignment=Enum.TextXAlignment.Center, TextYAlignment=Enum.TextYAlignment.Center, ZIndex=4 }, IconBg)

	mkLabel({ Size=UDim2.new(1,-66,0,22), Position=UDim2.new(0,60,0,12), BackgroundTransparency=1, Text=tostring(title), TextColor3=Color3.fromRGB(245,245,255), TextSize=13, Font=Enum.Font.GothamBold, TextXAlignment=Enum.TextXAlignment.Left, TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=3 }, Card)
	mkLabel({ Size=UDim2.new(1,-66,0,18), Position=UDim2.new(0,60,0,36), BackgroundTransparency=1, Text=tostring(message), TextColor3=Color3.fromRGB(145,145,172), TextSize=11, Font=Enum.Font.Gotham, TextXAlignment=Enum.TextXAlignment.Left, TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=3 }, Card)

	local ProgBG = mkFrame({ Size=UDim2.new(1,-16,0,2), Position=UDim2.new(0,8,1,-5), BackgroundColor3=Color3.fromRGB(35,35,52), BorderSizePixel=0, ZIndex=3 }, Card) mkCorner(2, ProgBG)
	local ProgFill = mkFrame({ Size=UDim2.new(1,0,1,0), BackgroundColor3=col, BorderSizePixel=0, ZIndex=4 }, ProgBG) mkCorner(2, ProgFill)

	local tweens, dismissed = {}, false
	local function cancelTweens() for _,t in ipairs(tweens) do pcall(t.Cancel,t) end table.clear(tweens) end

	local function removeCard()
		if dismissed then return end dismissed = true cancelTweens()
		if not (Wrapper and Wrapper.Parent) then return end
		local t = TS:Create(Card, TweenInfo.new(0.28,Enum.EasingStyle.Quint,Enum.EasingDirection.In), { Position=UDim2.new(1,10,0,0) })
		table.insert(tweens,t) t:Play()
		task.delay(0.29, function() if Wrapper and Wrapper.Parent then Wrapper:Destroy() end end)
		for i,v in ipairs(active) do if v.wrapper==Wrapper then table.remove(active,i) break end end
	end

	local tin = TS:Create(Card, TweenInfo.new(0.42,Enum.EasingStyle.Quint,Enum.EasingDirection.Out), { Position=UDim2.new(0,0,0,0) })
	table.insert(tweens,tin) tin:Play()

	task.delay(0.42, function()
		if dismissed then return end
		local tp = TS:Create(ProgFill, TweenInfo.new(duration,Enum.EasingStyle.Linear), { Size=UDim2.new(0,0,1,0) })
		table.insert(tweens,tp) tp:Play()
	end)

	task.delay(0.42+duration, removeCard)
	table.insert(active, { wrapper=Wrapper, tweens=tweens })
	return removeCard
end

function NotifyLib:Success(t,m,d) return self:Send(t,m,"success",d) end
function NotifyLib:Error(t,m,d)   return self:Send(t,m,"error",d)   end
function NotifyLib:Warning(t,m,d) return self:Send(t,m,"warning",d) end
function NotifyLib:Info(t,m,d)    return self:Send(t,m,"info",d)    end
function NotifyLib:ClearAll()
	for _,v in ipairs(active) do if v.wrapper and v.wrapper.Parent then v.wrapper:Destroy() end end
	table.clear(active)
end

return by
