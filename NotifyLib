-- NotifyLib v2 by SpectreWare
local TS   = game:GetService("TweenService")
local PGui = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
local Icons = loadstring(game:HttpGet("https://raw.githubusercontent.com/Captaineieiei/Script-/refs/heads/main/icons"))()

local function new(cls, props, parent)
	local i = Instance.new(cls)
	for k,v in pairs(props) do i[k]=v end
	i.Parent = parent; return i
end
local function corner(r,p) new("UICorner",{CornerRadius=UDim.new(0,r)},p) end

local SGui = new("ScreenGui",{Name="NotifyLib_v2",ResetOnSpawn=false,ZIndexBehavior=Enum.ZIndexBehavior.Sibling,DisplayOrder=9999,IgnoreGuiInset=true},nil)
if not pcall(function() SGui.Parent=game:GetService("CoreGui") end) then SGui.Parent=PGui end

local Container = new("Frame",{Name="NotifyContainer",BackgroundTransparency=1,Size=UDim2.new(0,292,1,-20),Position=UDim2.new(1,-304,0,10)},SGui)
new("UIListLayout",{SortOrder=Enum.SortOrder.LayoutOrder,Padding=UDim.new(0,7),VerticalAlignment=Enum.VerticalAlignment.Top,HorizontalAlignment=Enum.HorizontalAlignment.Center},Container)

local CARD_H, MAX = 74, 5
local ACCENT = {
	success=Color3.fromRGB(46,213,115), error=Color3.fromRGB(255,71,87),
	warning=Color3.fromRGB(255,171,0),  info =Color3.fromRGB(85,150,255),
}
local TYPE_ICON = {
	success=Icons.CheckCircle, error=Icons.XCircle,
	warning=Icons.AlertTriangle, info=Icons.Info,
}

local NotifyLib, active, order = {Icons=Icons}, {}, 0

-- Send(title, msg, type, dur, icon, color)  type="success"|"error"|"warning"|"info"
function NotifyLib:Send(title, message, nType, duration, icon, color)
	nType    = (nType or "info"):lower()
	duration = math.clamp(tonumber(duration) or 5, 1, 30)
	local col = color or ACCENT[nType] or ACCENT.info
	local ico = Icons:get(icon) or TYPE_ICON[nType] or Icons.Info

	if #active >= MAX then
		local old = table.remove(active,1)
		if old and old.wrapper and old.wrapper.Parent then old.wrapper:Destroy() end
	end

	order += 1
	local Wrapper  = new("Frame",{Name="NW_"..order,Size=UDim2.new(1,0,0,CARD_H),BackgroundTransparency=1,BorderSizePixel=0,ClipsDescendants=true,LayoutOrder=order},Container)
	local Card     = new("Frame",{Size=UDim2.new(1,0,1,0),Position=UDim2.new(1,10,0,0),BackgroundColor3=Color3.fromRGB(16,16,24),BorderSizePixel=0},Wrapper)
	corner(10,Card)
	new("UIStroke",{Color=Color3.fromRGB(55,55,80),Thickness=1,Transparency=0.4},Card)

	corner(4, new("Frame",{Size=UDim2.new(0,3,0.6,0),Position=UDim2.new(0,0,0.2,0),BackgroundColor3=col,BorderSizePixel=0,ZIndex=3},Card))

	local IconBg = new("Frame",{Size=UDim2.new(0,36,0,36),Position=UDim2.new(0,14,0.5,-18),BackgroundColor3=col,BackgroundTransparency=0.78,BorderSizePixel=0,ZIndex=3},Card)
	corner(18,IconBg)
	new("UIStroke",{Color=col,Thickness=1.2,Transparency=0.5},IconBg)
	new("ImageLabel",{Size=UDim2.new(0,18,0,18),Position=UDim2.new(0.5,-9,0.5,-9),BackgroundTransparency=1,Image=ico,ImageColor3=col,ScaleType=Enum.ScaleType.Fit,ZIndex=4},IconBg)

	new("TextLabel",{Size=UDim2.new(1,-66,0,22),Position=UDim2.new(0,60,0,12),BackgroundTransparency=1,Text=tostring(title),  TextColor3=Color3.fromRGB(245,245,255),TextSize=13,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd,ZIndex=3},Card)
	new("TextLabel",{Size=UDim2.new(1,-66,0,18),Position=UDim2.new(0,60,0,36),BackgroundTransparency=1,Text=tostring(message),TextColor3=Color3.fromRGB(145,145,172),TextSize=11,Font=Enum.Font.Gotham,    TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd,ZIndex=3},Card)

	local ProgBG   = new("Frame",{Size=UDim2.new(1,-16,0,2),Position=UDim2.new(0,8,1,-5),BackgroundColor3=Color3.fromRGB(35,35,52),BorderSizePixel=0,ZIndex=3},Card)
	corner(2,ProgBG)
	local ProgFill = new("Frame",{Size=UDim2.new(1,0,1,0),BackgroundColor3=col,BorderSizePixel=0,ZIndex=4},ProgBG)
	corner(2,ProgFill)

	local tweens, dismissed = {}, false
	local function cancel() for _,t in ipairs(tweens) do pcall(t.Cancel,t) end table.clear(tweens) end

	local function removeCard()
		if dismissed then return end dismissed=true cancel()
		if not (Wrapper and Wrapper.Parent) then return end
		local t = TS:Create(Card,TweenInfo.new(0.28,Enum.EasingStyle.Quint,Enum.EasingDirection.In),{Position=UDim2.new(1,10,0,0)})
		table.insert(tweens,t) t:Play()
		task.delay(0.29,function() if Wrapper and Wrapper.Parent then Wrapper:Destroy() end end)
		for i,v in ipairs(active) do if v.wrapper==Wrapper then table.remove(active,i) break end end
	end

	local tin = TS:Create(Card,TweenInfo.new(0.42,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{Position=UDim2.new(0,0,0,0)})
	table.insert(tweens,tin) tin:Play()
	task.delay(0.42,function()
		if dismissed then return end
		local tp = TS:Create(ProgFill,TweenInfo.new(duration,Enum.EasingStyle.Linear),{Size=UDim2.new(0,0,1,0)})
		table.insert(tweens,tp) tp:Play()
	end)
	task.delay(0.42+duration,removeCard)
	table.insert(active,{wrapper=Wrapper,tweens=tweens})
	return removeCard
end

function NotifyLib:Success(t,m,d,i,c) return self:Send(t,m,"success",d,i,c) end
function NotifyLib:Error(t,m,d,i,c)   return self:Send(t,m,"error",d,i,c)   end
function NotifyLib:Warning(t,m,d,i,c) return self:Send(t,m,"warning",d,i,c) end
function NotifyLib:Info(t,m,d,i,c)    return self:Send(t,m,"info",d,i,c)    end
function NotifyLib:ClearAll()
	for _,v in ipairs(active) do if v.wrapper and v.wrapper.Parent then v.wrapper:Destroy() end end
	table.clear(active)
end

return NotifyLib

