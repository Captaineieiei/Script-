-- สร้างธีมแบบ "resolve ค่าเต็มไว้ล่วงหน้า" เป็นตารางแยกอิสระของตัวเอง ไม่ใช้ metatable/__index fallback
-- เหตุผล: ของเดิมใช้ setmetatable({...}, {__index = BaseTheme}) ทำให้ธีมที่ไม่ได้กำหนดค่าเอง (เช่น Text)
-- ไปอ้างอิง BaseTheme ตัวเดียวกันแบบ "เชื่อมถึงกัน" ตลอดเวลา ถ้ามีจุดไหนในโค้ด (ปัจจุบันหรืออนาคต)
-- เผลอเขียนทับ BaseTheme โดยตรง สีจะรั่วข้ามธีมกันทันที ฟังก์ชันนี้ตัดปัญหาด้วยการ "ก็อปปี้ค่าจริง"
-- ออกมาเป็นตารางของตัวเองเลยตั้งแต่ตอนโหลด ธีมแต่ละอันจึงเป็นอิสระต่อกัน 100%
local function resolveTheme(overrides)
    local t = {}
    for k, v in pairs(BaseTheme) do t[k] = v end
    if overrides then
        for k, v in pairs(overrides) do t[k] = v end
    end
    t.Accent = t.AccentA
    return t
end

Library.Themes.Midnight = resolveTheme(nil)
