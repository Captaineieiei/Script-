local function createIconButton(text, imgId, isPrimary)
    local btn = Instance.new("TextButton", ButtonFrame)
    btn.Size = UDim2.new(0, 138, 1, 0)
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    local grad = Instance.new("UIGradient", btn)
    grad.Color = isPrimary and ColorSequence.new(Color3.fromRGB(100, 90, 255), Color3.fromRGB(160, 100, 255)) or ColorSequence.new(Color3.fromRGB(55, 55, 65), Color3.fromRGB(75, 75, 85))
    local bStroke = Instance.new("UIStroke", btn)
    bStroke.Color = isPrimary and Color3.fromRGB(180, 160, 255) or Color3.fromRGB(100, 100, 120)
    bStroke.Transparency = 0.5

    local container = Instance.new("Frame", btn)
    container.Size = UDim2.new(1, 0, 1, 0)
    container.BackgroundTransparency = 1
    local l = Instance.new("UIListLayout", container)
    l.FillDirection = Enum.FillDirection.Horizontal
    l.HorizontalAlignment = Enum.HorizontalAlignment.Center
    l.VerticalAlignment = Enum.VerticalAlignment.Center
    l.Padding = UDim.new(0, 8)

    local icon = Instance.new("ImageLabel", container)
    icon.Size = UDim2.new(0, 18, 0, 18)
    icon.BackgroundTransparency = 1
    icon.Image = "rbxassetid://" .. imgId
    local label = Instance.new("TextLabel", container)
    label.Text = text
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    label.TextColor3 = Color3.new(1, 1, 1)
    label.BackgroundTransparency = 1
    label.AutomaticSize = Enum.AutomaticSize.XY

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(60, 60, 80)}):Play()
        TweenService:Create(bStroke, TweenInfo.new(0.2), {Transparency = 0}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 40, 50)}):Play()
        TweenService:Create(bStroke, TweenInfo.new(0.2), {Transparency = 0.5}):Play()
    end)
    return btn
end

local CheckBtn = createIconButton("Check Key", "119783053916823", true)
local GetBtn = createIconButton("Get Key", "107485544510830", false)

-- =====================
-- LOGIC
-- =====================
CheckBtn.MouseButton1Click:Connect(function()
    if isClosing then return end
    local key = KeyInput.Text:gsub("%s+", "")
    if key == "" then ShowStatus("Please enter a key", Color3.fromRGB(255, 80, 80)) ShakeUI() return end
    if not JunkieAPI then
        ShowStatus("API Error! Retrying...", Color3.fromRGB(255, 80, 80))
        pcall(function() JunkieAPI = loadstring(game:HttpGet("https://junkie-development.de/sdk/JunkieKeySystem.lua"))() end)
        return
    end
    ShowStatus("Checking...", Color3.fromRGB(255, 180, 0))
    local success, isValid = pcall(function() return JunkieAPI.verifyKey(Config.api, key, Config.service) end)
    if success and isValid then
        ShowStatus("Access Granted!", Color3.fromRGB(0, 255, 150))
        task.wait(0.5)
        SmoothDestroy()
        main()
    else
        ShowStatus("Invalid Key!", Color3.fromRGB(255, 80, 80))
        ShakeUI()
    end
end)

GetBtn.MouseButton1Click:Connect(function()
    if not JunkieAPI then pcall(function() JunkieAPI = loadstring(game:HttpGet("https://junkie-development.de/sdk/JunkieKeySystem.lua"))() end) end
    if JunkieAPI then
        local link = JunkieAPI.getLink(Config.api, Config.provider, Config.service)
        if setclipboard then setclipboard(link) end
        ShowStatus("Link copied!", Color3.fromRGB(150, 150, 255))
    else
        ShowStatus("Failed to get link", Color3.fromRGB(255, 80, 80))
    end
end)

local dragging, dragStart, startPos
Frame.InputBegan:Connect(function(i)
    if (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
        dragging = true dragStart = i.Position startPos = Frame.Position
        i.Changed:Connect(function() if i.UserInputState == Enum.UserInputState.End then dragging = false end end)
    end
end)
UIS.InputChanged:Connect(function(i)
    if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
        local delta = i.Position - dragStart
        Frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

