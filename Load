end

-- ─────────────────────────────────────────
--  HTTP WRAPPER
-- ─────────────────────────────────────────
local function httpSend(opts)
    if syn and syn.request       then return syn.request(opts)   end
    if http and http.request     then return http.request(opts)  end
    if http_request              then return http_request(opts)  end
    if request                   then return request(opts)       end
    if HttpRequest               then return HttpRequest(opts)   end
    if httpRequest               then return httpRequest(opts)   end
    warn("SpectreWare: ไม่พบ http function")
end

-- ─────────────────────────────────────────
--  HELPERS
-- ─────────────────────────────────────────
local function getHWID()
    local id = "UNKNOWN"
    pcall(function() id = game:GetService("RbxAnalyticsService"):GetClientId() end)
    if id == "UNKNOWN" then
        pcall(function()
            id = tostring(PL.UserId) .. "_" .. tostring(game.JobId):sub(1,8)
        end)
    end
    return id
end

local function getAccountAge()
    local v = "?"
    pcall(function() v = tostring(PL.AccountAge) .. " วัน" end)
    return v
end

local function getPlatform()
    local v = "Unknown"
    pcall(function()
        v = tostring(game:GetService("UserInputService"):GetPlatform())
            :gsub("Enum.Platform.", "")
    end)
    return v
end

local function getPing()
    local v = "?"
    pcall(function()
        v = tostring(math.floor(
            game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
        )) .. " ms"
    end)
    return v
end

local function getServerInfo()
    local pl = game:GetService("Players")
    return #pl:GetPlayers() .. "/" .. pl.MaxPlayers
end

local function getCharInfo()
    local i = { speed="?", jump="?", health="?" }
    pcall(function()
        local h = PL.Character and PL.Character:FindFirstChildOfClass("Humanoid")
        if h then
            i.speed  = tostring(math.floor(h.WalkSpeed))
            i.jump   = tostring(math.floor(h.JumpPower))
            i.health = math.floor(h.Health) .. "/" .. math.floor(h.MaxHealth)
        end
    end)
    return i
end

-- ─────────────────────────────────────────
--  WEBHOOK
-- ─────────────────────────────────────────
local function sendWebhook(info)
    info          = info or {}
    info.key      = info.key      or "?"
    info.hwid     = info.hwid     or "?"
    info.timeLeft = info.timeLeft or "?"

    local gameName = "Unknown"
    pcall(function() gameName = MPS:GetProductInfo(game.PlaceId).Name end)

    local char   = getCharInfo()
    local avatar = "https://www.roblox.com/headshot-thumbnail/image?userId="
        .. tostring(PL.UserId) .. "&width=420&height=420&format=png"

    local ok, payload = pcall(function()
        return HS:JSONEncode({
            username   = "SpectreWare Logger",
            avatar_url = avatar,
            embeds = {{
                title     = "🌌 SpectreWare — ตรวจพบการใช้งานใหม่",
                color     = 0x00C8FF,
                thumbnail = { url = avatar },
                fields = {
                    { name  = "👤 ข้อมูลผู้ใช้",
                      value = "```\nUsername   : " .. PL.Name
                           .. "\nDisplayName: " .. PL.DisplayName
                           .. "\nUser ID    : " .. tostring(PL.UserId)
                           .. "\nอายุบัญชี  : " .. getAccountAge() .. "```",
                      inline = false },
                    { name  = "🔐 ข้อมูล Key",
                      value = "```\nKey    : " .. info.key
                           .. "\nHWID   : " .. info.hwid
                           .. "\nหมดอายุ: " .. info.timeLeft .. "```",
                      inline = false },
                    { name  = "🎮 ข้อมูลเกม",
                      value = "```\nGame    : " .. gameName
                           .. "\nPlace ID: " .. tostring(game.PlaceId)
                           .. "\nJob ID  : " .. tostring(game.JobId) .. "```"
                           .. "\n🗺️ **[เปิด Map](https://www.roblox.com/games/" .. tostring(game.PlaceId) .. ")**",
                      inline = false },
                    { name  = "⚡ ระบบ & อุปกรณ์",
                      value = "```\nPlatform: " .. getPlatform()
                           .. "\nPing    : " .. getPing()
                           .. "\nServer  : " .. getServerInfo() .. " ผู้เล่น```",
                      inline = false },
                    { name  = "🧬 สถานะตัวละคร",
                      value = "```\nHP   : " .. char.health
                           .. "\nSpeed: " .. char.speed
                           .. "\nJump : " .. char.jump .. "```",
                      inline = false },
                },
                footer    = { text = "SpectreWare  •  " .. os.date("!%d/%m/%Y %H:%M:%S") .. " UTC", icon_url = avatar },
                timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
            }},
        })
    end)

    if not ok then warn("SpectreWare: JSONEncode failed — " .. tostring(payload)) return end

    local sok, serr = pcall(function()
        httpSend({ Url=WEBHOOK, Method="POST", Headers={["Content-Type"]="application/json"}, Body=payload })
    end)
    if not sok then warn("SpectreWare: Webhook failed — " .. tostring(serr)) end
end

-- ─────────────────────────────────────────
--  MAIN
-- ─────────────────────────────────────────
banner()
task.wait(0.8)

if KEY == "" then
    log("ไม่พบ Key — ตั้งค่า getgenv().KEY ก่อนรัน", "error")
    return
end

log("กำลังอ่าน Key...", "loading")
task.wait(1.0)

local hwid = getHWID()
log("HWID: " .. tostring(hwid):sub(1,28) .. "...", "info")
task.wait(0.8)

local ok, raw
for i = 1, 3 do
    log(string.format("เชื่อมต่อ API... (%d/3)", i), "loading")
    ok, raw = pcall(function()
        return game:HttpGet(API .. "/api/lookup?key=" .. KEY .. "&hwid=" .. hwid, true)
    end)
    if ok and raw and raw ~= "" then break end
    if i < 3 then task.wait(1.5) end
end

if not ok or not raw or raw == "" then
    log("เชื่อมต่อ API ไม่ได้ — เปิด HTTP Requests หรือ Server ล่ม", "error")
    return
end

log("ได้รับการตอบกลับจาก API ✓", "info")
task.wait(0.6)

local ok2, result = pcall(HS.JSONDecode, HS, raw)
if not ok2 or type(result) ~= "table" then
    log("API ตอบกลับผิดพลาด", "error")
    return
end

log("กำลังตรวจสอบ Key...", "loading")
task.wait(1.2)

if result.success ~= true and result.success ~= "true" then
    log("Key ไม่ถูกต้องหรือหมดอายุแล้ว", "error")
    return
end

if type(result.data) ~= "table" then
    log("ข้อมูลจาก API ไม่สมบูรณ์", "error")
    return
end

local data = result.data

log("กำลังตรวจสอบ HWID...", "loading")
task.wait(1.0)

if type(data.hwid) == "string" and data.hwid ~= "" then
    if data.hwid ~= hwid then
        log("HWID ไม่ตรง — Key ผูกกับอุปกรณ์อื่น", "error")
        task.spawn(function()
            sendWebhook({ key=KEY, hwid=hwid.." MISMATCH", timeLeft="BLOCKED" })
        end)
        return
    end
end
log("HWID ผ่านแล้ว ✓", "success")
task.wait(0.8)

local timeLeft = "Permanent"
if data.expiresAt ~= nil and data.expiresAt ~= -1 then
    local diff = math.floor((data.expiresAt - os.time() * 1000) / 1000)
    if diff <= 0 then
        log("Key หมดอายุแล้ว", "error")
        return
    end
    local d = math.floor(diff / 86400)
    local h = math.floor((diff % 86400) / 3600)
    local m = math.floor((diff % 3600) / 60)
    timeLeft = d .. "d " .. h .. "h " .. m .. "m"
end

log("ตรวจสอบวันหมดอายุ ✓", "success")
task.wait(0.6)

summary(timeLeft, hwid)
task.wait(1.0)

task.spawn(function()
    sendWebhook({ key=KEY, hwid=hwid, timeLeft=timeLeft })
end)

log("กำลังโหลด Script...", "loading")
task.wait(1.2)
loadstring(game:HttpGet(SCRIPT, true))()
task.wait(0.4)
log("โหลด Script สำเร็จ 🚀", "success")
