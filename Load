local function log(msg, t)
    t = t or "info"
    print((ICONS[t] or "▪") .. "  " .. msg)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification",
            { Title="SpectreWare", Text=msg, Duration=DURATION[t] or 4 })
    end)
end

local function banner()
    print("")
    print("  ✦  SpectreWare  ✦")
