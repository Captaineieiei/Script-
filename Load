-- ─────────────────────────────────────────
--  LOGGER
-- ─────────────────────────────────────────
local ICONS = {
    info    = "🔹",
    success = "✅",
    error   = "❌",
    loading = "🔄",
    warn    = "⚠️",
}
local DURATION = { info=4, success=5, error=6, loading=4, warn=5 }

local function log(msg, t)
    t = t or "info"
    print((ICONS[t] or "▪") .. "  " .. msg)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title    = "SpectreWare",
            Text     = msg,
            Duration = DURATION[t] or 4,
        })
    end)
end

local function banner()
    print("")
    print("  ✦  SpectreWare  ✦")
    print("  Loader v2  •  Key Auth")
    print("")
end

local function summary(timeLeft, hwid)
    print("")
    print("✅  KEY VERIFIED")
    print("👤  " .. tostring(PL.Name))
    print("🔑  " .. tostring(hwid):sub(1,28) .. "...")
