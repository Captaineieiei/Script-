local function getHWID()
    local id = "UNKNOWN"
    pcall(function() id = game:GetService("RbxAnalyticsService"):GetClientId() end)
    if id == "UNKNOWN" then
        pcall(function()
            id = tostring(PL.UserId) .. "_" .. tostring(game.JobId):sub(1, 8)
        end)
    end
    return id
end

local function getAccountAge()
    local age = "?"
    pcall(function() age = tostring(PL.AccountAge) .. " วัน" end)
    return age
end

local function getPlatform()
    local p = "Unknown"
    pcall(function()
        p = tostring(game:GetService("UserInputService"):GetPlatform())
            :gsub("Enum.Platform.", "")
    end)
    return p
end

local function getPing()
    local ping = "?"
    pcall(function()
        ping = tostring(math.floor(
            game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
        )) .. " ms"
    end)
    return ping
end

local function getServerInfo()
    local pl = game:GetService("Players")
    return tostring(#pl:GetPlayers()) .. "/" .. tostring(pl.MaxPlayers)
end

local function getCharacterInfo()
    local info = { speed = "?", jump = "?", health = "?" }
    pcall(function()
        local char = PL.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                info.speed  = tostring(math.floor(hum.WalkSpeed))
                info.jump   = tostring(math.floor(hum.JumpPower))
                info.health = tostring(math.floor(hum.Health)) .. "/" .. tostring(math.floor(hum.MaxHealth))
            end
        end
    end)
    return info
end

