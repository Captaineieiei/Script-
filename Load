-- ============================================================
-- Nova Hub | Load  (อัปโหลดไฟล์นี้ขึ้น GitHub ชื่อ "Load")
-- อ่าน getgenv().KEY → ตรวจ whitelist → โหลด script จริง
-- ============================================================
local KEY    = getgenv().KEY or ""
local API    = "http://fi8.bot-hosting.net:21017"
-- ⬇ เปลี่ยน URL นี้ให้ตรงกับ script จริงของคุณ
local SCRIPT = "https://raw.githubusercontent.com/Captaineieiei/Script-/refs/heads/main/Zzaa"

local HS  = game:GetService("HttpService")
local SG  = game:GetService("StarterGui")
local PL  = game:GetService("Players").LocalPlayer

-- ── Notify ────────────────────────────────────────────────
local function notify(msg, col)
  pcall(function()
    SG:SetCore("SendNotification", {Title = "Nova Hub", Text = msg, Duration = 4})
  end)
  pcall(function()
    SG:SetCore("ChatMakeSystemMessage", {
      Text     = "[Nova Hub] " .. msg,
      Color    = col or Color3.fromRGB(0, 200, 255),
      Font     = Enum.Font.GothamBold,
      TextSize = 14,
    })
  end)
  print("[Nova Hub] " .. msg)
end

-- ── HWID ──────────────────────────────────────────────────
local function getHWID()
  local ok, id = pcall(function()
    return tostring(game:GetService("RbxAnalyticsService"):GetClientId())
  end)
  if ok and id and id ~= "" then return id end
  return tostring(PL.UserId)
end

-- ── Key check ─────────────────────────────────────────────
if KEY == "" then
  notify("❌ ไม่พบ Key  (ใช้ getgenv().KEY = \"...\")", Color3.fromRGB(255, 80, 80))
  return
end

local hwid = getHWID()
local url  = API .. "/api/lookup?key=" .. KEY .. "&hwid=" .. hwid

local ok, raw = pcall(game.HttpGet, game, url, true)
if not ok then
  notify("❌ เชื่อมต่อ Server ไม่ได้", Color3.fromRGB(255, 80, 80))
  return
end

local ok2, result = pcall(HS.JSONDecode, HS, raw)
if not ok2 then
  notify("❌ Server response error", Color3.fromRGB(255, 80, 80))
  return
end

if not result.success then
  notify("❌ " .. (result.message or "Unauthorized"), Color3.fromRGB(255, 80, 80))
  return
end

-- ── แสดงเวลาที่เหลือ ──────────────────────────────────────
local timeLeft = "Permanent"
local data = result.data
if data.expiresAt ~= -1 then
  local diff = math.floor((data.expiresAt - os.time() * 1000) / 1000)
  if diff <= 0 then
    notify("❌ Key หมดอายุแล้ว", Color3.fromRGB(255, 80, 80))
    return
  end
  local d = math.floor(diff / 86400)
  local h = math.floor((diff % 86400) / 3600)
  local m = math.floor((diff % 3600) / 60)
  timeLeft = d .. "d " .. h .. "h " .. m .. "m"
end

notify("✅ Authorized | เหลือ: " .. timeLeft, Color3.fromRGB(80, 255, 180))
task.wait(0.3)

-- ── โหลด script จริง ──────────────────────────────────────
local loadOk, loadErr = pcall(function()
  loadstring(game:HttpGet(SCRIPT, true))()
end)
if not loadOk then
  notify("❌ Script error: " .. tostring(loadErr), Color3.fromRGB(255, 80, 80))
end
