--  PRINT HELPERS  (Roblox console = no ANSI)
-- ══════════════════════════════════════════════
local W = 44

local function pad(str, len)
    str = tostring(str or "")
    if #str > len then return str:sub(1, len) end
    return str .. string.rep(" ", len - #str)
end

local function printBanner()
    print("")
    print("╔" .. string.rep("═", W) .. "╗")
    print("║" .. pad("", W) .. "║")
    print("║" .. pad("   ✦  S P E C T R E W A R E  ✦", W) .. "║")
    print("║" .. pad("      Loader v2  •  Key Auth", W) .. "║")
    print("║" .. pad("", W) .. "║")
    print("╚" .. string.rep("═", W) .. "╝")
    print("")
end

local LOG_CFG = {
    info    = { icon = "🔹", label = "INFO",    duration = 4 },
    success = { icon = "✅", label = "OK",      duration = 5 },
    error   = { icon = "❌", label = "ERROR",   duration = 6 },
    loading = { icon = "🔄", label = "LOADING", duration = 4 },
    warn    = { icon = "⚠️", label = "WARN",    duration = 5 },
}

local function log(msg, logType)
    logType = logType or "info"
    local t = LOG_CFG[logType] or LOG_CFG.info
    local header = t.icon .. "  " .. t.label .. "  |  SpectreWare"
    print("╔" .. string.rep("═", W) .. "╗")
    print("║  " .. pad(header, W - 2) .. "║")
    print("╠" .. string.rep("═", W) .. "╣")
    print("║  " .. pad(msg, W - 2) .. "║")
    print("╚" .. string.rep("═", W) .. "╝")
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title    = "SpectreWare  " .. t.icon,
            Text     = msg,
            Duration = t.duration,
        })
    end)
end

local function printSummary(timeLeft, hwid)
