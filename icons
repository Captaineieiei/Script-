-- ── Build flat lookup ────────────────────────────────────────────────────────
local _flat = {}
for cat, icons in pairs(_raw) do
	for name, id in pairs(icons) do
		_flat[name] = "rbxassetid://"..id
	end
end

-- ── API ──────────────────────────────────────────────────────────────────────

-- IconLib.Sword  /  IconLib["Sword"]
setmetatable(IconLib, {__index = function(_, k) return _flat[k] end})

-- resolve name, raw assetid string, or nil
function IconLib:get(name)
	if not name then return nil end
	if _flat[name] then return _flat[name] end
	if tostring(name):find("rbxassetid") then return tostring(name) end
	return nil
end

-- search("sword") → { {name="Sword",id="rbxassetid://..."}, ... }
function IconLib:search(query)
	local q, out = query:lower(), {}
	for name, id in pairs(_flat) do
		if name:lower():find(q, 1, true) then
			out[#out+1] = {name=name, id=id}
		end
	end
	table.sort(out, function(a,b) return a.name < b.name end)
	return out
end

-- category("RPG") → { Crown="rbxassetid://...", Wand="...", ... }
function IconLib:category(name)
	local c = _raw[name]
	if not c then return {} end
	local out = {}
	for k, id in pairs(c) do out[k] = "rbxassetid://"..id end
	return out
end

-- list of all category names
function IconLib:categories()
	local out = {}
	for k in pairs(_raw) do out[#out+1] = k end
	table.sort(out)
	return out
end

-- sorted list of all icon names
function IconLib:list()
	local out = {}
	for k in pairs(_flat) do out[#out+1] = k end
	table.sort(out)
	return out
end

-- total count
function IconLib:count() local n=0 for _ in pairs(_flat) do n+=1 end return n end

-- flat table reference
IconLib.all = _flat

return IconLib
