        --   AddParagraph(title, line1, line2, ...)
        -- ╚══════════════════════════════════════╝
        function TabData:AddParagraph(title, ...)
            local lines  = {...}
            local height = 28 + #lines * 17
            local Row = MakeRow(height, true)
            local TL = Instance.new("TextLabel")
            TL.Parent              = Row
            TL.BackgroundTransparency = 1
            TL.Position            = UDim2.new(0, 10, 0, 6)
            TL.Size                = UDim2.new(1, -20, 0, 16)
            TL.Font                = Enum.Font.GothamBold
            TL.Text                = title
            TL.TextColor3          = T.Text
            TL.TextSize            = 12
            TL.TextXAlignment      = Enum.TextXAlignment.Left
            for i, line in ipairs(lines) do
                local LL = Instance.new("TextLabel")
                LL.Parent              = Row
                LL.BackgroundTransparency = 1
                LL.Position            = UDim2.new(0, 10, 0, 20 + (i - 1) * 17)
                LL.Size                = UDim2.new(1, -20, 0, 15)
                LL.Font                = Enum.Font.Gotham
                LL.Text                = line
                LL.TextColor3          = T.TextDim
                LL.TextSize            = 10
                LL.TextXAlignment      = Enum.TextXAlignment.Left
            end
        end

        -- ╔══════════════════════════════════════╗
        --   AddButton { Name, Description, Callback }
        -- ╚══════════════════════════════════════╝
        function TabData:AddButton(cfg)
            cfg = cfg or {}
            local name     = cfg.Name or "Button"
            local desc     = cfg.Description
            local callback = cfg.Callback or function() end
            local h        = (desc and desc ~= "") and 50 or 36

            local Row, Acc = MakeRow(h)
            NameDesc(Row, name, desc, 26)

            local Btn = Instance.new("TextButton")
            Btn.Parent              = Row
            Btn.BackgroundTransparency = 1
            Btn.Size                = UDim2.new(1, 0, 1, 0)
            Btn.Text                = ""
            Btn.ZIndex              = 2
            Btn.AutoButtonColor     = false

            Btn.MouseEnter:Connect(function()
                Tween(Row, 0.14, {BackgroundColor3 = Color3.fromRGB(42, 32, 65)}):Play()
                Tween(Acc, 0.14, {BackgroundTransparency = 0}):Play()
            end)
            Btn.MouseLeave:Connect(function()
                Tween(Row, 0.14, {BackgroundColor3 = T.Elem}):Play()
                Tween(Acc, 0.14, {BackgroundTransparency = 0.6}):Play()
