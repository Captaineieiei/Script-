    function Window:Minimaze()
        minimized = not minimized
        if minimized then
            Tween(MainFrame, 0.3, {Size = UDim2.new(0, winWidth, 0, 38)}, Enum.EasingStyle.Quad):Play()
        else
            Tween(MainFrame, 0.3, {Size = UDim2.new(0, winWidth, 0, winHeight)}, Enum.EasingStyle.Back, Enum.EasingDirection.Out):Play()
        end
    end

    function Window:ColumnWindow()
        columnMode = not columnMode
        if columnMode then
            Tween(MainFrame, 0.3, {Size = UDim2.new(0, 165, 0, winHeight)}, Enum.EasingStyle.Quad):Play()
        else
            Tween(MainFrame, 0.3, {Size = UDim2.new(0, winWidth, 0, winHeight)}, Enum.EasingStyle.Back, Enum.EasingDirection.Out):Play()
        end
    end

    function Window:Close()
        Tween(MainFrame, 0.3, {BackgroundTransparency = 1, Size = UDim2.new(0, winWidth - 20, 0, winHeight - 20)}):Play()
        task.wait(0.32)
        ScreenGui:Destroy()
    end

    -- ── Notification ───────────────────────────────────────
