                pcall(callback, IBox.Text)
            end)

            local elem = {
                type = "input", key = saveKey,
                get  = function() return IBox.Text end,
                set  = function(v) IBox.Text = v or "" end
            }
            if saveKey then configSave[saveKey] = elem end
            return elem
        end

        -- ╔══════════════════════════════════════╗
        --   AddKeybind { Name, Description, Default, Callback }
        -- ╚══════════════════════════════════════╝
        function TabData:AddKeybind(cfg)
            cfg = cfg or {}
            local name       = cfg.Name or "Keybind"
            local desc       = cfg.Description
            local default    = cfg.Default or ""
            local callback   = cfg.Callback or function() end
            local saveKey    = cfg.SaveConfig and (tabId .. "_kb_" .. name)
            local currentKey = default
            local listening  = false
            local h          = (desc and desc ~= "") and 50 or 36

            local Row, Acc = MakeRow(h)
            NameDesc(Row, name, desc, 26)

            local function keyName(k)
                if k == "" or k == nil then return "None" end
                if typeof(k) == "EnumItem" then return k.Name end
                return tostring(k)
            end

            local KBtn = Instance.new("TextButton")
            KBtn.Parent              = Row
            KBtn.BackgroundColor3    = T.BG
            KBtn.BackgroundTransparency = 0.35
            KBtn.AnchorPoint         = Vector2.new(1, 0.5)
            KBtn.Position            = UDim2.new(1, -8, 0.5, 0)
            KBtn.Size                = UDim2.new(0, 72, 0, 22)
            KBtn.Font                = Enum.Font.GothamBold
            KBtn.Text                = keyName(currentKey)
            KBtn.TextColor3          = T.AccLt
            KBtn.TextSize            = 10
            KBtn.ZIndex              = 2
            KBtn.AutoButtonColor     = false
            Instance.new("UICorner", KBtn).CornerRadius = UDim.new(0, 5)

            KBtn.MouseButton1Click:Connect(function()
                if listening then return end
                listening    = true
                KBtn.Text    = "..."
                KBtn.TextColor3 = Color3.fromRGB(255, 220, 60)
            end)

            local inputConn
            inputConn = UserInputService.InputBegan:Connect(function(inp, gp)
                if not listening then return end
                if inp.UserInputType == Enum.UserInputType.Keyboard then
                    currentKey      = inp.KeyCode
                    KBtn.Text       = inp.KeyCode.Name
                    KBtn.TextColor3 = T.AccLt
                    listening       = false
                elseif inp.UserInputType == Enum.UserInputType.MouseButton1 then
                    KBtn.Text       = keyName(currentKey)
                    KBtn.TextColor3 = T.AccLt
                    listening       = false
                end
            end)

            -- Trigger callback on keypress
            UserInputService.InputBegan:Connect(function(inp, gp)
                if gp then return end
                if typeof(currentKey) == "EnumItem" and inp.KeyCode == currentKey then
                    pcall(callback)
                end
            end)

            local elem = {
                type = "keybind", key = saveKey,
                get  = function() return currentKey end,
                set  = function(v)
                    currentKey  = v
                    KBtn.Text   = keyName(v)
                end
            }
            if saveKey then configSave[saveKey] = elem end
            return elem
        end

        -- ╔══════════════════════════════════════╗
        --   AddThemePicker { Name, Callback }
        --   แสดง swatch สีทุก theme ให้กดเปลี่ยนได้
        -- ╚══════════════════════════════════════╝
        function TabData:AddThemePicker(cfg)
            cfg = cfg or {}
            local name     = cfg.Name or "Theme Color"
            local callback = cfg.Callback or function() end
            local SWATCH   = 22  -- swatch size px
            local GAP      = 5
            local PER_ROW  = 8
            local rows     = math.ceil(#ThemeOrder / PER_ROW)
            local rowH     = SWATCH + GAP
            local totalH   = 28 + rows * rowH + 6  -- header + swatches + bottom pad

            local Wrap = Instance.new("Frame")
            Wrap.Parent           = TabFrame
            Wrap.BackgroundColor3 = T.Elem
            Wrap.BorderSizePixel  = 0
            Wrap.Size             = UDim2.new(1, 0, 0, totalH)
            Instance.new("UICorner", Wrap).CornerRadius = UDim.new(0, 7)
            do
                local s = Instance.new("UIStroke")
                s.Color = T.Border; s.Thickness = 1; s.Transparency = 0.45; s.Parent = Wrap
            end
            -- Accent bar
            local Acc2 = Instance.new("Frame")
            Acc2.Parent                = Wrap
            Acc2.BackgroundColor3      = T.AccLt
            Acc2.BorderSizePixel       = 0
            Acc2.Position              = UDim2.new(0, 0, 0.12, 0)
            Acc2.Size                  = UDim2.new(0, 3, 0.76, 0)
            Acc2.BackgroundTransparency = 0.6
            Instance.new("UICorner", Acc2).CornerRadius = UDim.new(1, 0)

            local Header = Instance.new("TextLabel")
            Header.Parent              = Wrap
            Header.BackgroundTransparency = 1
            Header.Position            = UDim2.new(0, 12, 0, 6)
            Header.Size                = UDim2.new(1, -20, 0, 18)
            Header.Font                = Enum.Font.GothamSemibold
            Header.Text                = name
            Header.TextColor3          = T.Text
            Header.TextSize            = 13
            Header.TextXAlignment      = Enum.TextXAlignment.Left

            -- Current theme name label
            local CurLbl = Instance.new("TextLabel")
            CurLbl.Parent              = Wrap
            CurLbl.BackgroundTransparency = 1
            CurLbl.AnchorPoint         = Vector2.new(1, 0)
            CurLbl.Position            = UDim2.new(1, -8, 0, 8)
            CurLbl.Size                = UDim2.new(0, 100, 0, 14)
            CurLbl.Font                = Enum.Font.Gotham
            CurLbl.Text                = "Darkness"
            CurLbl.TextColor3          = T.AccLt
            CurLbl.TextSize            = 10
            CurLbl.TextXAlignment      = Enum.TextXAlignment.Right

            local swatchRefs = {}

            for idx, themeName in ipairs(ThemeOrder) do
                local th = Themes[themeName]
                if th then
                    local col  = ((idx - 1) % PER_ROW)
                    local row  = math.floor((idx - 1) / PER_ROW)
                    local xOff = 12 + col * (SWATCH + GAP)
                    local yOff = 28 + row * rowH

                    local SW = Instance.new("TextButton")
                    SW.Parent              = Wrap
                    SW.BackgroundColor3    = th.Swatch or th.AccLt
                    SW.BorderSizePixel     = 0
                    SW.Position            = UDim2.new(0, xOff, 0, yOff)
                    SW.Size                = UDim2.new(0, SWATCH, 0, SWATCH)
                    SW.Text                = ""
                    SW.ZIndex              = 2
                    SW.AutoButtonColor     = false
                    Instance.new("UICorner", SW).CornerRadius = UDim.new(1, 0)

                    -- selection ring
                    local Ring = Instance.new("UIStroke")
                    Ring.Color       = Color3.fromRGB(255, 255, 255)
                    Ring.Thickness   = 2
                    Ring.Transparency = 1
                    Ring.Parent      = SW

                    swatchRefs[themeName] = {sw = SW, ring = Ring}

                    -- tooltip frame
                    local TipFrame = Instance.new("Frame")
                    TipFrame.Parent           = ScreenGui
                    TipFrame.BackgroundColor3 = T.TopBar
                    TipFrame.BorderSizePixel  = 0
                    TipFrame.ZIndex           = 35
                    TipFrame.Visible          = false
                    TipFrame.Size             = UDim2.new(0, 0, 0, 20)
                    TipFrame.AutomaticSize    = Enum.AutomaticSize.X
                    Instance.new("UICorner", TipFrame).CornerRadius = UDim.new(0, 5)
                    do
                        local s = Instance.new("UIStroke")
                        s.Color = th.Swatch or th.AccLt; s.Thickness = 1; s.Transparency = 0.5; s.Parent = TipFrame
                    end
                    local TipLbl = Instance.new("TextLabel")
                    TipLbl.Parent              = TipFrame
                    TipLbl.BackgroundTransparency = 1
                    TipLbl.Size                = UDim2.new(1, 0, 1, 0)
                    TipLbl.Font                = Enum.Font.GothamBold
                    TipLbl.Text                = "  " .. themeName .. "  "
                    TipLbl.TextColor3          = Color3.fromRGB(240, 235, 255)
                    TipLbl.TextSize            = 10
                    TipLbl.ZIndex              = 36

                    SW.MouseEnter:Connect(function()
                        Tween(SW, 0.1, {Size = UDim2.new(0, SWATCH + 3, 0, SWATCH + 3),
                            Position = UDim2.new(0, xOff - 1, 0, yOff - 1)}):Play()
                        local abs = SW.AbsolutePosition
                        TipFrame.Position = UDim2.new(0, abs.X, 0, abs.Y - 24)
                        TipFrame.Visible  = true
                    end)
                    SW.MouseLeave:Connect(function()
                        Tween(SW, 0.1, {Size = UDim2.new(0, SWATCH, 0, SWATCH),
                            Position = UDim2.new(0, xOff, 0, yOff)}):Play()
                        TipFrame.Visible = false
                    end)
                    SW.MouseButton1Click:Connect(function()
                        TipFrame.Visible = false
                        -- reset all rings
                        for _, ref in pairs(swatchRefs) do
                            Tween(ref.ring, 0.15, {Transparency = 1}):Play()
                        end
                        Tween(Ring, 0.15, {Transparency = 0}):Play()
                        CurLbl.Text = themeName
                        -- apply theme
                        Window:SetTheme(themeName)
                        pcall(callback, themeName)
                    end)
                end
            end

            -- set initial ring on Darkness
            if swatchRefs["Darkness"] then
                swatchRefs["Darkness"].ring.Transparency = 0
            end
        end

        return TabData
    end

    -- ══════════════════════════════════════════════════════
    --  WINDOW METHODS
    -- ══════════════════════════════════════════════════════

    function Window:SetTheme(name)
        local newT = Themes[name]
        if not newT then return end
        T = newT
        -- update main frame colors
        MainFrame.BackgroundColor3 = T.BG
        MainStroke.Color           = T.Accent
        TopBar.BackgroundColor3    = T.TopBar
        TabBar.BackgroundColor3    = T.Tab
        Dot.BackgroundColor3       = T.AccLt
        -- update all tab scroll bars
        for _, td in ipairs(Tabs) do
            td.Frame.ScrollBarImageColor3 = T.Accent
        end
    end

    function Window:Blur()
        if blurFx then return end
        local cam = workspace.CurrentCamera
        if cam then
            blurFx        = Instance.new("BlurEffect")
            blurFx.Size   = 18
            blurFx.Parent = cam
        end
    end

    function Window:BlurOff()
        if blurFx then
            blurFx:Destroy()
            blurFx = nil
        end
    end

    function Window:ChangeBackgroundTransparance()
        local cur  = MainFrame.BackgroundTransparency
        local next = cur < 0.4 and 0.42 or 0
        Tween(MainFrame, 0.3, {BackgroundTransparency = next}):Play()
    end

