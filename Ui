        function TabData:AddDropdown(cfg)
            cfg=cfg or {}; local name=cfg.Name or "Dropdown"; local desc=cfg.Description; local options=cfg.Options or {}
            local callback=cfg.Callback or function() end; local saveKey=cfg.SaveConfig and (tabId.."_dd_"..name); local selected=cfg.Default or ""; local isOpen=false
            local h=(desc and desc~="") and 50 or 36; local Row,Acc=MakeRow(h); NameDesc(Row,name,desc,26)
            local SelLbl=Instance.new("TextLabel"); SelLbl.Parent=Row; SelLbl.BackgroundColor3=T.BG; SelLbl.BackgroundTransparency=0.35
            SelLbl.AnchorPoint=Vector2.new(1,0.5); SelLbl.Position=UDim2.new(1,-8,0.5,0); SelLbl.Size=UDim2.new(0,72,0,22)
            SelLbl.Font=Enum.Font.GothamSemibold; SelLbl.Text=selected~="" and selected or "Select ▾"
            SelLbl.TextColor3=T.AccLt; SelLbl.TextSize=10; SelLbl.TextTruncate=Enum.TextTruncate.AtEnd
