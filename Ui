        -- ╔══════════════════════════════════════╗
        --   AddToggle { Name, Description, Default, Callback, SaveConfig }
        -- ╚══════════════════════════════════════╝
        function TabData:AddToggle(cfg)
            cfg = cfg or {}
            local name     = cfg.Name or "Toggle"
            local desc     = cfg.Description
            local callback = cfg.Callback or function() end
            local saveKey  = cfg.SaveConfig and (tabId .. "_tog_" .. name)
            local toggled  = cfg.Default or false
            local h        = (desc and desc ~= "") and 50 or 36

            local Row, Acc = MakeRow(h)
            NameDesc(Row, name, desc, 26)

            local TogBG = Instance.new("Frame")
            TogBG.Parent           = Row
            TogBG.BackgroundColor3 = toggled and T.Accent or T.Knob
            TogBG.BorderSizePixel  = 0
            TogBG.Position         = UDim2.new(1, -46, 0.5, -10)
            TogBG.Size             = UDim2.new(0, 36, 0, 20)
            Instance.new("UICorner", TogBG).CornerRadius = UDim.new(1, 0)

            local Knob = Instance.new("Frame")
            Knob.Parent           = TogBG
            Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            Knob.BorderSizePixel  = 0
            Knob.Position         = toggled
                and UDim2.new(1, -18, 0.5, -8)
                 or UDim2.new(0,   2, 0.5, -8)
            Knob.Size             = UDim2.new(0, 16, 0, 16)
            Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)

            local Click = Instance.new("TextButton")
            Click.Parent              = Row
            Click.BackgroundTransparency = 1
            Click.Size                = UDim2.new(1, 0, 1, 0)
            Click.Text                = ""
            Click.ZIndex              = 2
            Click.MouseButton1Click:Connect(function()
                toggled = not toggled
                Tween(TogBG, 0.2, {BackgroundColor3 = toggled and T.Accent or T.Knob}):Play()
                Tween(Knob, 0.2, {
                    Position = toggled
                        and UDim2.new(1, -18, 0.5, -8)
                         or UDim2.new(0,   2, 0.5, -8)
                }):Play()
                pcall(callback, toggled)
            end)

            local elem = {
                type = "toggle", key = saveKey,
                get  = function() return toggled end,
                set  = function(v)
                    toggled = v
                    TogBG.BackgroundColor3 = v and T.Accent or T.Knob
                    Knob.Position = v and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
                    pcall(callback, v)
                end
            }
            if saveKey then configSave[saveKey] = elem end
            table.insert(TabData.Elements, elem)
            return elem
        end

        -- ╔══════════════════════════════════════╗
        --   AddDropdown { Name, Description, Options, Default, Callback, SaveConfig }
        -- ╚══════════════════════════════════════╝
        function TabData:AddDropdown(cfg)
            cfg = cfg or {}
            local name     = cfg.Name or "Dropdown"
            local desc     = cfg.Description
            local options  = cfg.Options or {}
            local callback = cfg.Callback or function() end
            local saveKey  = cfg.SaveConfig and (tabId .. "_dd_" .. name)
            local selected = cfg.Default or ""
            local isOpen   = false
            local h        = (desc and desc ~= "") and 50 or 36

            local Row, Acc = MakeRow(h)
            NameDesc(Row, name, desc, 26)

            -- Selected value badge
            local SelLbl = Instance.new("TextLabel")
            SelLbl.Parent              = Row
            SelLbl.BackgroundColor3    = T.BG
            SelLbl.BackgroundTransparency = 0.35
            SelLbl.AnchorPoint         = Vector2.new(1, 0.5)
            SelLbl.Position            = UDim2.new(1, -8, 0.5, 0)
            SelLbl.Size                = UDim2.new(0, 72, 0, 22)
            SelLbl.Font                = Enum.Font.GothamSemibold
            SelLbl.Text                = selected ~= "" and selected or "Select ▾"
            SelLbl.TextColor3          = T.AccLt
            SelLbl.TextSize            = 10
            SelLbl.TextTruncate        = Enum.TextTruncate.AtEnd
            Instance.new("UICorner", SelLbl).CornerRadius = UDim.new(0, 5)

            -- Dropdown panel (parented to ScreenGui to escape clipping)
            local Panel = Instance.new("Frame")
            Panel.Parent           = ScreenGui
            Panel.BackgroundColor3 = T.TopBar
            Panel.BorderSizePixel  = 0
            Panel.ZIndex           = 25
            Panel.Visible          = false
            Instance.new("UICorner", Panel).CornerRadius = UDim.new(0, 7)
            do
                local s = Instance.new("UIStroke")
                s.Color = T.Accent; s.Thickness = 1; s.Transparency = 0.45; s.Parent = Panel
            end
            local PList = Instance.new("UIListLayout")
            PList.Parent    = Panel
            PList.SortOrder = Enum.SortOrder.LayoutOrder

            local OPT_H = 26
            for _, opt in ipairs(options) do
                local OB = Instance.new("TextButton")
                OB.Parent              = Panel
                OB.BackgroundColor3    = T.Elem
                OB.BackgroundTransparency = opt == selected and 0.25 or 1
                OB.BorderSizePixel     = 0
                OB.Size                = UDim2.new(1, 0, 0, OPT_H)
                OB.Font                = Enum.Font.GothamSemibold
                OB.Text                = "  " .. opt
                OB.TextColor3          = opt == selected and T.AccLt or T.Text
                OB.TextSize            = 11
                OB.TextXAlignment      = Enum.TextXAlignment.Left
                OB.ZIndex              = 26
                OB.AutoButtonColor     = false
                OB.MouseEnter:Connect(function() Tween(OB, 0.1, {BackgroundTransparency = 0.45}):Play() end)
                OB.MouseLeave:Connect(function()
                    Tween(OB, 0.1, {BackgroundTransparency = opt == selected and 0.25 or 1}):Play()
                end)
                OB.MouseButton1Click:Connect(function()
                    -- reset previous highlight
                    for _, c in ipairs(Panel:GetChildren()) do
                        if c:IsA("TextButton") then
                            c.BackgroundTransparency = 1
                            local cl = c:FindFirstChildWhichIsA("TextLabel")
                            if cl then cl.TextColor3 = T.Text end
                            Tween(c, 0.1, {TextColor3 = T.Text}):Play()
                        end
                    end
                    OB.BackgroundTransparency = 0.25
                    Tween(OB, 0.1, {TextColor3 = T.AccLt}):Play()
                    selected      = opt
                    SelLbl.Text   = opt
                    isOpen        = false
                    Panel.Visible = false
                    pcall(callback, opt)
                end)
            end

            local function openPanel()
                local abs  = Row.AbsolutePosition
                local absS = Row.AbsoluteSize
                local ph   = math.min(#options, 5) * OPT_H
                Panel.Position = UDim2.new(0, abs.X, 0, abs.Y + absS.Y + 3)
                Panel.Size     = UDim2.new(0, absS.X, 0, ph)
                Panel.Visible  = true
            end

            local ClickBtn = Instance.new("TextButton")
            ClickBtn.Parent              = Row
            ClickBtn.BackgroundTransparency = 1
            ClickBtn.Size                = UDim2.new(1, 0, 1, 0)
            ClickBtn.Text                = ""
            ClickBtn.ZIndex              = 2
            ClickBtn.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                if isOpen then openPanel() else Panel.Visible = false end
            end)

            UserInputService.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 and isOpen then
                    task.wait()  -- let click events fire first
                    local mp  = inp.Position
                    local pp  = Panel.AbsolutePosition
                    local ps  = Panel.AbsoluteSize
                    if not (mp.X >= pp.X and mp.X <= pp.X + ps.X
                        and mp.Y >= pp.Y and mp.Y <= pp.Y + ps.Y) then
                        isOpen        = false
                        Panel.Visible = false
                    end
                end
            end)

            local elem = {
                type = "dropdown", key = saveKey,
                get  = function() return selected end,
                set  = function(v) selected = v; SelLbl.Text = v end
            }
            if saveKey then configSave[saveKey] = elem end
            return elem
        end

        -- ╔══════════════════════════════════════╗
        --   AddInput { Name, Description, Callback, SaveConfig }
        -- ╚══════════════════════════════════════╝
        function TabData:AddInput(cfg)
            cfg = cfg or {}
            local name     = cfg.Name or "Input"
            local desc     = cfg.Description
            local callback = cfg.Callback or function() end
            local saveKey  = cfg.SaveConfig and (tabId .. "_inp_" .. name)

            local Row, Acc = MakeRow(54)
            NameDesc(Row, name, nil, 0)  -- just the name label at top

            local IBox = Instance.new("TextBox")
            IBox.Parent              = Row
            IBox.BackgroundColor3    = T.BG
            IBox.BackgroundTransparency = 0.35
            IBox.Position            = UDim2.new(0, 8, 0, 28)
            IBox.Size                = UDim2.new(1, -16, 0, 22)
            IBox.Font                = Enum.Font.Gotham
            IBox.PlaceholderText     = desc or "Enter value..."
            IBox.PlaceholderColor3   = T.TextDim
            IBox.Text                = ""
            IBox.TextColor3          = T.Text
            IBox.TextSize            = 11
            IBox.ClearTextOnFocus    = false
