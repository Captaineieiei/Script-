    local function cfgPath(p) return "NovaHub_"..p:gsub("[/\\]","_") end
    function Window:SaveConfig(folder,filename)
        local data={}
        for k,e in pairs(configSave) do
            local v=e.get()
            if typeof(v)=="EnumItem" then data[k]={t="enum",v=tostring(v)}
            elseif typeof(v)=="boolean" then data[k]={t="boolean",v=v}
            else data[k]={t="string",v=tostring(v or "")} end
        end
        local ok,json=pcall(function() return HttpService:JSONEncode(data) end)
        if ok then pcall(writefile,cfgPath(folder.."/"..filename),json) end
    end
    function Window:LoadConfig(path)
        local ok,raw=pcall(readfile,cfgPath(path)); if not ok or not raw then return end
        local dok,data=pcall(function() return HttpService:JSONDecode(raw) end)
        if not dok or type(data)~="table" then return end
        for k,info in pairs(data) do
            local e=configSave[k]; if e then
                if info.t=="boolean" then e.set(info.v==true or info.v=="true")
                elseif info.t=="enum" then local pts=string.split(info.v,"."); pcall(function() e.set(Enum[pts[2]][pts[3]]) end)
                else e.set(info.v) end
            end
        end
    end
    function Window:GetConfig(path) local ok,raw=pcall(readfile,cfgPath(path)); if ok and raw then pcall(setclipboard,raw) end end
    function Window:InputConfig(path,text) if not text or text=="" then return end; pcall(writefile,cfgPath(path),text); Window:LoadConfig(path) end
    function Window:IsLoadConfig(path) local ok=pcall(function() readfile(cfgPath(path)) end); if ok then Window:LoadConfig(path) end end

