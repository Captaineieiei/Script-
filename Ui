    -- ══════════════════════════════════════════════════════
    --  TAB SWITCH  (slide transition)
    -- ══════════════════════════════════════════════════════
    local function SwitchTab(newTab)
        if ActiveTab == newTab or switching then return end
        switching = true

        for _, t in ipairs(Tabs) do
            local active = (t == newTab)
            Tween(t.Button, 0.18, {
                BackgroundTransparency = active and 0.5 or 1,
                BackgroundColor3       = T.Accent,
            }):Play()
            local lbl = t.Button:FindFirstChildWhichIsA("TextLabel")
            if lbl then
                Tween(lbl, 0.18, {
                    TextColor3 = active and Color3.fromRGB(255, 248, 255) or T.TextDim
                }):Play()
            end
            Tween(t.Underline, 0.18, {BackgroundTransparency = active and 0 or 1}):Play()
        end

        local oldIndex, newIndex = 0, 0
        for i, t in ipairs(Tabs) do
            if t == ActiveTab then oldIndex = i end
            if t == newTab    then newIndex = i end
        end
        local dir = (newIndex > oldIndex) and 1 or -1

        local oldTab = ActiveTab
        ActiveTab    = newTab

        if oldTab then
            Tween(oldTab.Frame, 0.18, {Position = UDim2.new(-dir, 0, 0, 0)},
                  Enum.EasingStyle.Quad, Enum.EasingDirection.In):Play()
            task.wait(0.18)
            oldTab.Frame.Visible   = false
            oldTab.Frame.Position  = UDim2.new(0, 0, 0, 0)
        end

        newTab.Frame.Position = UDim2.new(dir, 0, 0, 0)
        newTab.Frame.Visible  = true
        Tween(newTab.Frame, 0.22, {Position = UDim2.new(0, 0, 0, 0)},
              Enum.EasingStyle.Quad, Enum.EasingDirection.Out):Play()
        task.wait(0.22)
        switching = false
    end

    -- ══════════════════════════════════════════════════════
    --  AddTab
    -- ══════════════════════════════════════════════════════
    function Window:AddTab(tabId, tabName)
        local TabData = { Elements = {}, id = tabId }
        local isFirst = (#Tabs == 0)

        -- Tab button
        local TabBtn = Instance.new("TextButton")
        TabBtn.Parent              = TabBar
        TabBtn.BackgroundColor3    = T.Accent
        TabBtn.BackgroundTransparency = isFirst and 0.5 or 1
        TabBtn.BorderSizePixel     = 0
        TabBtn.Size                = UDim2.new(0, 82, 1, -4)
        TabBtn.Font                = Enum.Font.GothamSemibold
        TabBtn.Text                = tabName or tabId
        TabBtn.TextColor3          = isFirst and Color3.fromRGB(255, 248, 255) or T.TextDim
        TabBtn.TextSize            = 11
        TabBtn.AutoButtonColor     = false
        TabBtn.ZIndex              = 2
        Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 6)

        -- Underline
        local Underline = Instance.new("Frame")
        Underline.Parent              = TabBtn
        Underline.BackgroundColor3    = T.AccLt
        Underline.BorderSizePixel     = 0
        Underline.Position            = UDim2.new(0.1, 0, 1, -2)
        Underline.Size                = UDim2.new(0.8, 0, 0, 2)
        Underline.BackgroundTransparency = isFirst and 0 or 1
        Underline.ZIndex              = 3
        Instance.new("UICorner", Underline).CornerRadius = UDim.new(1, 0)

        TabData.Button    = TabBtn
        TabData.Underline = Underline

        TabBtn.MouseEnter:Connect(function()
            if ActiveTab ~= TabData then
                Tween(TabBtn, 0.12, {BackgroundTransparency = 0.78}):Play()
            end
        end)
        TabBtn.MouseLeave:Connect(function()
            if ActiveTab ~= TabData then
                Tween(TabBtn, 0.12, {BackgroundTransparency = 1}):Play()
            end
        end)
        TabBtn.MouseButton1Click:Connect(function() SwitchTab(TabData) end)

        -- Scrolling content frame
        local TabFrame = Instance.new("ScrollingFrame")
        TabFrame.Name                 = "Tab_" .. (tabName or tabId)
        TabFrame.Parent               = ContentArea
        TabFrame.BackgroundTransparency = 1
        TabFrame.BorderSizePixel      = 0
        TabFrame.Position             = UDim2.new(0, 0, 0, 0)
        TabFrame.Size                 = UDim2.new(1, 0, 1, 0)
        TabFrame.CanvasSize           = UDim2.new(0, 0, 0, 0)
        TabFrame.AutomaticCanvasSize  = Enum.AutomaticSize.Y
        TabFrame.ScrollBarThickness   = 3
        TabFrame.ScrollBarImageColor3 = T.Accent
        TabFrame.Visible              = isFirst

        do
            local l = Instance.new("UIListLayout")
            l.Parent              = TabFrame
            l.HorizontalAlignment = Enum.HorizontalAlignment.Center
            l.SortOrder           = Enum.SortOrder.LayoutOrder
            l.Padding             = UDim.new(0, 6)
        end
        do
            local p = Instance.new("UIPadding")
            p.Parent        = TabFrame
            p.PaddingTop    = UDim.new(0, 8)
            p.PaddingLeft   = UDim.new(0, 10)
            p.PaddingRight  = UDim.new(0, 10)
            p.PaddingBottom = UDim.new(0, 8)
        end

        TabData.Frame = TabFrame
        if isFirst then ActiveTab = TabData end
        table.insert(Tabs, TabData)

        -- ── Shared element base builder ───────────────────
        local function MakeRow(h, noAccent)
            local Row = Instance.new("Frame")
            Row.Parent           = TabFrame
            Row.BackgroundColor3 = T.Elem
            Row.BorderSizePixel  = 0
            Row.Size             = UDim2.new(1, 0, 0, h or 36)
            Instance.new("UICorner", Row).CornerRadius = UDim.new(0, 7)
            do
                local s = Instance.new("UIStroke")
                s.Color       = T.Border
                s.Thickness   = 1
                s.Transparency = 0.45
                s.Parent      = Row
            end
            if noAccent then return Row, nil end
            local Acc = Instance.new("Frame")
            Acc.Parent                = Row
            Acc.BackgroundColor3      = T.AccLt
            Acc.BorderSizePixel       = 0
            Acc.Position              = UDim2.new(0, 0, 0.18, 0)
            Acc.Size                  = UDim2.new(0, 3, 0.64, 0)
            Acc.BackgroundTransparency = 0.6
            Instance.new("UICorner", Acc).CornerRadius = UDim.new(1, 0)
            return Row, Acc
        end

        local function NameDesc(parent, name, desc, descH)
            descH = descH or 26
            local nameY  = (desc and desc ~= "") and 6 or 0
            local lblH   = (desc and desc ~= "") and 18 or 36

            local N = Instance.new("TextLabel")
            N.Parent              = parent
            N.BackgroundTransparency = 1
            N.Position            = UDim2.new(0, 12, 0, nameY)
            N.Size                = UDim2.new(1, -90, 0, 18)
            N.Font                = Enum.Font.GothamSemibold
            N.Text                = name
            N.TextColor3          = T.Text
            N.TextSize            = 13
            N.TextXAlignment      = Enum.TextXAlignment.Left

            if desc and desc ~= "" then
                local D = Instance.new("TextLabel")
                D.Parent              = parent
                D.BackgroundTransparency = 1
                D.Position            = UDim2.new(0, 12, 0, descH)
                D.Size                = UDim2.new(1, -90, 0, 14)
                D.Font                = Enum.Font.Gotham
                D.Text                = desc
                D.TextColor3          = T.TextDim
                D.TextSize            = 10
                D.TextXAlignment      = Enum.TextXAlignment.Left
            end
        end

