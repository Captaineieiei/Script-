            local Panel=Instance.new("Frame"); Panel.Parent=ScreenGui; Panel.BackgroundColor3=T.TopBar; Panel.BorderSizePixel=0; Panel.ZIndex=25; Panel.Visible=false
            Instance.new("UICorner",Panel).CornerRadius=UDim.new(0,7)
            local PStroke=Instance.new("UIStroke"); PStroke.Color=T.Accent; PStroke.Thickness=1; PStroke.Transparency=0.45; PStroke.Parent=Panel
            RegTheme(function(t) if Panel.Parent then Panel.BackgroundColor3=t.TopBar; PStroke.Color=t.Accent end end)
            Instance.new("UIListLayout",Panel).SortOrder=Enum.SortOrder.LayoutOrder
            local OPT_H=26; local optBtns={}
            for _,opt in ipairs(options) do
                local OB=Instance.new("TextButton"); OB.Parent=Panel; OB.BackgroundColor3=T.Elem
                OB.BackgroundTransparency=opt==selected and 0.25 or 1; OB.BorderSizePixel=0; OB.Size=UDim2.new(1,0,0,OPT_H)
                OB.Font=Enum.Font.GothamSemibold; OB.Text="  "..opt; OB.TextColor3=opt==selected and T.AccLt or T.Text
                OB.TextSize=11; OB.TextXAlignment=Enum.TextXAlignment.Left; OB.ZIndex=26; OB.AutoButtonColor=false
                optBtns[opt]=OB
                RegTheme(function(t) if OB.Parent then OB.BackgroundColor3=t.Elem; OB.TextColor3=(opt==selected) and t.AccLt or t.Text end end)
                OB.MouseEnter:Connect(function() Tween(OB,0.1,{BackgroundTransparency=0.45}):Play() end)
                OB.MouseLeave:Connect(function() Tween(OB,0.1,{BackgroundTransparency=opt==selected and 0.25 or 1}):Play() end)
                OB.MouseButton1Click:Connect(function()
                    for on,btn in pairs(optBtns) do btn.BackgroundTransparency=1; btn.TextColor3=T.Text end
                    OB.BackgroundTransparency=0.25; Tween(OB,0.1,{TextColor3=T.AccLt}):Play()
                    selected=opt; SelLbl.Text=opt; isOpen=false; Panel.Visible=false; pcall(callback,opt)
                end)
            end
            local function openPanel()
                local abs=Row.AbsolutePosition; local absS=Row.AbsoluteSize
                Panel.Position=UDim2.new(0,abs.X,0,abs.Y+absS.Y+3); Panel.Size=UDim2.new(0,absS.X,0,math.min(#options,5)*OPT_H); Panel.Visible=true
            end
            local function closePanel() isOpen=false; Panel.Visible=false end
            table.insert(openDropdowns, closePanel)
            local CB=Instance.new("TextButton"); CB.Parent=Row; CB.BackgroundTransparency=1; CB.Size=UDim2.new(1,0,1,0); CB.Text=""; CB.ZIndex=2
            CB.MouseButton1Click:Connect(function() isOpen=not isOpen; if isOpen then openPanel() else closePanel() end end)
            UserInputService.InputBegan:Connect(function(inp)
                if (inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch) and isOpen then
                    task.wait(); local mp=inp.Position; local pp=Panel.AbsolutePosition; local ps=Panel.AbsoluteSize
                    if not(mp.X>=pp.X and mp.X<=pp.X+ps.X and mp.Y>=pp.Y and mp.Y<=pp.Y+ps.Y) then closePanel() end
                end
