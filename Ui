        TabBtn.TextColor3=isFirst and Color3.fromRGB(255,248,255) or T.TextDim; TabBtn.TextSize=11
        TabBtn.AutoButtonColor=false; TabBtn.ZIndex=2
        Instance.new("UICorner",TabBtn).CornerRadius=UDim.new(0,6)

        local Underline=Instance.new("Frame"); Underline.Parent=TabBtn; Underline.BackgroundColor3=T.AccLt
        Underline.BorderSizePixel=0; Underline.Position=UDim2.new(0.1,0,1,-2); Underline.Size=UDim2.new(0.8,0,0,2)
