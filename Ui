            if noAccent then return Row,nil end
            local Acc=Instance.new("Frame"); Acc.Parent=Row; Acc.BackgroundColor3=T.AccLt; Acc.BorderSizePixel=0
            Acc.Position=UDim2.new(0,0,0.18,0); Acc.Size=UDim2.new(0,3,0.64,0); Acc.BackgroundTransparency=0.6
            Instance.new("UICorner",Acc).CornerRadius=UDim.new(1,0)
            RegTheme(function(t) if Acc.Parent then Acc.BackgroundColor3=t.AccLt end end)
