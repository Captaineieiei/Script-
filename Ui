        Tween(NF, 0.28, {Size = UDim2.new(1, 0, 0, 60)}, Enum.EasingStyle.Back, Enum.EasingDirection.Out):Play()
        task.wait(0.28)
        Tween(PB, duration, {Size = UDim2.new(0, 0, 0, 2)}, Enum.EasingStyle.Linear):Play()
        task.delay(duration, function()
            Tween(NF, 0.25, {Size = UDim2.new(1, 0, 0, 0)}):Play()
            task.wait(0.28)
            NF:Destroy()
        end)
    end

    -- ── Config helpers ─────────────────────────────────────
    local function cfgPath(path)
        return "NovaHub_" .. path:gsub("[/\\]", "_")
    end

    function Window:SaveConfig(folder, filename)
        local data = {}
        for k, e in pairs(configSave) do
            local v = e.get()
            if typeof(v) == "EnumItem" then
                data[k] = {t = "enum", v = tostring(v)}
            elseif typeof(v) == "boolean" then
                data[k] = {t = "boolean", v = v}
            else
                data[k] = {t = "string", v = tostring(v or "")}
            end
        end
        local ok, json = pcall(function() return HttpService:JSONEncode(data) end)
        if ok then pcall(writefile, cfgPath(folder .. "/" .. filename), json) end
    end

    function Window:LoadConfig(path)
        local ok, raw = pcall(readfile, cfgPath(path))
        if not ok or not raw then return end
        local dok, data = pcall(function() return HttpService:JSONDecode(raw) end)
        if not dok or type(data) ~= "table" then return end
        for k, info in pairs(data) do
            local e = configSave[k]
            if e then
                if info.t == "boolean" then
                    e.set(info.v == true or info.v == "true")
                elseif info.t == "enum" then
                    local parts = string.split(info.v, ".")
                    pcall(function() e.set(Enum[parts[2]][parts[3]]) end)
                else
                    e.set(info.v)
                end
            end
        end
    end

    function Window:GetConfig(path)
        local ok, raw = pcall(readfile, cfgPath(path))
        if ok and raw then pcall(setclipboard, raw) end
    end

    function Window:InputConfig(path, text)
        if not text or text == "" then return end
        pcall(writefile, cfgPath(path), text)
        Window:LoadConfig(path)
    end

    function Window:IsLoadConfig(path)
        local ok = pcall(function() readfile(cfgPath(path)) end)
        if ok then Window:LoadConfig(path) end
    end

    -- ══════════════════════════════════════════════════════
    --  LOADING SEQUENCE
    -- ══════════════════════════════════════════════════════
    local loadSteps = {
        { text = "Initializing...",       pct = 0.15 },
        { text = "Loading modules...",    pct = 0.40 },
        { text = "Building interface...", pct = 0.65 },
        { text = "Applying theme...",     pct = 0.88 },
        { text = "Ready!",                pct = 1.00 },
    }

    local glowAlive = true
    task.spawn(function()
        while glowAlive do
            Tween(GlowRing, 0.85, {BackgroundTransparency = 0.50},
                  Enum.EasingStyle.Sine, Enum.EasingDirection.InOut):Play()
            task.wait(0.85)
            if not glowAlive then break end
            Tween(GlowRing, 0.85, {BackgroundTransparency = 0.78},
                  Enum.EasingStyle.Sine, Enum.EasingDirection.InOut):Play()
            task.wait(0.85)
        end
    end)

    task.spawn(function()
        for _, step in ipairs(loadSteps) do
            StatusTxt.Text = step.text
            local tw = Tween(ProgFill, 0.32, {Size = UDim2.new(step.pct, 0, 1, 0)})
            tw:Play(); tw.Completed:Wait()
            task.wait(0.22)
        end
        task.wait(0.35)
        glowAlive = false
        Tween(Load, 0.45, {BackgroundTransparency = 1}):Play()
        for _, obj in ipairs({GlowRing, LogoCircle, ProgBG, ProgFill}) do
            Tween(obj, 0.35, {BackgroundTransparency = 1}):Play()
        end
        for _, obj in ipairs({LogoN, LoadTitle, LoadSub, StatusTxt}) do
            Tween(obj, 0.35, {TextTransparency = 1}):Play()
        end
        task.wait(0.48)
        Load:Destroy()
        MainFrame.Visible = true
        MainFrame.Size    = UDim2.new(0, winWidth - 40, 0, winHeight - 35)
        Tween(MainFrame, 0.38, {Size = UDim2.new(0, winWidth, 0, winHeight)},
              Enum.EasingStyle.Back, Enum.EasingDirection.Out):Play()
    end)

    return Window
end

