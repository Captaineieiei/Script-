        cfg = cfg or {}
        local name     = cfg.Name        or "Notification"
        local desc     = cfg.Description or ""
        local nType    = cfg.Type        or "Notification"
        local duration = cfg.Duration    or 5

        local typeColors = {
            Notification = T.Accent,
            Info         = Color3.fromRGB(60,  140, 255),
            Warning      = Color3.fromRGB(255, 180, 30),
            Error        = Color3.fromRGB(220, 60,  60),
            Success      = Color3.fromRGB(50,  200, 100),
        }
        local accent = typeColors[nType] or T.Accent

        local NF = Instance.new("Frame")
        NF.Parent           = NotifContainer
        NF.BackgroundColor3 = T.Elem
        NF.BorderSizePixel  = 0
        NF.Size             = UDim2.new(1, 0, 0, 0)
        NF.ClipsDescendants = true
        NF.ZIndex           = 30
