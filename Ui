        end

        local Bar = Instance.new("Frame")
        Bar.Parent           = NF
        Bar.BackgroundColor3 = accent
        Bar.BorderSizePixel  = 0
        Bar.Position         = UDim2.new(0, 0, 0, 0)
        Bar.Size             = UDim2.new(0, 3, 1, 0)
        Bar.ZIndex           = 31
        Instance.new("UICorner", Bar).CornerRadius = UDim.new(0, 8)

        local NT = Instance.new("TextLabel")
        NT.Parent              = NF
        NT.BackgroundTransparency = 1
        NT.Position            = UDim2.new(0, 12, 0, 6)
        NT.Size                = UDim2.new(1, -16, 0, 16)
        NT.Font                = Enum.Font.GothamBold
        NT.Text                = name
        NT.TextColor3          = Color3.fromRGB(240, 235, 255)
        NT.TextSize            = 12
        NT.TextXAlignment      = Enum.TextXAlignment.Left
        NT.ZIndex              = 31

        local ND = Instance.new("TextLabel")
        ND.Parent              = NF
        ND.BackgroundTransparency = 1
        ND.Position            = UDim2.new(0, 12, 0, 22)
        ND.Size                = UDim2.new(1, -16, 0, 28)
        ND.Font                = Enum.Font.Gotham
        ND.Text                = desc
        ND.TextColor3          = T.TextDim
        ND.TextSize            = 10
        ND.TextXAlignment      = Enum.TextXAlignment.Left
        ND.TextWrapped         = true
        ND.ZIndex              = 31

        local PB = Instance.new("Frame")
        PB.Parent           = NF
        PB.BackgroundColor3 = accent
        PB.BackgroundTransparency = 0.5
        PB.BorderSizePixel  = 0
        PB.Position         = UDim2.new(0, 0, 1, -2)
        PB.Size             = UDim2.new(1, 0, 0, 2)
        PB.ZIndex           = 32
