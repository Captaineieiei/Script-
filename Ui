            hideKey=Enum.KeyCode.RightShift
            S:AddDropdown({Name="ปุ่ม Keyboard (PC)",Description="กด key นี้เพื่อสลับซ่อน/แสดง UI บน PC",
                Options={"RightShift","LeftShift","RightControl","LeftControl","RightAlt","LeftAlt","Tab","CapsLock","Backspace","Delete","Insert","Home","End","PageUp","PageDown","F1","F2","F3","F4","F5","F6","F7","F8","F9","F10","F11","F12","Keypad0","Keypad1","Keypad2","Keypad3","Keypad4","Keypad5","Keypad6","Keypad7","Keypad8","Keypad9"},
                Default="RightShift",
                Callback=function(selected)
                    local ok,kc=pcall(function() return Enum.KeyCode[selected] end)
                    if ok and typeof(kc)=="EnumItem" then hideKey=kc end
                end})
        end
        S:AddButton({Name="ซ่อน UI ตอนนี้",Description="กดปุ่ม ☰ ที่ลอยอยู่เพื่อแสดงคืน",
            Callback=function() Window:ToggleVisible() end})

        S:AddSection("หน้าต่าง")
        S:AddToggle({Name="Blur",Description="เบลอพื้นหลัง (Graphics 8+)",Callback=function(state) if state then Window:Blur() else Window:BlurOff() end end})
        S:AddToggle({Name="โปร่งใส",Description="เปลี่ยนความโปร่งใสพื้นหลัง",Callback=function() Window:ChangeBackgroundTransparance() end})
        S:AddButton({Name="ย่อ / ขยาย",Description="Toggle minimize window",Callback=function() Window:Minimaze() end})
        S:AddButton({Name="ข้อมูลผู้ใช้",Description="Name / DisplayName / UserID",Callback=function() Window:UserInfo() end})
        S:AddButton({Name="ปิดหน้าต่าง",Description="ลบ UI ออกจากหน้าจอ",Callback=function() Window:Close() end})
    end)

    -- ══ LOADING SEQUENCE ══
    local loadSteps={{text="Initializing...",pct=0.15},{text="Loading modules...",pct=0.40},{text="Building interface...",pct=0.65},{text="Applying theme...",pct=0.88},{text="Ready!",pct=1.00}}
    local glowAlive=true
    task.spawn(function()
        while glowAlive do
            Tween(GlowRing,0.85,{BackgroundTransparency=0.50},Enum.EasingStyle.Sine,Enum.EasingDirection.InOut):Play(); task.wait(0.85); if not glowAlive then break end
            Tween(GlowRing,0.85,{BackgroundTransparency=0.78},Enum.EasingStyle.Sine,Enum.EasingDirection.InOut):Play(); task.wait(0.85)
        end
    end)
    task.spawn(function()
        for _,step in ipairs(loadSteps) do
            StatusTxt.Text=step.text; local tw=Tween(ProgFill,0.32,{Size=UDim2.new(step.pct,0,1,0)}); tw:Play(); tw.Completed:Wait(); task.wait(0.22)
        end
        task.wait(0.35); glowAlive=false
        Tween(Load,0.45,{BackgroundTransparency=1}):Play()
        for _,obj in ipairs({GlowRing,LogoCircle,ProgBG,ProgFill}) do Tween(obj,0.35,{BackgroundTransparency=1}):Play() end
        for _,obj in ipairs({LogoN,LoadTitle,LoadSub,StatusTxt}) do Tween(obj,0.35,{TextTransparency=1}):Play() end
        task.wait(0.48); Load:Destroy()
        MainFrame.Visible=true; MainFrame.Size=UDim2.new(0,winWidth-40,0,winHeight-35)
        Tween(MainFrame,0.38,{Size=UDim2.new(0,winWidth,0,winHeight)},Enum.EasingStyle.Back,Enum.EasingDirection.Out):Play()
    end)

    return Window
end

return UILibrary
