            Tween(t.Button,0.18,{BackgroundTransparency=active and 0.5 or 1,BackgroundColor3=T.Accent}):Play()
            local lbl=t.Button:FindFirstChildWhichIsA("TextLabel")
            if lbl then Tween(lbl,0.18,{TextColor3=active and Color3.fromRGB(255,248,255) or T.TextDim}):Play() end
            Tween(t.Underline,0.18,{BackgroundTransparency=active and 0 or 1}):Play()
        end
        local oldIdx,newIdx=0,0
        for i,t in ipairs(Tabs) do
            if t==ActiveTab then oldIdx=i end
            if t==newTab then newIdx=i end
        end
        local dir=(newIdx>oldIdx) and 1 or -1
        local oldTab=ActiveTab; ActiveTab=newTab
        if oldTab then
            Tween(oldTab.Frame,0.18,{Position=UDim2.new(-dir,0,0,0)},Enum.EasingStyle.Quad,Enum.EasingDirection.In):Play()
            task.wait(0.18); oldTab.Frame.Visible=false; oldTab.Frame.Position=UDim2.new(0,0,0,0)
        end
        newTab.Frame.Position=UDim2.new(dir,0,0,0); newTab.Frame.Visible=true
        Tween(newTab.Frame,0.22,{Position=UDim2.new(0,0,0,0)},Enum.EasingStyle.Quad,Enum.EasingDirection.Out):Play()
        task.wait(0.22); switching=false
    end

