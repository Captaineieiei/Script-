        TabBtn.MouseEnter:Connect(function() if ActiveTab~=TabData then Tween(TabBtn,0.12,{BackgroundTransparency=0.78}):Play() end end)
        TabBtn.MouseLeave:Connect(function() if ActiveTab~=TabData then Tween(TabBtn,0.12,{BackgroundTransparency=1}):Play() end end)
        TabBtn.MouseButton1Click:Connect(function() SwitchTab(TabData) end)

        local TabFrame=Instance.new("ScrollingFrame"); TabFrame.Name="Tab_"..(tabName or tabId); TabFrame.Parent=ContentArea
        TabFrame.BackgroundTransparency=1; TabFrame.BorderSizePixel=0; TabFrame.Position=UDim2.new(0,0,0,0)
        TabFrame.Size=UDim2.new(1,0,1,0); TabFrame.CanvasSize=UDim2.new(0,0,0,0); TabFrame.AutomaticCanvasSize=Enum.AutomaticSize.Y
        TabFrame.ScrollBarThickness=3; TabFrame.ScrollBarImageColor3=T.Accent; TabFrame.Visible=isFirst
        do local l=Instance.new("UIListLayout"); l.Parent=TabFrame; l.HorizontalAlignment=Enum.HorizontalAlignment.Center; l.SortOrder=Enum.SortOrder.LayoutOrder; l.Padding=UDim.new(0,6) end
        do local p=Instance.new("UIPadding"); p.Parent=TabFrame; p.PaddingTop=UDim.new(0,8); p.PaddingLeft=UDim.new(0,10); p.PaddingRight=UDim.new(0,10); p.PaddingBottom=UDim.new(0,8) end

