        local TabBtn=Instance.new("TextButton"); TabBtn.Parent=TabBar; TabBtn.BackgroundColor3=T.Accent
        TabBtn.BackgroundTransparency=isFirst and 0.5 or 1; TabBtn.BorderSizePixel=0
