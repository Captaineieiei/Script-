-- ─────────────────────────────────────────
local function parseApiError(message)
    local m = tostring(message or ""):lower()
    if m:find("expired")       then return "Key has expired — please redeem a new key" end
    if m:find("hwid mismatch") then return "HWID mismatch — key is bound to another device" end
    if m:find("blacklist")     then return "Key has been blacklisted" end
    if m:find("not found")     then return "Key not found in the system" end
    if m:find("not activated") then return "Key is not activated yet" end
    if m:find("already")       then return "Key has already been redeemed" end
    return "Invalid key: "..tostring(message or "unknown")
end

-- ─────────────────────────────────────────
--  SAFE HTTP
-- ─────────────────────────────────────────
local function safeGet(url)
    local ok, res = pcall(httpSend, { Url=url, Method="GET" })
    if ok and res then
        local body = res.Body or res.body or ""
        if body ~= "" then return true, body end
    end
    local errStr = tostring(res or "")
    local j = errStr:find("{")
    if j then return true, errStr:sub(j) end
    return false, errStr
end

