local CHECK_INTERVAL = 300  -- 5 นาที (วินาที)

task.spawn(function()
    while task.wait(CHECK_INTERVAL) do
        local cOk, cRaw = safeGet(API.."/api/lookup?key="..KEY.."&hwid="..getHWID())
        if not cOk or not cRaw or cRaw == "" then
            -- API ตอบไม่ได้ชั่วคราว — ข้ามรอบนี้ (ไม่ kick)
        else
            local cok2, cresult = pcall(HS.JSONDecode, HS, cRaw)
            if cok2 and type(cresult) == "table" then
                local expired = false

                if cresult.success ~= true and cresult.success ~= "true" then
                    expired = true
                end

                if not expired and type(cresult.data) == "table" then
                    local ea = cresult.data.expiresAt
                    if ea ~= nil and ea ~= -1 then
                        if math.floor(ea) - os.time() * 1000 <= 0 then
                            expired = true
                        end
                    end
                end

                if expired then
                    log("⛔  Key หมดอายุแล้ว — กำลัง Kick...","error")
                    task.wait(2)
                    pcall(function()
                        sendWebhook({ key=KEY, hwid=getHWID(), timeLeft="EXPIRED — SESSION ENDED" })
                    end)
                    task.wait(1)
                    PL:Kick("[ SpectreWare ]  Key ของคุณหมดอายุแล้ว\nกรุณา Redeem Key ใหม่ใน Discord")
                    return
                end
            end
        end
    end
end)
