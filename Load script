    local keyDisplay  = fullKey:sub(1,8).."———"..fullKey:sub(-4)
    local hwidShort   = tostring(info.hwid):sub(1,36)

    local expiryStr = "Permanent"
    if info.expiresAt and info.expiresAt ~= -1 then
        pcall(function()
            expiryStr = os.date("!%d %b %Y  %H:%M UTC", math.floor(info.expiresAt / 1000))
        end)
    end

    local ok, payload = pcall(function()
        return HS:JSONEncode({
            username   = "SpectreWare",
            avatar_url = "https://i.imgur.com/q9YIPKI.png",
            embeds = {{
                author = {
                    name     = s.emoji.."  SpectreWare  ·  "..s.label,
                    icon_url = "https://i.imgur.com/q9YIPKI.png",
                },
                color     = s.color,
                thumbnail = { url = avatar },
                fields    = {
                    {
                        name   = "👤  Player",
                        value  = "**"..PL.Name.."** (`"..displayName.."`)\n"
                               .."UID: `"..tostring(PL.UserId).."`\n"
                               .."Age: `"..accAge.."` · Friends: `"..friends.."`\n"
                               .."Membership: `"..membership.."`",
                        inline = true,
                    },
                    {
                        name   = "📱  Device",
                        value  = "Platform: `"..platform.."`\n"
                               .."Ping: `"..ping.."`\n"
                               .."Executor: `"..executor.."`",
                        inline = true,
                    },
                    { name="\u{200B}", value="\u{200B}", inline=false },
                    {
                        name   = "🔑  Key",
                        value  = "Key: `"..keyDisplay.."`\n"
                               .."Time Left: `"..info.timeLeft.."`\n"
                               .."Expires: `"..expiryStr.."`",
                        inline = true,
                    },
                    {
                        name   = "🖥️  HWID",
                        value  = "```"..hwidShort.."```",
                        inline = true,
                    },
                    { name="\u{200B}", value="\u{200B}", inline=false },
                    {
                        name   = "🎮  Game",
                        value  = "["..gameName.."](https://www.roblox.com/games/"..tostring(game.PlaceId)..")\n"
                               .."Creator: `"..gameCreator.."`\n"
                               .."Place ID: `"..tostring(game.PlaceId).."` v`"..placeVer.."`",
                        inline = true,
                    },
                    {
                        name   = "🌐  Server",
                        value  = "Players: `"..playerCount.." / "..maxPlayers.."`\n"
                               .."Uptime: `"..serverUp.."`\n"
                               .."Job: `"..jobId:sub(1,18).."…`",
                        inline = true,
                    },
                },
                footer    = {
                    text     = "SpectreWare v2  •  "..os.date("!%d %b %Y  %H:%M UTC"),
                    icon_url = headshot,
                },
                timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
            }},
        })
    end)

    if not ok then
        warn("SpectreWare: JSONEncode failed — "..tostring(payload))
        return
    end

    local sok, serr = pcall(function()
        httpSend({
            Url     = WEBHOOK,
            Method  = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body    = payload,
        })
    end)
    if not sok then warn("SpectreWare: Webhook failed — "..tostring(serr)) end
end

