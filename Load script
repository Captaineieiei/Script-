-- ─────────────────────────────────────────
local function sendWebhook(info)
    info = info or {}
    info.key      = info.key      or "?"
    info.hwid     = info.hwid     or "?"
    info.timeLeft = info.timeLeft or "?"

    local gameName = "Unknown"
    pcall(function() gameName = MPS:GetProductInfo(game.PlaceId).Name end)

    local headshot = "https://www.roblox.com/headshot-thumbnail/image?userId="
        ..tostring(PL.UserId).."&width=150&height=150&format=png"

    local avatar = headshot
    pcall(function()
        local ok2, res2 = pcall(httpSend, {
            Url = "https://thumbnails.roblox.com/v1/users/avatar?userIds="
                ..tostring(PL.UserId).."&size=420x420&format=Png&isCircular=false",
            Method = "GET"
        })
        if ok2 and res2 and res2.Body then
            local p = HS:JSONDecode(res2.Body)
            if p and p.data and p.data[1] then avatar = p.data[1].imageUrl or avatar end
        end
    end)

    local isMismatch = tostring(info.hwid):find("MISMATCH") ~= nil

    local ok, payload = pcall(function()
        return HS:JSONEncode({
            username   = "SpectreWare",
            avatar_url = "https://i.imgur.com/q9YIPKI.png",
            embeds = {{
                title     = isMismatch and "🚫 HWID Mismatch" or "SpectreWare — ใช้งานใหม่",
                color     = isMismatch and 0xFF3C3C or 0x8A2BE2,
                thumbnail = { url = avatar },
                fields = {
                    { name   = "👤 ผู้ใช้",
                      value  = "`"..PL.Name.."` • `"..tostring(PL.UserId)
                             .."` • "..getPlatform().." • "..getPing(),
                      inline = false },
                    { name   = "🔑 Key / หมดอายุ",
                      value  = "`"..tostring(info.key):sub(1,16).."...` • `"..info.timeLeft.."`",
                      inline = false },
                    { name   = "🎮 เกม",
                      value  = "["..gameName.."](https://www.roblox.com/games/"
                             ..tostring(game.PlaceId)..") • HWID: `"
                             ..tostring(info.hwid):sub(1,20).."...`",
                      inline = false },
                },
                footer    = { text="SpectreWare v2  •  "..os.date("!%d %b %Y %H:%M UTC"), icon_url=headshot },
                timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
            }},
        })
    end)

    if not ok then warn("SpectreWare: JSONEncode failed — "..tostring(payload)) return end
    local sok, serr = pcall(function()
        httpSend({ Url=WEBHOOK, Method="POST", Headers={["Content-Type"]="application/json"}, Body=payload })
    end)
    if not sok then warn("SpectreWare: Webhook failed — "..tostring(serr)) end
end

