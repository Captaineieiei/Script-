local function getAvatar(userId)
    local headshot = "https://www.roblox.com/headshot-thumbnail/image?userId="
        ..tostring(userId).."&width=150&height=150&format=png"
    local full = headshot
    pcall(function()
        local res = httpSend({
            Url    = "https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds="
                   ..tostring(userId).."&size=420x420&format=Png&isCircular=false",
            Method = "GET",
        })
        if res and res.Body then
            local d = HS:JSONDecode(res.Body)
            if d and d.data and d.data[1] then full = d.data[1].imageUrl or headshot end
        end
    end)
    return full, headshot
end

