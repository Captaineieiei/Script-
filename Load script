    timeTxt.Size                 = UDim2.new(1, 0, 1, 0)
    timeTxt.BackgroundTransparency = 1
    timeTxt.Text                 = "⏳  Expires:  " .. timeLeft
    timeTxt.TextColor3           = C.sub
    timeTxt.Font                 = Enum.Font.Gotham
    timeTxt.TextSize             = 12
    timeTxt.TextXAlignment       = Enum.TextXAlignment.Left
    timeTxt.ZIndex               = 5
    timeTxt.Parent               = timeRow

    -- ── Launch button ─────────────────────
    local launchBtn = Instance.new("TextButton")
    launchBtn.Size             = UDim2.new(1, 0, 0, 38)
    launchBtn.Position         = UDim2.new(0, 0, 0, 214)
    launchBtn.BackgroundColor3 = C.accent
    launchBtn.Text             = "▶  Launch Script"
    launchBtn.TextColor3       = C.white
    launchBtn.Font             = Enum.Font.GothamBold
    launchBtn.TextSize         = 14
    launchBtn.BorderSizePixel  = 0
    launchBtn.ZIndex           = 4
    launchBtn.Parent           = body
    Instance.new("UICorner", launchBtn).CornerRadius = UDim.new(0, 9)

    -- Hover effect
    launchBtn.MouseEnter:Connect(function()
        TW:Create(launchBtn, TweenInfo.new(0.15), { BackgroundColor3 = C.accentL }):Play()
    end)
    launchBtn.MouseLeave:Connect(function()
        TW:Create(launchBtn, TweenInfo.new(0.15), { BackgroundColor3 = C.accent }):Play()
    end)

    -- ── Animate in ────────────────────────
    card.Position = UDim2.new(0.5, -185, 0.62, -155)
    overlay.BackgroundTransparency = 1
    TW:Create(overlay, TweenInfo.new(0.3), { BackgroundTransparency = 0.45 }):Play()
    TW:Create(card, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, -185, 0.5, -155),
    }):Play()

    -- ── Dismiss logic ─────────────────────
    local dismissed = false
    local function dismiss()
        if dismissed then return end
        dismissed = true
        TW:Create(overlay, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
        TW:Create(card, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(0.5, -185, 0.42, -155),
        }):Play()
        task.wait(0.28)
        gui:Destroy()
    end

    closeBtn.MouseButton1Click:Connect(dismiss)
    launchBtn.MouseButton1Click:Connect(dismiss)
    task.delay(10, dismiss)   -- auto-dismiss after 10 s
end

-- ─────────────────────────────────────────
--  MAIN
-- ─────────────────────────────────────────
task.wait(0.8)

if KEY == "" then
    log("No key found — set getgenv().KEY before running", "error")
    getgenv()._SpectreRunning = nil
    return
end

log("Reading key...", "loading") task.wait(1.0)
local hwid = getHWID()
log("HWID: "..tostring(hwid):sub(1,28).."...", "info") task.wait(0.8)

local callOk, raw
for i = 1, 3 do
    log(string.format("Connecting to API... (%d/3)", i), "loading")
    callOk, raw = safeGet(API.."/api/lookup?key="..KEY.."&hwid="..hwid)
    if callOk and raw and raw ~= "" then break end
    if i < 3 then task.wait(1.5) end
end

if not callOk or not raw or raw == "" then
    log("Cannot reach API — enable HTTP Requests or server is down", "error")
    getgenv()._SpectreRunning = nil
    return
end

log("API response received ✓", "info") task.wait(0.6)

local ok2, result = pcall(HS.JSONDecode, HS, raw)
if not ok2 or type(result) ~= "table" then
    log("API returned an invalid response (parse error)", "error")
    getgenv()._SpectreRunning = nil
    return
end

log("Verifying key...", "loading") task.wait(1.2)

if result.success ~= true and result.success ~= "true" then
    local reason = parseApiError(result.message)
    log(reason, "error")
    if tostring(result.message or ""):lower():find("expired") then
        task.spawn(function()
            sendWebhook("expired", { key=KEY, hwid=hwid, timeLeft="EXPIRED" })
        end)
        task.wait(2)
        PL:Kick("[ SpectreWare ]  Your key has expired.\nPlease redeem a new key in Discord.")
    end
    getgenv()._SpectreRunning = nil
    return
end

if type(result.data) ~= "table" then
    log("Incomplete data received from API", "error")
    getgenv()._SpectreRunning = nil
    return
end

local data = result.data
log("Verifying HWID...", "loading") task.wait(1.0)

if type(data.hwid) == "string" and data.hwid ~= "" then
    if data.hwid ~= hwid then
        log("HWID mismatch — key is bound to another device", "error")
        task.spawn(function()
            sendWebhook("mismatch", { key=KEY, hwid=hwid, timeLeft="BLOCKED" })
        end)
        getgenv()._SpectreRunning = nil
        task.wait(2)
        PL:Kick("[ SpectreWare ]  HWID Mismatch.\nKey นี้ผูกกับอุปกรณ์อื่น — ติดต่อ Discord.")
        return
    end
end
log("HWID verified ✓", "success") task.wait(0.8)

local timeLeft  = "Permanent"
local expiresAt = data.expiresAt

if expiresAt ~= nil and expiresAt ~= -1 then
    local diff = math.floor((expiresAt - os.time()*1000)/1000)
    if diff <= 0 then
        log("Key has already expired", "error")
        getgenv()._SpectreRunning = nil
        return
    end
    timeLeft = math.floor(diff/86400).."d "
             ..math.floor((diff%86400)/3600).."h "
             ..math.floor((diff%3600)/60).."m"
end

log("Expiry verified ✓", "success") task.wait(0.6)
summary(timeLeft, hwid) task.wait(0.5)

-- ── Show splash UI ────────────────────────
showSplashUI(KEY, hwid, timeLeft)
task.wait(0.5)
-- ─────────────────────────────────────────

task.spawn(function()
    sendWebhook("login", {
        key       = KEY,
        hwid      = hwid,
        timeLeft  = timeLeft,
        expiresAt = expiresAt,
    })
end)

if not SCRIPT then
    log("Map ID: "..tostring(game.PlaceId).." is not supported", "error")
    getgenv()._SpectreRunning = nil
    return
end

log("Loading script for Map: "..tostring(game.PlaceId), "loading") task.wait(1.2)
loadstring(game:HttpGet(SCRIPT, true))()
task.wait(0.4)
log("Script loaded successfully 🚀", "success")

-- ─────────────────────────────────────────
--  SESSION GUARD — checks every 10s
-- ─────────────────────────────────────────
local CHECK_INTERVAL = 10
local _sessionActive = true
local _conn

_conn = game:GetService("Players").PlayerRemoving:Connect(function(p)
    if p == PL then
        _sessionActive = false
        getgenv()._SpectreRunning = nil
        if _conn then _conn:Disconnect() end
    end
end)

task.spawn(function()
    while _sessionActive and task.wait(CHECK_INTERVAL) do
        if not PL or not PL.Parent then
            _sessionActive = false
            break
        end

        local cOk, cRaw = safeGet(API.."/api/lookup?key="..KEY.."&hwid="..getHWID())
        if cOk and cRaw and cRaw ~= "" then
            local cok2, cresult = pcall(HS.JSONDecode, HS, cRaw)
            if cok2 and type(cresult) == "table" then
                local expired = (cresult.success ~= true and cresult.success ~= "true")
                if not expired and type(cresult.data) == "table" then
                    local ea = cresult.data.expiresAt
                    if ea ~= nil and ea ~= -1 then
                        if math.floor(ea) - os.time()*1000 <= 0 then expired = true end
                    end
                end
                if expired then
                    _sessionActive = false
                    log("Key expired — kicking from session...", "error")
                    task.wait(2)
                    pcall(function()
                        sendWebhook("expired", {
                            key      = KEY,
                            hwid     = getHWID(),
                            timeLeft = "EXPIRED — SESSION ENDED",
                        })
                    end)
                    task.wait(1)
                    PL:Kick("[ SpectreWare ]  Your key has expired.\nPlease redeem a new key in Discord.")
                    getgenv()._SpectreRunning = nil
                    if _conn then _conn:Disconnect() end
                    return
                end
            end
        end
    end

    getgenv()._SpectreRunning = nil
    if _conn then _conn:Disconnect() end
end)
