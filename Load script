-- ─────────────────────────────────────────
--  PARSE API RESPONSE → แปลง message เป็น error ภาษาไทย
-- ─────────────────────────────────────────
local function parseApiError(message)
    local m = tostring(message or ""):lower()
    if m:find("expired")       then return "Key หมดอายุแล้ว — กรุณา Redeem Key ใหม่" end
    if m:find("hwid mismatch") then return "HWID ไม่ตรงกัน — Key ผูกกับอุปกรณ์อื่น" end
    if m:find("blacklist")     then return "Key ถูก Blacklist แล้ว" end
    if m:find("not found")     then return "ไม่พบ Key นี้ในระบบ" end
    if m:find("not activated") then return "Key ยังไม่ได้ Activate" end
    if m:find("already")       then return "Key ถูกใช้งานไปแล้ว" end
    return "Key ไม่ถูกต้อง: "..tostring(message or "unknown")
end

-- ─────────────────────────────────────────
--  SAFE HTTP — คืน body string ทั้งกรณี 2xx และ non-2xx
--  (exploit บางตัว throw error เมื่อ status != 200)
-- ─────────────────────────────────────────
local function safeGet(url)
    -- ลองดึงแบบปกติก่อน
    local ok, res = pcall(httpSend, { Url=url, Method="GET" })
    if ok and res then
        return true, res.Body or ""
    end

    -- ถ้า pcall fail อาจเป็น non-200 หรือ network error จริง
    -- ลอง parse error message ดูว่ามี JSON ซ่อนอยู่ไหม
    local errStr = tostring(res or "")
    -- บาง exploit ใส่ Body ไว้ใน error message เลย
    local jsonStart = errStr:find("{")
    if jsonStart then
        local body = errStr:sub(jsonStart)
        return true, body  -- ได้ body แม้ pcall fail
    end

    return false, errStr  -- network error จริง
end

