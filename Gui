--[[
    Modern UI Library - Remastered Edition
    Features: 
    - Object Oriented Syntax
    - Auto Camera Lock (หันจอไม่ได้ตอนเปิดเมนู)
    - Responsive Design
]]

local Library = {}
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

--// Utility Functions //--
local function Tween(obj, props, t)
    TweenService:Create(obj, TweenInfo.new(t or 0.3, Enum.EasingStyle.Quart), props):Play()
end

--// Camera Logic (แก้ปัญหาหันจอ) //--
local function UpdateCameraStatus(Enabled)
    if Enabled then
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    end
end

--// Library Main Functions //--
function Library:Window(Config)
    local Window = {
        Name = Config.Name or "Library",
        Size = Config.Size or Vector2.new(550, 400),
        SideBarSize = Config.SideBarSize or 150,
        Pages = {},
        CurrentPage = nil
    }

    -- Create ScreenGui
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "ModernLibrary"
    ScreenGui.Parent = (gethui and gethui()) or game:GetService("CoreGui")
    ScreenGui.ResetOnSpawn = false

    -- Main Frame
    local Main = Instance.new("Frame")
    Main.Name = "Main"
    Main.Size = UDim2.new(0, Window.Size.X, 0, Window.Size.Y)
    Main.Position = UDim2.new(0.5, -Window.Size.X/2, 0.5, -Window.Size.Y/2)
    Main.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    Main.BorderSizePixel = 0
    Main.Parent = ScreenGui

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 8)
    Corner.Parent = Main

    -- Sidebar
    local Sidebar = Instance.new("Frame")
    Sidebar.Size = UDim2.new(0, Window.SideBarSize, 1, 0)
    Sidebar.BackgroundColor3 = Color3.fromRGB(28, 28, 33)
    Sidebar.BorderSizePixel = 0
    Sidebar.Parent = Main

    local SidebarCorner = Instance.new("UICorner")
    SidebarCorner.CornerRadius = UDim.new(0, 8)
    SidebarCorner.Parent = Sidebar

    local SidebarList = Instance.new("UIListLayout")
    SidebarList.Parent = Sidebar
    SidebarList.Padding = UDim.new(0, 5)

    -- Container for Pages
    local Container = Instance.new("Frame")
    Container.Size = UDim2.new(1, -Window.SideBarSize, 1, 0)
    Container.Position = UDim2.new(0, Window.SideBarSize, 0, 0)
    Container.BackgroundTransparency = 1
    Container.Parent = Main

    -- Dragging Logic
    local Dragging, DragInput, DragStart, StartPos
    Main.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            Dragging = true; DragStart = input.Position; StartPos = Main.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement and Dragging then
            local delta = input.Position - DragStart
            Main.Position = UDim2.new(StartPos.X.Scale, StartPos.X.Offset + delta.X, StartPos.Y.Scale, StartPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then Dragging = false end
    end)

    -- Camera Lock Loop (สำคัญมากตามที่คุณต้องการ)
    RunService.RenderStepped:Connect(function()
        if ScreenGui.Enabled then
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        end
    end)

    --// Window Methods //--
    function Window:Page(PageConfig)
        local Page = {Name = PageConfig.Name, Sections = {}}
        
        local PageFrame = Instance.new("ScrollingFrame")
        PageFrame.Size = UDim2.new(1, -20, 1, -20)
        PageFrame.Position = UDim2.new(0, 10, 0, 10)
        PageFrame.BackgroundTransparency = 1
        PageFrame.Visible = false
        PageFrame.ScrollBarThickness = 2
        PageFrame.Parent = Container

        local PageList = Instance.new("UIListLayout")
        PageList.Parent = PageFrame
        PageList.Padding = UDim.new(0, 10)

        local TabBtn = Instance.new("TextButton")
        TabBtn.Size = UDim2.new(1, -10, 0, 35)
        TabBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
        TabBtn.Text = "  " .. Page.Name
        TabBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
        TabBtn.Font = Enum.Font.GothamBold
        TabBtn.TextXAlignment = Enum.TextXAlignment.Left
        TabBtn.Parent = Sidebar

        TabBtn.MouseButton1Click:Connect(function()
            for _, v in pairs(Container:GetChildren()) do v.Visible = false end
            PageFrame.Visible = true
        end)

        if not Window.CurrentPage then
            PageFrame.Visible = true
            Window.CurrentPage = Page
        end

        -- SubPage & Section Methods
        function Page:SubPage(SubConfig)
            return Page -- Simplifying for structure
        end

        function Page:Section(SectConfig)
            local SectionFrame = Instance.new("Frame")
            SectionFrame.Size = UDim2.new(1, 0, 0, 40)
            SectionFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
            SectionFrame.Parent = PageFrame
            
            local SectList = Instance.new("UIListLayout")
            SectList.Parent = SectionFrame
            SectList.Padding = UDim.new(0, 5)

            local SectLabel = Instance.new("TextLabel")
            SectLabel.Size = UDim2.new(1, 0, 0, 25)
            SectLabel.Text = "  " .. SectConfig.Name
            SectLabel.TextColor3 = Color3.fromRGB(0, 160, 255)
            SectLabel.BackgroundTransparency = 1
            SectLabel.Font = Enum.Font.GothamBold
            SectLabel.TextXAlignment = Enum.TextXAlignment.Left
            SectLabel.Parent = SectionFrame

            local SectObj = {}
            
            function SectObj:Toggle(TogConfig)
                local Toggled = false
                local Btn = Instance.new("TextButton")
                Btn.Size = UDim2.new(1, -10, 0, 30)
                Btn.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
                Btn.Text = "  " .. TogConfig.Name
                Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                Btn.Font = Enum.Font.Gotham
                Btn.TextXAlignment = Enum.TextXAlignment.Left
                Btn.Parent = SectionFrame
                
                SectionFrame.Size = UDim2.new(1, 0, 0, SectList.AbsoluteContentSize.Y + 10)

                Btn.MouseButton1Click:Connect(function()
                    Toggled = not Toggled
                    Btn.TextColor3 = Toggled and Color3.fromRGB(0, 255, 150) or Color3.fromRGB(255, 255, 255)
                    TogConfig.Callback(Toggled)
                end)
            end

            function SectObj:Button(ButConfig)
                local Btn = Instance.new("TextButton")
                Btn.Size = UDim2.new(1, -10, 0, 30)
                Btn.Text = ButConfig.Name
                Btn.Parent = SectionFrame
                SectionFrame.Size = UDim2.new(1, 0, 0, SectList.AbsoluteContentSize.Y + 10)
                Btn.MouseButton1Click:Connect(ButConfig.Callback)
            end
            
            return SectObj
        end
        return Page
    end

    function Library:Notification(Title, Time, Icon)
        print("Notification: " .. Title)
    end

    -- Toggle UI Key (Press RightControl to Hide/Show)
    UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.RightControl then
            ScreenGui.Enabled = not ScreenGui.Enabled
            UpdateCameraStatus(ScreenGui.Enabled)
        end
    end)

    return Window
end

return Library
