--[[
    NOVA HUB EDITION - UI LIBRARY
    Optimized & Performance Focused
]]

local Library = {}
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

--// Theme Configuration (Nova Style) //--
local Theme = {
    Main = Color3.fromRGB(15, 15, 20),
    Secondary = Color3.fromRGB(20, 20, 27),
    Accent = Color3.fromRGB(130, 80, 255), -- Nova Purple
    AccentGlow = Color3.fromRGB(100, 50, 255),
    Text = Color3.fromRGB(240, 240, 250),
    TextDark = Color3.fromRGB(140, 140, 160)
}

--// Utility Functions //--
local function SmoothTween(obj, props, t)
    TweenService:Create(obj, TweenInfo.new(t or 0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props):Play()
end

function Library:Window(Config)
    local Window = {
        Pages = {},
        CurrentPage = nil,
        Enabled = true
    }

    -- Main GUI
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "NovaHub_Lib"
    ScreenGui.Parent = CoreGui
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.IgnoreGuiInset = true

    -- Camera Lock Handler (ล็อคการหันจอ)
    RunService.RenderStepped:Connect(function()
        if ScreenGui.Enabled then
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        end
    end)

    -- Main Frame
    local Main = Instance.new("Frame")
    Main.Name = "Main"
    Main.Size = UDim2.new(0, 550, 0, 380)
    Main.Position = UDim2.new(0.5, -275, 0.5, -190)
    Main.BackgroundColor3 = Theme.Main
    Main.BorderSizePixel = 0
    Main.Parent = ScreenGui

    local MainCorner = Instance.new("UICorner")
    MainCorner.CornerRadius = UDim.new(0, 10)
    MainCorner.Parent = Main

    -- Nova Glow Border (สวยแบบ Nova Hub)
    local Stroke = Instance.new("UIStroke")
    Stroke.Thickness = 1.5
    Stroke.Color = Theme.Accent
    Stroke.Transparency = 0.5
    Stroke.Parent = Main

    -- Sidebar (Navigation)
    local Sidebar = Instance.new("Frame")
    Sidebar.Size = UDim2.new(0, 160, 1, 0)
    Sidebar.BackgroundColor3 = Theme.Secondary
    Sidebar.BorderSizePixel = 0
    Sidebar.Parent = Main
    
    local SidebarCorner = Instance.new("UICorner")
    SidebarCorner.CornerRadius = UDim.new(0, 10)
    SidebarCorner.Parent = Sidebar

    local SidebarList = Instance.new("UIListLayout")
    SidebarList.Parent = Sidebar
    SidebarList.Padding = UDim.new(0, 5)
    SidebarList.HorizontalAlignment = Enum.HorizontalAlignment.Center

    local SidebarPad = Instance.new("UIPadding")
    SidebarPad.PaddingTop = UDim.new(0, 15)
    SidebarPad.Parent = Sidebar

    -- Container
    local Container = Instance.new("Frame")
    Container.Size = UDim2.new(1, -170, 1, -20)
    Container.Position = UDim2.new(0, 165, 0, 10)
    Container.BackgroundTransparency = 1
    Container.Parent = Main

    -- Dragging Logic
    local Dragging, DragInput, DragStart, StartPos
    Main.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            Dragging = true; DragStart = input.Position; StartPos = Main.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement and Dragging then
            local delta = input.Position - DragStart
            Main.Position = UDim2.new(StartPos.X.Scale, StartPos.X.Offset + delta.X, StartPos.Y.Scale, StartPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then Dragging = false end
    end)

    --// Page System //--
    function Window:Page(PageConfig)
        local Page = {Name = PageConfig.Name}
        
        local PageFrame = Instance.new("ScrollingFrame")
        PageFrame.Size = UDim2.new(1, 0, 1, 0)
        PageFrame.BackgroundTransparency = 1
        PageFrame.Visible = false
        PageFrame.ScrollBarThickness = 0
        PageFrame.Parent = Container

        local PageList = Instance.new("UIListLayout")
        PageList.Parent = PageFrame
        PageList.Padding = UDim.new(0, 8)

        -- Tab Button
        local TabBtn = Instance.new("TextButton")
        TabBtn.Size = UDim2.new(0, 140, 0, 35)
        TabBtn.BackgroundColor3 = Theme.Main
        TabBtn.Text = Page.Name
        TabBtn.TextColor3 = Theme.TextDark
        TabBtn.Font = Enum.Font.GothamBold
        TabBtn.TextSize = 13
        TabBtn.AutoButtonColor = false
        TabBtn.Parent = Sidebar

        local TabCorner = Instance.new("UICorner")
        TabCorner.CornerRadius = UDim.new(0, 6)
        TabCorner.Parent = TabBtn

        -- Hover Effect
        TabBtn.MouseEnter:Connect(function()
            if Window.CurrentPage ~= Page then
                SmoothTween(TabBtn, {BackgroundColor3 = Theme.Accent, TextColor3 = Theme.Text}, 0.2)
            end
        end)
        TabBtn.MouseLeave:Connect(function()
            if Window.CurrentPage ~= Page then
                SmoothTween(TabBtn, {BackgroundColor3 = Theme.Main, TextColor3 = Theme.TextDark}, 0.2)
            end
        end)

        TabBtn.MouseButton1Click:Connect(function()
            for _, v in pairs(Container:GetChildren()) do v.Visible = false end
            PageFrame.Visible = true
            Window.CurrentPage = Page
        end)

        if not Window.CurrentPage then
            PageFrame.Visible = true
            Window.CurrentPage = Page
            TabBtn.BackgroundColor3 = Theme.Accent
            TabBtn.TextColor3 = Theme.Text
        end

        --// Section System //--
        function Page:Section(SectConfig)
            local Section = {}
            local SectFrame = Instance.new("Frame")
            SectFrame.Size = UDim2.new(1, 0, 0, 30)
            SectFrame.BackgroundColor3 = Theme.Secondary
            SectFrame.Parent = PageFrame

            local SectCorner = Instance.new("UICorner")
            SectCorner.CornerRadius = UDim.new(0, 8)
            SectCorner.Parent = SectFrame

            local SectList = Instance.new("UIListLayout")
            SectList.Parent = SectFrame
            SectList.Padding = UDim.new(0, 5)
            SectList.HorizontalAlignment = Enum.HorizontalAlignment.Center

            local SectTitle = Instance.new("TextLabel")
            SectTitle.Size = UDim2.new(1, -20, 0, 25)
            SectTitle.Text = SectConfig.Name
            SectTitle.TextColor3 = Theme.Accent
            SectTitle.Font = Enum.Font.GothamBold
            SectTitle.TextSize = 12
            SectTitle.BackgroundTransparency = 1
            SectTitle.TextXAlignment = Enum.TextXAlignment.Left
            SectTitle.Parent = SectFrame

            -- Adjust Section Size
            SectList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                SectFrame.Size = UDim2.new(1, 0, 0, SectList.AbsoluteContentSize.Y + 10)
            end)

            --// Components (Toggle) //--
            function Section:Toggle(TogConfig)
                local TogFrame = Instance.new("TextButton")
                TogFrame.Size = UDim2.new(1, -20, 0, 32)
                TogFrame.BackgroundColor3 = Theme.Main
                TogFrame.Text = "  " .. TogConfig.Name
                TogFrame.TextColor3 = Theme.Text
                TogFrame.Font = Enum.Font.Gotham
                TogFrame.TextSize = 12
                TogFrame.TextXAlignment = Enum.TextXAlignment.Left
                TogFrame.AutoButtonColor = false
                TogFrame.Parent = SectFrame

                local TogCorner = Instance.new("UICorner")
                TogCorner.CornerRadius = UDim.new(0, 6)
                TogCorner.Parent = TogFrame

                local Indicator = Instance.new("Frame")
                Indicator.Size = UDim2.new(0, 14, 0, 14)
                Indicator.Position = UDim2.new(1, -20, 0.5, -7)
                Indicator.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
                Indicator.Parent = TogFrame
                
                local IndCorner = Instance.new("UICorner")
                IndCorner.CornerRadius = UDim.new(1, 0)
                IndCorner.Parent = Indicator

                local Toggled = false
                TogFrame.MouseButton1Click:Connect(function()
                    Toggled = not Toggled
                    SmoothTween(Indicator, {BackgroundColor3 = Toggled and Theme.Accent or Color3.fromRGB(50, 50, 60)}, 0.2)
                    TogConfig.Callback(Toggled)
                end)
            end

            function Section:Button(ButConfig)
                local Btn = Instance.new("TextButton")
                Btn.Size = UDim2.new(1, -20, 0, 32)
                Btn.BackgroundColor3 = Theme.Main
                Btn.Text = ButConfig.Name
                Btn.TextColor3 = Theme.Text
                Btn.Font = Enum.Font.GothamBold
                Btn.TextSize = 12
                Btn.Parent = SectFrame
                
                local BtnCorner = Instance.new("UICorner")
                BtnCorner.CornerRadius = UDim.new(0, 6)
                BtnCorner.Parent = Btn

                Btn.MouseButton1Click:Connect(function()
                    Btn.BackgroundColor3 = Theme.Accent
                    task.wait(0.1)
                    SmoothTween(Btn, {BackgroundColor3 = Theme.Main}, 0.2)
                    ButConfig.Callback()
                end)
            end

            return Section
        end
        return Page
    end

    -- Toggle UI (RightControl)
    UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.RightControl then
            ScreenGui.Enabled = not ScreenGui.Enabled
        end
    end)

    return Window
end

--// Notification System //--
function Library:Notification(Title, Desc, Time)
    warn("NOVA: " .. Title .. " - " .. Desc)
end

return Library
