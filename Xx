-- ========== Confirm Logic ==========
local function flashConfirm(msg, delay)
    confirmBtn.Text = msg
    task.delay(delay, function()
        if confirmBtn and confirmBtn.Parent then confirmBtn.Text = "✅ ยืนยันเอาออก" end
    end)
end

doConfirm = function()
    local amt = tonumber(amtBox.Text)
    if not amt or amt <= 0 then return flashConfirm("❌ ใส่จำนวนให้ถูก!", 1.2) end
    if amt > popupItem.maxAmt then return flashConfirm("❌ เกินจำนวนในตู้!", 1.2) end

    local ok = pcall(function()
        game:GetService("ReplicatedStorage"):WaitForChild("Game_Modules"):WaitForChild("RemoteEventSafe"):WaitForChild("WithdrawItem"):FireServer(popupItem.name, math.floor(amt))
    end)

    if ok then
        flashConfirm("✅ สำเร็จ!", 1.0)
        closeWithdrawPopup()
        task.delay(0.3, function() renderSafe("Safe") end)
    else
        flashConfirm("❌ Error!", 1.5)
    end
end

confirmBtn.Activated:Connect(doConfirm)

-- ========== Render Safe ==========
renderSafe = function(folderName)
    clearScroll(scroll)
    statusDot.BackgroundColor3 = C.orange
    tween(dotGlow, {Color=C.orange}, 0.2)
    statusLbl.Text = "⏳ กำลังโหลด " .. folderName .. "..."

    local ok, safeFolder = pcall(function() return LP:WaitForChild(folderName, 3) end)
    if not ok or typeof(safeFolder) ~= "Instance" then
        emptyLbl.Text, emptyLbl.Visible = "❌ ไม่เจอ folder: " .. folderName, true
        statusLbl.Text, statusDot.BackgroundColor3 = "❌ ไม่เจอ " .. folderName, C.red
        tween(dotGlow, {Color=C.red}, 0.2)
        return
    end

    local items = {}
    for _, v in ipairs(safeFolder:GetChildren()) do
        if v:IsA("DoubleConstrainedValue") or v:IsA("IntValue") or v:IsA("NumberValue") or v:IsA("IntConstrainedValue") then
            local amt = math.floor(v.Value)
            if amt > 0 then table.insert(items, {name=v.Name, amount=amt}) end
        end
    end

    if #items == 0 then
        emptyLbl.Text, emptyLbl.Visible = "📦 ตู้นี้ว่างเปล่า", true
        statusLbl.Text, statusDot.BackgroundColor3 = "📦 " .. folderName .. " | ว่างเปล่า", C.textDim
        tween(dotGlow, {Color=C.textDim}, 0.2)
        return
    end

    emptyLbl.Visible = false
    statusDot.BackgroundColor3 = C.green
    tween(dotGlow, {Color=C.green}, 0.2)

    local totalAmt = 0
    table.sort(items, function(a,b) return a.name < b.name end)

    for i, item in ipairs(items) do
        totalAmt += item.amount
        local card = buildItemCard(item, folderName)
        card.BackgroundTransparency = 1
        card.Position = UDim2.new(card.Position.X.Scale, card.Position.X.Offset, card.Position.Y.Scale, card.Position.Y.Offset + 6)
        task.delay(i * 0.025, function()
            if card and card.Parent then tween(card, {BackgroundTransparency=0}, 0.28, Enum.EasingStyle.Quart) end
        end)
    end

    statusLbl.Text = string.format("✅ %s · %d ชนิด · รวม %d", folderName, #items, totalAmt)
end

-- ========== Watch for Value Changes ==========
local watchedFolders, currentTab = {}, "Safe"

local function watchSafe(folderName)
    if watchedFolders[folderName] then return end
    watchedFolders[folderName] = true

    local ok, folder = pcall(function() return LP:WaitForChild(folderName, 3) end)
    if not ok or typeof(folder) ~= "Instance" then return end

    local function isValueType(v)
        return v:IsA("DoubleConstrainedValue") or v:IsA("IntValue") or v:IsA("NumberValue") or v:IsA("IntConstrainedValue")
    end

    local function hookValue(v)
        v:GetPropertyChangedSignal("Value"):Connect(function()
            if currentTab == folderName then renderSafe(folderName) end
        end)
    end

    for _, v in ipairs(folder:GetChildren()) do
        if isValueType(v) then hookValue(v) end
    end

    folder.ChildAdded:Connect(function(v)
        if isValueType(v) then
            hookValue(v)
            if currentTab == folderName then renderSafe(folderName) end
        end
    end)
end

task.spawn(watchSafe, "Safe")

