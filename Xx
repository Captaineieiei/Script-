-- ========== Core Helpers ==========
local function New(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do inst[k] = v end
    return inst
end

local function tween(obj, props, t, style, dir)
    if not obj then return end
    TweenService:Create(obj, TweenInfo.new(t or 0.2, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out), props):Play()
end

local function autoText(lbl, maxSize)
    if not lbl then return end
    lbl.TextScaled = true
    New("UITextSizeConstraint", {MaxTextSize = maxSize or 12, Parent = lbl})
end

local function makeGradient(parent, c1, c2, rot)
    return New("UIGradient", {Color = ColorSequence.new({ColorSequenceKeypoint.new(0,c1), ColorSequenceKeypoint.new(1,c2)}), Rotation = rot or 90, Parent = parent})
end

local function makeGlow(parent, color, thickness, transparency)
    return New("UIStroke", {Color=color, Thickness=thickness or 1, Transparency=transparency or 0, ApplyStrokeMode=Enum.ApplyStrokeMode.Border, Parent=parent})
end

local function makeShadow(parent, sizeOffset, transparency)
    return New("ImageLabel", {
        Name="Shadow", BackgroundTransparency=1, Image=SHADOW_IMG, ImageColor3=C.black,
        ImageTransparency=transparency or 0.55, ScaleType=Enum.ScaleType.Slice, SliceCenter=Rect.new(24,24,276,276),
        Size=UDim2.new(1, sizeOffset or 40, 1, sizeOffset or 40), Position=UDim2.new(0.5,0,0.5,6),
        AnchorPoint=Vector2.new(0.5,0.5), ZIndex=(parent.ZIndex or 1)-1, Parent=parent.Parent, LayoutOrder=-1,
    })
end

local function clearScroll(scrollObj)
    if typeof(scrollObj) ~= "Instance" then return end
    for _, v in ipairs(scrollObj:GetChildren()) do
        if (v:IsA("Frame") or v:IsA("TextLabel") or v:IsA("TextButton")) and v.Name ~= "EmptyLabel" then
            v:Destroy()
        end
    end
end

local function getItemImage(itemName)
    local ok, img = pcall(function()
        local scroller = PG:FindFirstChild("Backpack_Never")
        scroller = scroller and scroller:FindFirstChild("BG")
        scroller = scroller and scroller:FindFirstChild("item")
        scroller = scroller and scroller:FindFirstChild("Scrollingitem")
        local slot = scroller and scroller:FindFirstChild(itemName)
        local imgLabel = slot and slot:FindFirstChild("ItemImage")
        return imgLabel and imgLabel:IsA("ImageLabel") and imgLabel.Image or nil
    end)
    return (ok and img) or ""
end

