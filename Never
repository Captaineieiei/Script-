    for _, t in ipairs(titles) do
        table.insert(values, t)
    end
    return values
end

-- อัพเดทรูป preview ใต้ dropdown
local function updatePreview(item)
    if not ItemPreviewLabel or not ItemPreviewLabel.Parent then return end
    pcall(function()
        if item and item.icon and item.icon ~= "" then
            ItemPreviewLabel.Image = item.icon
            ItemPreviewLabel.Visible = true
        else
            ItemPreviewLabel.Visible = false
        end
    end)
end

local function createItemDropdown(titles, itemMap)
    local valuesWithIcons = buildValuesWithIcons(titles, itemMap)

    if ItemDropdown then
        -- ลอง Refresh ก่อน ถ้าไม่ได้ค่อย Destroy แล้วสร้างใหม่
        local success = pcall(function() ItemDropdown:Refresh(valuesWithIcons) end)
        if not success then
            pcall(function() ItemDropdown:Destroy() end)
            ItemDropdown = nil
        end
    end

    if not ItemDropdown then
        ItemDropdown = FarmSection:Dropdown({
            Title    = "เลือกของที่จะเก็บ",
            Desc     = "อ่านจาก Backpack ของคุณโดยตรง",
            Values   = valuesWithIcons,
            Value    = valuesWithIcons[1],
            Callback = function(option)
                -- option อาจเป็น string หรือ Title จาก table
                local key = type(option) == "table" and option.Title or tostring(option)
                SelectedItem = FarmItemMap[key]
                if SelectedItem then
                    CustomMax = SelectedItem.max
                    updatePreview(SelectedItem)
                end
            end,
        })

        -- Inject รูป preview ขนาดใหญ่เข้าไปใน frame ของ Dropdown โดยตรง
        task.spawn(function()
            task.wait(0.5)
            pcall(function()
                local dropContainer = nil
                local function findContainer(root)
                    for _, v in ipairs(root:GetDescendants()) do
                        if v:IsA("TextLabel") and v.Text == "เลือกของที่จะเก็บ" then
                            local p = v.Parent and v.Parent.Parent and v.Parent.Parent.Parent
                            if p and p:IsA("Frame") then dropContainer = p end
                            return
                        end
                    end
                end
                findContainer(game:GetService("CoreGui"))
                if not dropContainer then
                    for _, gui in ipairs(LocalPlayer.PlayerGui:GetChildren()) do
                        if gui:IsA("ScreenGui") then
                            findContainer(gui)
                            if dropContainer then break end
                        end
                    end
                end
                if not dropContainer then return end

                local old2 = dropContainer:FindFirstChild("SW_InlinePreview")
                if old2 then old2:Destroy() end

                local img = Instance.new("ImageLabel")
                img.Name                   = "SW_InlinePreview"
                img.Size                   = UDim2.new(0, 44, 0, 44)
                img.Position               = UDim2.new(1, -56, 0.5, -22)
                img.BackgroundTransparency = 1
                img.ScaleType              = Enum.ScaleType.Fit
                img.ZIndex                 = dropContainer.ZIndex + 2
                img.Visible                = false
                img.Parent                 = dropContainer

                ItemPreviewLabel = img

                updatePreview = function(item)
                    pcall(function()
                        if item and item.icon and item.icon ~= "" then
                            img.Image   = item.icon
                            img.Visible = true
                        else
                            img.Visible = false
                        end
                    end)
                end

                if SelectedItem and SelectedItem.icon ~= "" then
                    updatePreview(SelectedItem)
                end
            end)
        end)
    end

    SelectedItem = itemMap[titles[1]]
    CustomMax    = (SelectedItem and SelectedItem.max) or 60
    -- อัพเดท preview สำหรับไอเทมแรก
    task.defer(function() updatePreview(SelectedItem) end)
end

