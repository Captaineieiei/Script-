local _injectPending = false
local function injectIconsIntoDropdown()
    if _injectPending then return end
    _injectPending = true
    task.delay(0.15, function()
        _injectPending = false
        pcall(function()
            -- ถ้าไม่มี WindUIGui ให้ fallback หา ScreenGui ใหม่อีกครั้ง (กันกรณี respawn gui)
            if not WindUIGui or not WindUIGui.Parent then
                for _, c in ipairs(LP.PlayerGui:GetChildren()) do
                    if c:IsA("ScreenGui") and c:FindFirstChildWhichIsA("Frame", true) then
                        -- หา ScreenGui ที่ไม่ใช่ CoreGui / GameGui (ไม่มี ResetOnSpawn=true ส่วนใหญ่)
                        if not c.ResetOnSpawn then WindUIGui = c; break end
                    end
                end
            end
            -- scan เฉพาะใน WindUIGui เท่านั้น ไม่แตะ UI ของเกม
            local scanRoot = WindUIGui
            if not scanRoot then return end
            for _, lbl in ipairs(scanRoot:GetDescendants()) do
                if lbl:IsA("TextLabel") and FarmItemMap[lbl.Text] then
                    local entry = FarmItemMap[lbl.Text]
                    if not entry or not entry.icon then continue end
                    local p = lbl.Parent
                    if not p then continue end
                    if p:FindFirstChild("SW_Icon") then
                        p:FindFirstChild("SW_Icon").Image = entry.icon
                        continue
                    end
                    local img = Instance.new("ImageLabel")
                    img.Name = "SW_Icon"
                    img.BackgroundTransparency = 1
                    img.Size = UDim2.fromOffset(20, 20)
                    img.Position = UDim2.new(0, 4, 0.5, -10)
                    img.Image = entry.icon
                    img.ZIndex = lbl.ZIndex + 1
                    img.Parent = p
                    pcall(function() lbl.Position = UDim2.new(0, 28, lbl.Position.Y.Scale, lbl.Position.Y.Offset) end)
                end
            end
        end)
    end)
end

