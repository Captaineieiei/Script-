-- FULLBRIGHT
local FullbrightEnabled = false
local _origLighting = {}
local _fbProps = {"Ambient","OutdoorAmbient","Brightness","ClockTime","FogEnd","FogStart","GlobalShadows"}
local _fbVals  = {Color3.new(1,1,1), Color3.new(1,1,1), 2, 14, 1e6, 1e6, false}
local _fbFxTypes = {"Atmosphere","BloomEffect","ColorCorrectionEffect","SunRaysEffect","DepthOfFieldEffect"}

local function captureOrigLighting()
    for _,k in ipairs(_fbProps) do _origLighting[k]=Lighting[k] end
end
local function applyFullbright()
    pcall(function()
        for i,k in ipairs(_fbProps) do Lighting[k]=_fbVals[i] end
        for _,fx in ipairs(Lighting:GetChildren()) do
            for _,t in ipairs(_fbFxTypes) do if fx:IsA(t) then pcall(function() fx.Enabled=false end); break end end
        end
    end)
end
local function restoreOrigLighting()
    pcall(function()
        for _,k in ipairs(_fbProps) do Lighting[k]=_origLighting[k] end
        for _,fx in ipairs(Lighting:GetChildren()) do
            for _,t in ipairs(_fbFxTypes) do if fx:IsA(t) then pcall(function() fx.Enabled=true end); break end end
        end
    end)
end

local _fbConn
local function setFullbright(state)
    FullbrightEnabled=state
    if state then
        captureOrigLighting(); applyFullbright()
        _fbConn = RunService.RenderStepped:Connect(function()
            if not FullbrightEnabled then _fbConn:Disconnect(); _fbConn=nil; return end
            applyFullbright()
        end)
    else
        if _fbConn then _fbConn:Disconnect(); _fbConn=nil end
        restoreOrigLighting()
    end
end

