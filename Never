---> HELPERS <---
local function findLabelByText(searchText)
    local found = nil
    local function search(root)
        if not root then return end
        for _, v in ipairs(root:GetDescendants()) do
            if v:IsA("TextLabel") and v.Text == searchText then
                found = v
                return
            end
        end
    end
    pcall(search, game:GetService("CoreGui"))
    if not found then pcall(search, LocalPlayer.PlayerGui) end
    return found
end

local function resolveRemotePath(root, path, timeout)
    timeout = timeout or 1
    local current = root
    for _, name in ipairs(path) do
        if not current then return nil end
        local next = current:WaitForChild(name, timeout)
        if not next then return nil end
        current = next
    end
    return current
end

