                patchDropdownIcons() -- patch button area ทุกครั้งที่เลือก
            end,
        })
    end
    patchDropdownIcons()
    if not SelectedItem or SelectedItem.value=="" then
        SelectedItem=itemMap[titles[1]]; CustomMax=(SelectedItem and SelectedItem.max) or 60
    end
end

