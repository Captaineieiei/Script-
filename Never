local ESPObjects   = {}
local _espPartCache = {}   -- model -> {BasePart, ...}  rebuilt on demand

-- โฟลเดอร์ที่ไม่ต้องการ ESP (NPC ใน folder เหล่านี้จะถูกข้ามทั้งหมด)
local ESP_EXCLUDE_PATHS = {
    {"System", "[Server] Npc_Seal"},
    {"System", "[Prompt] Team"},
    {"Farmer_1"},
}
local function isESPExcluded(model)
    for _,path in ipairs(ESP_EXCLUDE_PATHS) do
        local node = workspace
        for _,name in ipairs(path) do
            node = node:FindFirstChild(name)
            if not node then break end
        end
        if node and (model == node or model:IsDescendantOf(node)) then return true end
    end
    return false
end

local function newLine(thick, color)
    local d=Drawing.new("Line"); d.Thickness=thick; d.Color=color; d.Transparency=1; d.Visible=false; return d
end
local function newText(size, color)
    local d=Drawing.new("Text"); d.Size=size; d.Color=color; d.Outline=true; d.Center=true; d.Visible=false; return d
end

local function makeESP(model, isNPC)
    if ESPObjects[model] then return end
    local box={}; for i=1,4 do box[i]=newLine(CFG.BoxThickness, CFG.BoxColor) end
    ESPObjects[model]={
        box=box, isNPC=isNPC or false,
        hpBar    = newLine(CFG.HPBarWidth, Color3.new(0,1,0)),
        nameLabel= newText(CFG.NameSize,   Color3.new(1,1,1)),
        distLabel= newText(11,             Color3.fromRGB(200,200,200)),
        hpText   = newText(16,             Color3.fromRGB(200,255,200)),
        hideTick = 0,  -- debounce: ซ่อนจริงหลัง fail ติดกัน N frame
        showTick = 0,  -- debounce: แสดงจริงหลัง pass ติดกัน N frame (กันกระพริบ)
    }
end

local function removeESP(model)
    local obj=ESPObjects[model]; if not obj then return end
    for _,l in ipairs(obj.box) do pcall(function() l:Remove() end) end
    for _,k in ipairs({"hpBar","nameLabel","distLabel","hpText"}) do
        pcall(function() obj[k]:Remove() end)
    end
    ESPObjects[model]=nil
    _espPartCache[model]=nil
end

local function setVisible(obj, v)
    for _,l in ipairs(obj.box) do l.Visible=v end
    obj.hpBar.Visible=v; obj.nameLabel.Visible=v
    obj.distLabel.Visible=v; obj.hpText.Visible=v
end

local HIDE_DEBOUNCE = 6  -- ต้อง fail ติดกัน N frame ถึงซ่อนจริง
local SHOW_DEBOUNCE = 3  -- ต้อง pass ติดกัน N frame ถึงแสดงจริง (กันกระพริบขอบจอ)

RunService.RenderStepped:Connect(function()
    if not CFG.Enabled then return end
    local Camera = workspace.CurrentCamera
    for model, obj in pairs(ESPObjects) do
        pcall(function()
            local root = model:FindFirstChild("HumanoidRootPart")
            local hum  = model:FindFirstChildOfClass("Humanoid")
            local function hideAndReturn()
                obj.showTick = 0
                obj.hideTick = obj.hideTick + 1
                if obj.hideTick >= HIDE_DEBOUNCE then setVisible(obj,false) end
            end

            if not root or not hum then hideAndReturn(); return end
            if CFG.HideDeadESP and hum.Health<=0 then hideAndReturn(); return end

            local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            local dist   = myRoot and (myRoot.Position-root.Position).Magnitude or 0
            if dist>CFG.MaxDist then hideAndReturn(); return end

            if not obj.isNPC then
                local plr=Players:GetPlayerFromCharacter(model)
                if not plr then hideAndReturn(); return end
                if CFG.HideFriends and FriendSet[plr.UserId] then hideAndReturn(); return end
            elseif isESPExcluded(model) then
                removeESP(model); return
            end

            if CFG.BypassAntiESP then
                -- Run every frame using a cached part list so GetDescendants is only
                -- called once per character (rebuilt automatically when cache is nil).
                local parts = _espPartCache[model]
                if not parts then
                    parts = {}
                    for _,p in ipairs(model:GetDescendants()) do
                        if p:IsA("BasePart") then parts[#parts+1]=p end
                    end
                    _espPartCache[model] = parts
                end
                for _,p in ipairs(parts) do
                    pcall(function() p.LocalTransparencyModifier=0 end)
                end
            end

            -- ใช้ head+root สองจุดเช็ค onScreen แทนจุดเดียว กันกระพริบขอบจอ
            local head    = model:FindFirstChild("Head") or root
            local topPos3 = Camera:WorldToViewportPoint(head.Position+Vector3.new(0,head.Size.Y/2+0.3,0))
            local botPos3 = Camera:WorldToViewportPoint(root.Position-Vector3.new(0,3,0))
            local pos3, onScreen = Camera:WorldToViewportPoint(root.Position)
            -- ถือว่า onScreen ถ้า root หรือ head อยู่ในจอ (กัน edge case ตัวอยู่ขอบ)
            local _, headOnScreen = Camera:WorldToViewportPoint(head.Position)
            if not onScreen and not headOnScreen then hideAndReturn(); return end

            local cx      = pos3.X
            local y1 = math.min(topPos3.Y, botPos3.Y)
            local y2 = math.max(topPos3.Y, botPos3.Y)
            local h  = y2 - y1
            if h < 1 then hideAndReturn(); return end
            local w  = h*0.6
            local x1,x2 = cx-w/2, cx+w/2

            -- ผ่านทุกเงื่อนไข: reset hideTick, เพิ่ม showTick
            obj.hideTick = 0
            obj.showTick = math.min(obj.showTick + 1, SHOW_DEBOUNCE)
            local visible = obj.showTick >= SHOW_DEBOUNCE

            for _,l in ipairs(obj.box) do l.Thickness=CFG.BoxThickness; l.Color=CFG.BoxColor end
            obj.box[1].From=Vector2.new(x1,y1); obj.box[1].To=Vector2.new(x2,y1); obj.box[1].Visible=visible
            obj.box[2].From=Vector2.new(x1,y2); obj.box[2].To=Vector2.new(x2,y2); obj.box[2].Visible=visible
            obj.box[3].From=Vector2.new(x1,y1); obj.box[3].To=Vector2.new(x1,y2); obj.box[3].Visible=visible
            obj.box[4].From=Vector2.new(x2,y1); obj.box[4].To=Vector2.new(x2,y2); obj.box[4].Visible=visible

            local hpR = math.clamp(hum.Health/math.max(hum.MaxHealth,1),0,1)
            -- แถบ HP แนวนอน อยู่ชิดขอบล่างในกล่อง (ง่ายต่อการอ่านระหว่างเล่น)
            local hpColor = hpR > 0.5
                and Color3.fromRGB(math.floor(255*(1-hpR)*2), 255, 0)
                or  Color3.fromRGB(255, math.floor(255*hpR*2), 0)
            obj.hpBar.Thickness = 6
            obj.hpBar.Color     = hpColor
            obj.hpBar.From      = Vector2.new(x1, y2+4)
            obj.hpBar.To        = Vector2.new(x1+(x2-x1)*hpR, y2+4)
            obj.hpBar.Visible   = CFG.ShowHP and visible

            local plr = not obj.isNPC and Players:GetPlayerFromCharacter(model)
            obj.nameLabel.Text    =plr and plr.Name or model.Name
            obj.nameLabel.Size    =CFG.NameSize
            obj.nameLabel.Position=Vector2.new(cx, y1-CFG.NameSize-2)
            obj.nameLabel.Visible =CFG.ShowName and visible

            obj.distLabel.Text    =string.format("%.0f studs", dist)
            obj.distLabel.Position=Vector2.new(cx, y2+30)
            obj.distLabel.Visible =CFG.ShowDist and visible

            local hpPct = math.floor(hpR*100)
            local dynSize = math.clamp(math.floor(28 - dist/12), 11, 28)
            obj.hpText.Text    = hpPct.."%  ("..math.floor(hum.Health).."/"..math.floor(hum.MaxHealth)..")"
            obj.hpText.Size    = dynSize
            obj.hpText.Color   = hpColor
            obj.hpText.Position= Vector2.new(cx, y2+12)
            obj.hpText.Visible = CFG.ShowHPText and visible
        end)
    end
end)

local _plrConns = {}
local _npcConns = {}
local function trackPlayer(plr)
    if plr==LP then return end
    local function onChar(c)
        local ok = pcall(function() c:WaitForChild("HumanoidRootPart", 5) end)
        if not ok or not c.Parent then return end
        if ESPObjects[c] then removeESP(c) end
        makeESP(c, false)
        c.DescendantAdded:Connect(function(d)
            if d:IsA("BasePart") then _espPartCache[c]=nil end
        end)
        c.AncestryChanged:Connect(function(_,p)
            if not p then removeESP(c); _espPartCache[c]=nil end
        end)
    end
    local cr=plr.CharacterRemoving:Connect(function(c) removeESP(c); _espPartCache[c]=nil end)
    local ca=plr.CharacterAdded:Connect(function(c) task.spawn(onChar, c) end)
    if plr.Character then task.spawn(onChar, plr.Character) end
    _plrConns[plr]={ca,cr}
end
Players.PlayerAdded:Connect(trackPlayer)
Players.PlayerRemoving:Connect(function(plr)
    if _plrConns[plr] then for _,c in ipairs(_plrConns[plr]) do c:Disconnect() end; _plrConns[plr]=nil end
    if plr.Character then removeESP(plr.Character); _espPartCache[plr.Character]=nil end
end)
for _,plr in ipairs(Players:GetPlayers()) do trackPlayer(plr) end

