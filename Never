local WaterSection = FarmTab:Section({ Title = "🌿 ต้นแคนดี้ - Auto Water", Opened = true })

local autoWaterEnabled = false

local function walkToTarget(model)
    local targetPart = model:FindFirstChildWhichIsA("BasePart", true)
    if targetPart then
        humanoid:MoveTo(targetPart.Position)
        local arrived = false
        local conn
        conn = humanoid.MoveToFinished:Connect(function()
            arrived = true
            conn:Disconnect()
        end)
        local startTime = tick()
        repeat task.wait(0.1) until arrived or (tick() - startTime) > 10
        return true
    end
    return false
end

local function checkAndWater(tree)
    if not parentFolder then return end
    local stats = tree:FindFirstChild("Stats")
    if not stats then return end
    local waterValue = stats:FindFirstChild("Water")
    if not waterValue then return end
    if waterValue.Value < 50 then
        local success = walkToTarget(tree)
        if success then
            while waterValue.Value < 100 and autoWaterEnabled do
                giveWaterRemote:FireServer()
                task.wait(0.3)
            end
        end
    end
end

