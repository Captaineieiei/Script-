local function loadBackpackItems()
    local titles, itemMap = {}, {}
    local ok, scrolling = pcall(function()
        return LP.PlayerGui:WaitForChild("Backpack",5):WaitForChild("BG",5)
            :WaitForChild("item",5):WaitForChild("Scrollingitem",5)
    end)
    if ok and scrolling then
        for _, slot in ipairs(scrolling:GetChildren()) do
            local name = slot.Name
            if not slot:IsA("UIBase") and not slot:IsA("UIComponent") and name ~= "" and name ~= "Animation" then
                local max = 60
                local nl = name:lower()
                if nl:find("stone") or nl:find("gold") or nl:find("iron") then max = 500 end
                pcall(function()
                    local a = slot:FindFirstChild("Amout")
                    if a and a:IsA("TextLabel") then
                        local m = tonumber(string.match(a.Text, "%d+|(%d+)"))
                        if m and m > 0 then max = m end
                    end
                end)
                table.insert(titles, name)
                itemMap[name] = { Title = name, value = name, max = max, icon = "" }
            end
        end
    end
    if #titles == 0 then
        titles = { "(ไม่พบไอเทม)" }
        itemMap["(ไม่พบไอเทม)"] = { Title = "(ไม่พบไอเทม)", value = "", max = 0, icon = "" }
    end
    return titles, itemMap
end

