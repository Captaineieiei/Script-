-- Skeleton bone definitions (R15 / R6)
local RIG_BONES_R15 = {
    {"Head","UpperTorso"}, {"UpperTorso","LowerTorso"},
    {"UpperTorso","LeftUpperArm"}, {"LeftUpperArm","LeftLowerArm"}, {"LeftLowerArm","LeftHand"},
    {"UpperTorso","RightUpperArm"}, {"RightUpperArm","RightLowerArm"}, {"RightLowerArm","RightHand"},
    {"LowerTorso","LeftUpperLeg"}, {"LeftUpperLeg","LeftLowerLeg"}, {"LeftLowerLeg","LeftFoot"},
    {"LowerTorso","RightUpperLeg"}, {"RightUpperLeg","RightLowerLeg"}, {"RightLowerLeg","RightFoot"},
}
local RIG_BONES_R6 = {
    {"Head","Torso"},
    {"Torso","Left Arm"}, {"Torso","Right Arm"},
    {"Torso","Left Leg"}, {"Torso","Right Leg"},
}

local function detectRigType(model)
    local hum = model:FindFirstChildOfClass("Humanoid")
    if hum then
        return hum.RigType == Enum.HumanoidRigType.R15
    end
    return model:FindFirstChild("UpperTorso") ~= nil
end

local function makeESP(model, isNPC)
    if ESPObjects[model] then return end
    local isR15 = detectRigType(model)
    local bones = isR15 and RIG_BONES_R15 or RIG_BONES_R6
    local skeleton={}; for i=1,#bones do skeleton[i]=newLine(CFG.BoxThickness, CFG.BoxColor) end
    ESPObjects[model]={
        skeleton=skeleton, bones=bones, jointCache=nil, isNPC=isNPC or false,
        hpBar    = newLine(CFG.HPBarWidth, Color3.new(0,1,0)),
        nameLabel= newText(CFG.NameSize,   Color3.fromRGB(185,170,240)),  -- soft lavender (theme Icon)
        distLabel= newText(11,             Color3.fromRGB(140,130,175)),  -- muted violet (theme Placeholder)
        hpText   = newText(16,             Color3.fromRGB(110,255,165)),  -- mint-green (matches HUD count)
        lastPos3 = nil,
        lastTopPos3 = nil,
        lastBotPos3 = nil,
    }
end

local function removeESP(model)
    local obj=ESPObjects[model]; if not obj then return end
    for _,l in ipairs(obj.skeleton) do pcall(function() l:Remove() end) end
    for _,k in ipairs({"hpBar","nameLabel","distLabel","hpText"}) do
        pcall(function() obj[k]:Remove() end)
    end
    ESPObjects[model]=nil
    _espPartCache[model]=nil
    _espCacheBuild[model]=nil
end

local function setVisible(obj, v)
    for _,l in ipairs(obj.skeleton) do l.Visible=v end
    obj.hpBar.Visible=v; obj.nameLabel.Visible=v
    obj.distLabel.Visible=v; obj.hpText.Visible=v
end

-- FIX 3: MASSIVE PERFORMANCE BOOST - Cache myRoot and Distance outside the loop
-- FIX 4 (optimize): named function reused every frame instead of a fresh closure
-- per model (and a fresh closure per cached BasePart) — that was the biggest
-- GC/frame-time cost once several ESP targets are on screen at once.
local function updateESPObject(model, obj, Camera, myRoot, myPos)
    local root = model:FindFirstChild("HumanoidRootPart")
    local hum  = model:FindFirstChildOfClass("Humanoid")
    local isValid = myRoot ~= nil

    if not root or not hum then isValid = false end
    if isValid and CFG.HideDeadESP and hum.Health <= 0 then isValid = false end

    local dist = 0
    if isValid and myPos then
        dist = (myPos - root.Position).Magnitude
        if dist > CFG.MaxDist then isValid = false end

        if isValid then
            if not obj.isNPC then
                local plr = Players:GetPlayerFromCharacter(model)
                if not plr then isValid = false
                elseif CFG.HideFriends and FriendSet[plr.UserId] then isValid = false end
            elseif isESPExcluded(model) then
                removeESP(model); return
            end
        end
    end

    if isValid and CFG.BypassAntiESP then
        local parts = _espPartCache[model]
        if parts then
            for _, p in ipairs(parts) do
                if p.Parent then p.LocalTransparencyModifier = 0 end
            end
        elseif not _espCacheBuild[model] then
            _espCacheBuild[model] = true
            task.spawn(function()
                local newParts = {}
                for _, p in ipairs(model:GetDescendants()) do
                    if p:IsA("BasePart") then newParts[#newParts + 1] = p end
                end
                _espPartCache[model] = newParts
                _espCacheBuild[model] = nil
            end)
        end
    end

    local pos3, topPos3, botPos3

    if isValid then
        local tempPos3 = Camera:WorldToViewportPoint(root.Position)

        if tempPos3.Z <= 0 then
            isValid = false
        else
            pos3 = tempPos3
            obj.lastPos3 = pos3

            local head = model:FindFirstChild("Head") or root
            local tempTop = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, head.Size.Y / 2 + 0.3, 0))
            local tempBot = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))

            if tempTop.Z <= 0 or tempBot.Z <= 0 then
                isValid = false
            else
                topPos3 = tempTop
                botPos3 = tempBot
                obj.lastTopPos3 = topPos3
                obj.lastBotPos3 = botPos3
            end
        end
    end

    if not isValid then
        setVisible(obj, false)
        return
    end

    pos3 = obj.lastPos3
    topPos3 = obj.lastTopPos3
    botPos3 = obj.lastBotPos3

    local cx = pos3.X
    local y1 = math.min(topPos3.Y, botPos3.Y)
    local y2 = math.max(topPos3.Y, botPos3.Y)
    local h  = y2 - y1

    if h < 2 then h = 2 end
    local w  = h * 0.6
    local x1, x2 = cx - w/2, cx + w/2

    -- Skeleton drawing: cache joint (BasePart) refs once per character, then
    -- project each bone's two endpoints to the screen every frame.
    local joints = obj.jointCache
    if not joints then joints={}; obj.jointCache=joints end
    for _,bone in ipairs(obj.bones) do
        for _,jname in ipairs(bone) do
            if not joints[jname] then joints[jname]=model:FindFirstChild(jname) end
        end
    end
    for i, bone in ipairs(obj.bones) do
        local line = obj.skeleton[i]
        local p1, p2 = joints[bone[1]], joints[bone[2]]
        if p1 and p2 then
            local v1 = Camera:WorldToViewportPoint(p1.Position)
            local v2 = Camera:WorldToViewportPoint(p2.Position)
            if v1.Z > 0 and v2.Z > 0 then
                line.Thickness=CFG.BoxThickness; line.Color=CFG.BoxColor
                line.From=Vector2.new(v1.X,v1.Y); line.To=Vector2.new(v2.X,v2.Y)
                line.Visible=true
            else
                line.Visible=false
            end
        else
            line.Visible=false
        end
    end

    local hpR = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
    local hpColor = hpR > 0.5
        and Color3.fromRGB(math.floor(255*(1-hpR)*2), 255, 0)
        or  Color3.fromRGB(255, math.floor(255*hpR*2), 0)
    obj.hpBar.Thickness = 6
    obj.hpBar.Color     = hpColor
    obj.hpBar.From      = Vector2.new(x1, y2+4)
    obj.hpBar.To        = Vector2.new(x1+(x2-x1)*hpR, y2+4)
    obj.hpBar.Visible   = CFG.ShowHP

    local plr = not obj.isNPC and Players:GetPlayerFromCharacter(model)
    obj.nameLabel.Text    = plr and plr.Name or model.Name
    obj.nameLabel.Size    = CFG.NameSize
    obj.nameLabel.Position= Vector2.new(cx, y1-CFG.NameSize-2)
    obj.nameLabel.Visible = CFG.ShowName

    obj.distLabel.Text    = string.format("%.0f studs", dist)
    obj.distLabel.Position= Vector2.new(cx, y2+30)
    obj.distLabel.Visible = CFG.ShowDist

    local hpPct = math.floor(hpR*100)
    local dynSize = math.clamp(math.floor(22 - dist/14), 11, 22)
    obj.hpText.Text    = hpPct.."%  ("..math.floor(hum.Health).."/"..math.floor(hum.MaxHealth)..")"
    obj.hpText.Size    = dynSize
    obj.hpText.Color   = hpColor
    obj.hpText.Position= Vector2.new(cx, y2+12)
    obj.hpText.Visible = CFG.ShowHPText
end

