local function loadBackpackItems()
    local titles = {}
    local itemMap = {}
    local ok, scrolling = pcall(function()
        return LocalPlayer.PlayerGui
            :WaitForChild("Backpack",      5)
            :WaitForChild("BG",            5)
            :WaitForChild("item",          5)
            :WaitForChild("Scrollingitem", 5)
    end)
    if ok and scrolling then
        for _, slot in ipairs(scrolling:GetChildren()) do
            local name = slot.Name
            if not slot:IsA("UIBase") and not slot:IsA("UIComponent")
                and name ~= "" and name ~= "Animation"
            then
                local max = 60
                local nameLower = name:lower()
                if nameLower:find("stone") or nameLower:find("gold") or nameLower:find("iron") then
                    max = 500
                end
                pcall(function()
                    local amout = slot:FindFirstChild("Amout")
                    if amout and amout:IsA("TextLabel") then
                        local maxFromText = tonumber(string.match(amout.Text, "%d+|(%d+)"))
                        if maxFromText and maxFromText > 0 then max = maxFromText end
                    end
                end)
                -- icon = "" ก่อน โหลดทีหลังใน loadIconsAsync
                table.insert(titles, name)
                itemMap[name] = { Title = name, value = name, max = max, icon = "" }
            end
        end
    end
    if #titles == 0 then
        titles = { "(ไม่พบไอเทม)" }
        itemMap["(ไม่พบไอเทม)"] = { Title = "(ไม่พบไอเทม)", value = "", max = 0, icon = "" }
    end
    return titles, itemMap
end

-- โหลดรูปทีหลัง หลัง UI พร้อมแล้ว
local function loadIconsAsync(itemMap)
    task.spawn(function()
        task.wait(1.5) -- รอให้ UI render เสร็จก่อน
        local ok, scrolling = pcall(function()
            return LocalPlayer.PlayerGui
                :WaitForChild("Backpack",      5)
                :WaitForChild("BG",            5)
                :WaitForChild("item",          5)
                :WaitForChild("Scrollingitem", 5)
        end)
        if not ok or not scrolling then return end
        for _, slot in ipairs(scrolling:GetChildren()) do
            local name = slot.Name
            if itemMap[name] then
                local imageId = ""
                pcall(function()
                    local img = slot:FindFirstChild("ItemImage")
                    if img and img:IsA("ImageLabel") and img.Image ~= "" then
                        imageId = img.Image
                    end
                    if imageId == "" then
                        for _, child in ipairs(slot:GetChildren()) do
                            if child:IsA("ImageLabel") and child.Image ~= "" then
                                imageId = child.Image
                                break
                            end
                        end
                    end
                end)
                if imageId ~= "" then
                    itemMap[name].icon = imageId
                    -- ถ้าไอเทมนี้ถูกเลือกอยู่ → อัพเดท preview ทันที
                    if SelectedItem and SelectedItem.value == name then
                        updatePreview(itemMap[name])
