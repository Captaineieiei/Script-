local slotLabelCache = {}
local function getSlotCount(slot)
    local lbl = slotLabelCache[slot]
    if not lbl or not lbl.Parent then
        lbl = slot:FindFirstChild("Amout")
        if not lbl then
            for _, child in ipairs(slot:GetChildren()) do
                if child:IsA("TextLabel") or child:IsA("TextButton") then
                    lbl = child
                    break
                end
            end
        end
        slotLabelCache[slot] = lbl
    end
    if not lbl then return 0 end
    local txt = ""
    pcall(function() txt = lbl.Text end)
    if txt ~= "" then
        return tonumber(string.match(txt, "^(%d+)"))
            or tonumber(string.match(txt, "(%d+)"))
            or 0
    end
    return 0
end

