local function buildFolderLabel(folder)
    local uid = tonumber(folder.Name:match("PlantedTrees_(%d+)"))
    if not uid then return folder.Name end
    local plr  = Players:GetPlayerByUserId(uid)
    local name = plr and plr.Name or tostring(uid)
    return folder.Name == folderName and ("ของฉัน (" .. name .. ")") or name
end

function buildWaterPickDropdown()
    waterFolderMap = {}
    local titles = {}
    if allTrees then
        for _, folder in pairs(allTrees:GetChildren()) do
            local label = buildFolderLabel(folder)
            table.insert(titles, label)
            waterFolderMap[label] = folder
        end
    end
    if #titles == 0 then titles = { "(ไม่พบผู้เล่น)" } end
    selectedWaterFolders = waterFolderMap[titles[1]] and { waterFolderMap[titles[1]] } or {}
    if waterPickDropdown then
        local ok = pcall(function() waterPickDropdown:Refresh(titles) end)
        if not ok then pcall(function() waterPickDropdown:Destroy() end); waterPickDropdown = nil end
    end
    if not waterPickDropdown then
        waterPickDropdown = WaterSection:Dropdown({
            Title = "รดน้ำต้นของ", Desc = "เลือกผู้เล่นได้หลายคน (tick ได้หลายชื่อ)",
            Icon = "users", Values = titles, Value = { titles[1] }, Multi = true,
            Callback = function(options)
                selectedWaterFolders = {}
                if type(options) == "table" then
                    for _, opt in ipairs(options) do
                        local key = type(opt) == "table" and opt.Title or tostring(opt)
                        local folder = waterFolderMap[key]
                        if folder then table.insert(selectedWaterFolders, folder) end
                    end
                else
                    local folder = waterFolderMap[tostring(options)]
                    if folder then table.insert(selectedWaterFolders, folder) end
                end
            end,
        })
    end
end
buildWaterPickDropdown()

local function walkToTarget(model)
    local targetPart = model:FindFirstChildWhichIsA("BasePart", true)
    if not targetPart then return false end
    local cur = LP.Character
    local hum2 = cur and cur:FindFirstChildOfClass("Humanoid")
    if not hum2 then return false end
    hum2:MoveTo(targetPart.Position)
    local arrived, conn = false, nil
    conn = hum2.MoveToFinished:Connect(function() arrived = true; conn:Disconnect() end)
    local t = tick()
    repeat task.wait(0.5) until arrived or (tick() - t) > 10
    return true
end

local function checkAndWater(tree)
    local stats = tree:FindFirstChild("Stats"); if not stats then return end
    local wv = stats:FindFirstChild("Water"); if not wv then return end
    if not giveWaterRemote then return end
    if wv.Value < 50 then
        if walkToTarget(tree) then
            while wv.Value < 100 and autoWaterEnabled do giveWaterRemote:FireServer(); task.wait(0.5) end
        end
    end
end

WaterSection:Toggle({
    Title = "Auto Water", Desc = "รดน้ำอัตโนมัติเมื่อน้ำต่ำกว่า 50% (เรียงใกล้→ไกล)",
    Icon = "droplet", Value = false,
    Callback = function(state)
        autoWaterEnabled = state
        if not state then return end
        if #selectedWaterFolders == 0 then
            WindUI:Notify({ Title = "❌ ไม่พบโฟลเดอร์", Content = "ลอง Reload Candy ก่อน แล้วเปิด Toggle ใหม่", Duration = 4 })
            autoWaterEnabled = false; return
        end
        task.spawn(function()
            while autoWaterEnabled do
                local allTreeList = {}
                for _, folder in ipairs(selectedWaterFolders) do
                    if folder and folder.Parent then
                        for _, tree in pairs(folder:GetChildren()) do
                            local stats = tree:FindFirstChild("Stats")
                            if stats then
                                local wv = stats:FindFirstChild("Water")
                                if wv and wv.Value < 50 then table.insert(allTreeList, tree) end
                            end
                        end
                    end
                end
                local c2 = LP.Character
                local hrp2 = c2 and c2:FindFirstChild("HumanoidRootPart")
                if hrp2 and #allTreeList > 1 then
                    table.sort(allTreeList, function(a, b)
                        local pa = a:FindFirstChildWhichIsA("BasePart", true)
                        local pb = b:FindFirstChildWhichIsA("BasePart", true)
                        local da = pa and (hrp2.Position - pa.Position).Magnitude or math.huge
                        local db = pb and (hrp2.Position - pb.Position).Magnitude or math.huge
                        return da < db
                    end)
                end
                for _, tree in ipairs(allTreeList) do
                    if not autoWaterEnabled then break end
                    pcall(function() checkAndWater(tree) end)
                end
                task.wait(5)
            end
        end)
    end,
})

