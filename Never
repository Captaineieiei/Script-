local Camera = workspace.CurrentCamera

local function GetBoundingBox(hrp)
    if not hrp or not hrp.Parent then return nil end
    local pos = hrp.Position
    local center = Camera:WorldToViewportPoint(pos)
    if center.Z <= 0 then return nil end
    local vpSize = Camera.ViewportSize
    local top    = Camera:WorldToViewportPoint(pos + Vector3.new(0, 2.8, 0))
    local bottom = Camera:WorldToViewportPoint(pos + Vector3.new(0, -2.75, 0))
    local topY    = (top.Z    <= 0) and 0        or top.Y
    local bottomY = (bottom.Z <= 0) and vpSize.Y or bottom.Y
    local h = bottomY - topY
    if h < 2 then return nil end
    local w = h * 0.42
    return center.X - w, topY, center.X + w, bottomY
end

local function GetHPColor(r)
    r = math.clamp(r, 0, 1)
    return r > 0.5 and Color3.new(1-(r-0.5)*2, 1, 0) or Color3.new(1, r*2, 0)
end

local function IsNPC(model)
    if not model:IsA("Model") then return false end
    if Players:GetPlayerFromCharacter(model) then return false end
    if not model:FindFirstChildOfClass("Humanoid") then return false end
    return (model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso")) ~= nil
end

local function NewLine()
    local l = Drawing.new("Line")
    l.Visible = false; l.Thickness = CFG.BoxThickness; l.Color = CFG.BoxColor; l.ZIndex = 5
    return l
end
local function NewRect()
    local r = Drawing.new("Square")
    r.Visible = false; r.Thickness = 0; r.Filled = true; r.ZIndex = 4
    return r
end
local function NewText(size, color)
    local t = Drawing.new("Text")
    t.Visible = false; t.Size = size or CFG.NameSize; t.Font = Drawing.Fonts.UI
    t.Color = color or Color3.new(1,1,1); t.Outline = true
    t.OutlineColor = Color3.new(0,0,0); t.Center = true; t.ZIndex = 6
    return t
end

local _drawKeys = { "boxTop","boxBot","boxLeft","boxRight","hpBG","hpFill","nameLabel","distLabel","hpLabel" }
local function SetAllVisible(obj, v)
    for _, k in ipairs(_drawKeys) do pcall(function() obj[k].Visible = v end) end
end

local function CreateESP(c, forcePlr)
    if ESPObjects[c] then return end
    local hrp = resolveHRP(c)
    local hum2 = c:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum2 then return end
    local plr = forcePlr or Players:GetPlayerFromCharacter(c)
    local isNPC = not plr and IsNPC(c)
    local obj = {
        boxTop = NewLine(), boxBot = NewLine(), boxLeft = NewLine(), boxRight = NewLine(),
        hpBG = NewRect(), hpFill = NewRect(),
        nameLabel = NewText(CFG.NameSize),
        distLabel = NewText(11, Color3.fromRGB(200,200,200)),
        hpLabel   = NewText(10),
        hrp = hrp, hum = hum2, plr = plr, isNPC = isNPC, _vis = false, char = c,
    }
    obj.hpBG.Color = Color3.fromRGB(30,30,30); obj.hpBG.Transparency = 0.4
    ESPObjects[c] = obj
    if CFG.BypassAntiESP and not isNPC then applyBypass(c) end
end

local function RemoveESP(c)
    local obj = ESPObjects[c]
    if not obj then return end
    ESPObjects[c] = nil
    for _, k in ipairs(_drawKeys) do pcall(function() obj[k]:Remove() end) end
    removeBypass(c)
end

local _bypassFrame = 0
RunService.RenderStepped:Connect(function(dt)
    if not CFG.Enabled then return end
    _bypassFrame = (_bypassFrame + 1) % 30
    if _bypassFrame == 0 and CFG.BypassAntiESP then
        for c2, obj in pairs(ESPObjects) do
            if not obj.isNPC and c2 and c2.Parent then resetCharTransparency(c2) end
        end
    end
    Camera = workspace.CurrentCamera
    RainbowHue = (RainbowHue + dt * 0.75) % 1
    local boxColor = CFG.Rainbow and Color3.fromHSV(RainbowHue, 1, 1) or CFG.BoxColor
    local myChar = LP.Character
    local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local toRemove = {}

    for c2, obj in pairs(ESPObjects) do
        if not c2 or not c2.Parent then table.insert(toRemove, c2); continue end
        if obj.isNPC and not CFG.NPCSESP then
            if obj._vis then SetAllVisible(obj, false); obj._vis = false end; continue
        end
        local liveHRP = resolveHRP(c2)
        if liveHRP and liveHRP ~= obj.hrp then obj.hrp = liveHRP end
        local hrp2, hum2 = obj.hrp, obj.hum
        if not hrp2 or not hrp2.Parent or not hum2 or not hum2.Parent or hum2.Health <= 0 then
            if obj._vis then SetAllVisible(obj, false); obj._vis = false end; continue
        end
        local charName = obj.plr and obj.plr.Name or c2.Name
        if Blacklist[charName] then
            if obj._vis then SetAllVisible(obj, false); obj._vis = false end; continue
        end
        local dist = myHRP and (myHRP.Position - hrp2.Position).Magnitude or math.huge
        if dist > CFG.MaxDist then
            if obj._vis then SetAllVisible(obj, false); obj._vis = false end; continue
        end
        local x1, y1, x2, y2 = GetBoundingBox(hrp2)
        if not x1 then
            if obj._vis then SetAllVisible(obj, false); obj._vis = false end; continue
        end
        obj._vis = true
        local h = y2 - y1
        local lineColor = obj.isNPC and Color3.fromRGB(255,80,80) or boxColor
        obj.boxTop.From  = Vector2.new(x1,y1); obj.boxTop.To  = Vector2.new(x2,y1)
        obj.boxBot.From  = Vector2.new(x1,y2); obj.boxBot.To  = Vector2.new(x2,y2)
        obj.boxLeft.From = Vector2.new(x1,y1); obj.boxLeft.To = Vector2.new(x1,y2)
        obj.boxRight.From= Vector2.new(x2,y1); obj.boxRight.To= Vector2.new(x2,y2)
        for _, side in ipairs({ obj.boxTop, obj.boxBot, obj.boxLeft, obj.boxRight }) do
            side.Color = lineColor; side.Visible = true
        end
        if CFG.ShowHP and hum2.MaxHealth > 0 then
            local ratio = math.clamp(hum2.Health / hum2.MaxHealth, 0, 1)
            local barX  = x1 - CFG.HPBarWidth - 2
            local barH  = h * ratio
            obj.hpBG.Position = Vector2.new(barX, y1); obj.hpBG.Size = Vector2.new(CFG.HPBarWidth, h); obj.hpBG.Visible = true
            obj.hpFill.Position = Vector2.new(barX, y2 - barH); obj.hpFill.Size = Vector2.new(CFG.HPBarWidth, barH)
            obj.hpFill.Color = GetHPColor(ratio); obj.hpFill.Visible = true
            if CFG.ShowHPText then
                obj.hpLabel.Text     = math.floor(hum2.Health) .. "/" .. math.floor(hum2.MaxHealth)
                obj.hpLabel.Color    = GetHPColor(ratio)
                obj.hpLabel.Position = Vector2.new(barX + CFG.HPBarWidth/2, y2 + 2)
                obj.hpLabel.Visible  = true
            else obj.hpLabel.Visible = false end
        else
            obj.hpBG.Visible = false; obj.hpFill.Visible = false; obj.hpLabel.Visible = false
        end
        if CFG.ShowName then
            obj.nameLabel.Text     = obj.plr and obj.plr.DisplayName or c2.Name
            obj.nameLabel.Position = Vector2.new((x1+x2)/2, y1 - 16)
            obj.nameLabel.Visible  = true
        else obj.nameLabel.Visible = false end
        if CFG.ShowDist then
            obj.distLabel.Text     = math.floor(dist) .. " studs"
            obj.distLabel.Position = Vector2.new((x1+x2)/2, y2 + (CFG.ShowHPText and 14 or 2))
            obj.distLabel.Visible  = true
        else obj.distLabel.Visible = false end
    end
    for _, c2 in ipairs(toRemove) do RemoveESP(c2) end
end)

