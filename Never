    { Title = "🌶️ เก็บพริก",         Position = Vector3.new( 7319, -295,  -616) },
    { Title = "🥕 เก็บแครอท",         Position = Vector3.new( -3782, -295, 3153) },
    { Title = "🥛 เก็บนม",            Position = Vector3.new(10311, -293, 27) },
    { Title = "🍅 เก็บมะเขือเทศ",    Position = Vector3.new(-9181, -260, -238) },
    { Title = "⚔️ เรเบล",            Position = Vector3.new( 2007, -321, -6963) },
    { Title = "⛏️ เหมืองทอง+เหล็ก", Position = Vector3.new(-9538, -311,  4862) },
    { Title = "🏠 ที่โพ เหล็ก+ทอง",  Position = Vector3.new(  -265, -321, -3122) },
    { Title = "ปลูกแคนดี้",           Position = Vector3.new(  -403, -324, -1617) },
    { Title = "ที่ขอพร",              Position = Vector3.new(  1424, -239,  1216) },
}

local LocationTitles = {}
local LocationMap    = {}
for _, loc in ipairs(Locations) do
    table.insert(LocationTitles, loc.Title)
    LocationMap[loc.Title] = loc
end

local SelectedLocation = Locations[1]

TeleportTab:Dropdown({
    Title    = "เลือกสถานที่",
    Desc     = "เลือกตำแหน่งที่ต้องการ Teleport",
    Values   = LocationTitles,
    Value    = LocationTitles[1],
    Callback = function(option)
        SelectedLocation = LocationMap[option]
    end,
})

TeleportTab:Button({
    Title    = "Teleport",
    Desc     = "กด Teleport ไปยังสถานที่ที่เลือก",
    Icon     = "navigation",
    Callback = function()
        pcall(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                char:PivotTo(CFrame.new(SelectedLocation.Position))
            end
        end)
    end,
})

---> TAB: SETTINGS <---
local SettingsTab = Window:Tab({
    Title  = "Settings",
    Icon   = "settings",
    Locked = false,
})

local AntiAFKEnabled = false
LocalPlayer.Idled:Connect(function()
    if AntiAFKEnabled then
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end
end)

local GameplaySettings = SettingsTab:Section({ Title = "Gameplay", Opened = true })
GameplaySettings:Toggle({
    Title    = "Anti AFK",
    Desc     = "ป้องกันถูกเตะออกเกมตอนไม่ได้เล่น",
    Icon     = "shield",
    Value    = false,
    Callback = function(state) AntiAFKEnabled = state end,
})

local UISettings = SettingsTab:Section({ Title = "UI Configuration", Opened = true })
UISettings:Keybind({
    Flag     = "UIKeybind",
    Title    = "Toggle Menu Key",
    Value    = "LeftControl",
    Callback = function(v)
        if Window.SetToggleKey then
            Window:SetToggleKey(Enum.KeyCode[v])
        end
    end,
})

local themes = {}
if WindUI.Themes then
    for name, _ in pairs(WindUI.Themes) do
        table.insert(themes, name)
    end
end
if #themes == 0 then themes = { "Dark" } end
UISettings:Dropdown({
    Flag     = "UITheme",
    Title    = "UI Theme",
    Values   = themes,
    Default  = "Dark",
    Callback = function(t)
        pcall(function() WindUI:SetTheme(t) end)
    end,
})
